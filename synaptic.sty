\RequirePackage{mathtools}
\RequirePackage[ warnings-off = { mathtools-colon, mathtools-over, mathtools-overbracket } ]
  {unicode-math}
\IfFontExistsTF{XCharter-Math.otf}
  {
    \setmathfont{XCharter-Math.otf}[
      math-style = ISO,
      bold-style = ISO,
      Script     = Math
    ]
  }
  {
    \PackageWarning{synaptic}
      {XCharter-Math~not~found.~Falling~back~to~Latin~Modern~Math.}
    \setmathfont{latinmodern-math.otf}
  }

