\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic}{2026-06-05}{1.0.0}
  {Modern L3 Academic Journal Framework with Micro-typography Enhancements}

\sys_if_engine_luatex:F
  {
    \PackageError{synaptic}{LuaLaTeX ~ required}
      {This~package~utilizes~modern~fontspec/unicode-math~technologies~and~requires~LuaLaTeX.}
  }

% --- Ensure KOMA-Script class is used ---
\cs_if_exist:cF { KOMAoptions }
  {
    \PackageError{synaptic}
      {KOMA-Script~document~class~required}
      {
        The~'synaptic'~package~is~designed~to~work~exclusively~with~
        KOMA-Script~classes~(scrartcl,~scrreprt,~scrbook,~etc.).~
        Please~change~your~documentclass.
      }
  }

% ---------------------------------------------------------------------------
% Options
% ---------------------------------------------------------------------------
\bool_new:N \g__synaptic_load_zh_bool
\tl_new:N   \g__synaptic_opt_color_tl
\tl_new:N   \g__synaptic_opt_style_tl
\tl_new:N   \g__synaptic_opt_lang_tl
\bool_new:N \g__synaptic_opt_extra_math_bool
\bool_new:N \g__synaptic_opt_toc_bool
\tl_new:N   \g__synaptic_opt_toc_layout_tl
\bool_new:N \g__synaptic_opt_breaking_bool

\keys_define:nn { synaptic }
  {
    color .tl_set:N = \g__synaptic_opt_color_tl ,
    color .initial:n = ocean ,

    style .tl_set:N = \g__synaptic_opt_style_tl ,
    style .initial:n = modern ,

    lang .code:n =
      {
        \str_if_eq:nnTF {#1} { zh }
          { \bool_gset_true:N \g__synaptic_load_zh_bool }
          { \bool_gset_false:N \g__synaptic_load_zh_bool }
        \tl_gset:Nn \g__synaptic_opt_lang_tl {#1}
      } ,
    lang .initial:n = en ,

    extra-math .bool_set:N = \g__synaptic_opt_extra_math_bool ,
    extra-math .initial:n  = false ,

    toc .bool_set:N = \g__synaptic_opt_toc_bool ,
    toc .initial:n  = true ,

    toc-layout .tl_set:N = \g__synaptic_opt_toc_layout_tl ,
    toc-layout .initial:n  = top ,

    fine-breaking .bool_set:N = \g__synaptic_opt_breaking_bool ,
    fine-breaking .initial:n  = true ,

    unknown .code:n = {} ,
  }

\ProcessKeyOptions

% ---------------------------------------------------------------------------
% Colors
% ---------------------------------------------------------------------------
\RequirePackage{xcolor}

\definecolor{syn_ocean}{RGB}{0,106,176}
\definecolor{syn_teal}{HTML}{0E6251}
\definecolor{syn_carbon}{HTML}{2E4053}
\definecolor{syn_text_dark}{HTML}{212F3D}

\str_set:Nx \l_tmpa_str { \g__synaptic_opt_color_tl }
\str_case:VnF \l_tmpa_str
  {
    { ocean }  { \colorlet{syncolor}{syn_ocean}  }
    { teal }   { \colorlet{syncolor}{syn_teal}   }
    { carbon } { \colorlet{syncolor}{syn_carbon} }
  }
  {
    \PackageWarning{synaptic}{Unknown~color~`\l_tmpa_str'.~Using~`ocean'.}
    \colorlet{syncolor}{syn_ocean}
  }

\colorlet{syncolor-strong}{syncolor}
\colorlet{syncolor-light}{syncolor!40}
\colorlet{syncolor-faded}{syncolor!20}
\colorlet{syncolor-rule}{gray!40}

% ---------------------------------------------------------------------------
% Validate other options
% ---------------------------------------------------------------------------
\str_set:Nx \l_tmpa_str { \g__synaptic_opt_style_tl }
\str_case:VnF \l_tmpa_str
  {
    { modern }  { }
    { minimal } { }
  }
  {
    \PackageWarning{synaptic}{Unknown~style~`\l_tmpa_str'.~Using~`modern'.}
    \tl_gset:Nn \g__synaptic_opt_style_tl { modern }
  }

\str_set:Nx \l_tmpa_str { \g__synaptic_opt_toc_layout_tl }
\str_case:VnF \l_tmpa_str
  {
    { top }    { }
    { inline } { }
    { page }   { }
  }
  {
    \PackageWarning{synaptic}{Unknown~toc-layout~`\l_tmpa_str'.~Using~`top'.}
    \tl_gset:Nn \g__synaptic_opt_toc_layout_tl { top }
  }

% ---------------------------------------------------------------------------
% Fonts
% ---------------------------------------------------------------------------
\RequirePackage{fontspec}

% -- Roman
\IfFontExistsTF{XCharter-Roman.otf}
  {
    \setmainfont{XCharter}[
      Extension         = .otf,
      UprightFont       = *-Roman,
      BoldFont          = *-Bold,
      ItalicFont        = *-Italic,
      BoldItalicFont    = *-BoldItalic,
      Numbers           = {OldStyle,Proportional},
      Ligatures         = TeX
    ]
  }
  {
    \PackageWarning{synaptic}
      {XCharter~font~not~found.~Falling~back~to~Latin~Modern~Roman.}
    \setmainfont{Latin~Modern~Roman}
  }

% -- Sans Serif
\IfFontExistsTF{Cabin-Regular.otf}
  {
    \setsansfont{Cabin}[
      Extension         = .otf,
      UprightFont       = *-Regular,
      BoldFont          = *-Bold,
      ItalicFont        = *-Italic,
      BoldItalicFont    = *-BoldItalic,
      Scale             = 0.94,
      BoldFeatures      = {LetterSpace=1.5}
    ]
  }
  {
    \PackageWarning{synaptic}
      {Cabin~font~not~found.~Falling~back~to~Latin~Modern~Sans.}
    \setsansfont{Latin~Modern~Sans}
  }

% -- Monospace
\IfFontExistsTF{Inconsolatazi4-Regular.otf}
  {
    \setmonofont{Inconsolatazi4}[
      Extension         = .otf,
      UprightFont       = *-Regular,
      BoldFont          = *-Bold,
      ItalicFont        = *-Regular,
      BoldItalicFont    = *-Bold,
      Scale             = MatchLowercase,
      StylisticSet      = {2,3}
    ]
  }
  {
    \PackageWarning{synaptic}
      {Inconsolatazi4~font~not~found.~Falling~back~to~Latin~Modern~Mono.}
    \setmonofont{Latin~Modern~Mono}
  }

% -- CJK (when lang=zh)
\bool_if:NT \g__synaptic_load_zh_bool
  {
    % scheme=plain prevents ctex from defining any Chinese-specific environments
    % like proof, abstract, etc. Heading is already disabled.
    \RequirePackage[heading=false, fontset=none, scheme=plain]{ctex}

    % CJK main
    \IfFontExistsTF{Noto~Serif~CJK~SC}
      {
        \setCJKmainfont{Noto~Serif~CJK~SC}[
          UprightFont    = *~Regular,
          BoldFont       = *~Bold,
          ItalicFont     = *~Regular,
          ItalicFeatures = {AutoFakeSlant=0.17},
          Scale          = 0.95
        ]
      }
      {
        \IfFontExistsTF{FandolSong-Regular.otf}
          {
            \PackageWarning{synaptic}
              {Noto~Serif~CJK~SC~not~found.~Falling~back~to~FandolSong.}
            \setCJKmainfont{FandolSong-Regular.otf}[
              BoldFont = FandolSong-Bold.otf,
              Scale    = 0.95
            ]
          }
          {
            \PackageError{synaptic}
              {No~CJK~main~font~found}
              {
                Neither~Noto~Serif~CJK~SC~nor~FandolSong~is~installed.~
                Chinese~typesetting~is~impossible.~
                Please~install~a~CJK~font~or~choose~lang=en.
              }
          }
      }

    % CJK sans & mono
    \IfFontExistsTF{Noto~Sans~CJK~SC}
      {
        \setCJKsansfont{Noto~Sans~CJK~SC}[
          UprightFont         = *~Regular,
          BoldFont            = *~Regular,
          BoldFeatures        = { FakeBold = 4 },
          ItalicFont          = *~Regular,
          ItalicFeatures      = { AutoFakeSlant = 0.17 },
          BoldItalicFont      = *~Regular,
          BoldItalicFeatures  = { FakeBold = 4, AutoFakeSlant = 0.17 },
          Scale               = 0.95
        ]
        \setCJKmonofont{Noto~Sans~CJK~SC}[
          UprightFont         = *~Regular,
          BoldFont            = *~Regular,
          BoldFeatures        = { FakeBold = 4 },
          ItalicFont          = *~Regular,
          ItalicFeatures      = { AutoFakeSlant = 0.17 },
          BoldItalicFont      = *~Regular,
          BoldItalicFeatures  = { FakeBold = 4, AutoFakeSlant = 0.17 },
          Scale               = 0.95
        ]
      }
      {
        \IfFontExistsTF{FandolHei-Regular.otf}
          {
            \PackageWarning{synaptic}
              {Noto~Sans~CJK~SC~not~found.~Falling~back~to~Fandol~Hei~and~Fang.}
            \setCJKsansfont{FandolHei-Regular.otf}[
              BoldFont = FandolHei-Bold.otf,
              Scale    = 0.95
            ]
            \setCJKmonofont{FandolFang-Regular.otf}[
              Scale = 0.95
            ]
          }
          {
            \PackageError{synaptic}
              {No~CJK~sans/mono~font~found}
              {
                Neither~Noto~Sans~CJK~SC~nor~FandolHei/FandolFang~are~installed.~
                Please~install~CJK~fonts~or~use~lang=en.
              }
          }
      }
  }

% ---------------------------------------------------------------------------
% Math
