% ---------------------------------------------------------------------------
% Page background: relative-luminance measurement and the derived colour roles
% ---------------------------------------------------------------------------
% The active background is stored in the `syn-bg' token.  All derived roles
% blend against it, so cards, hairlines, and borders remain coherent on any
% page colour selected through the `background' key.  When the background is
% dark, body and muted text flip to light inks while decorative rules are
% lightened instead of darkened.
\fp_new:N  \l__synaptic_color_bg_lum_fp
\fp_new:N  \l__synaptic_color_bg_c_fp
\fp_new:N  \l__synaptic_color_bg_m_fp
\fp_new:N  \l__synaptic_color_bg_y_fp
\fp_new:N  \l__synaptic_color_bg_k_fp
\bool_new:N \g__synaptic_color_bg_dark_bool
\tl_new:N  \l__synaptic_color_bg_spec_tl
\tl_new:N  \l__synaptic_color_bg_part_tl
\seq_new:N \l__synaptic_color_bg_parts_seq

\cs_new:Npn \__synaptic_color_bg_dark:TF #1#2
  { \bool_if:NTF \g__synaptic_color_bg_dark_bool {#1} {#2} }

\cs_new_protected:Npn \__synaptic_color_bg_measure_rgb:
  {
    \seq_set_split:NnV \l__synaptic_color_bg_parts_seq {,}
      \l__synaptic_color_bg_spec_tl
    \seq_pop_left:NN \l__synaptic_color_bg_parts_seq \l__synaptic_color_bg_part_tl
    \fp_set:Nn \l_tmpa_fp { \l__synaptic_color_bg_part_tl }
    \seq_pop_left:NN \l__synaptic_color_bg_parts_seq \l__synaptic_color_bg_part_tl
    \fp_set:Nn \l_tmpb_fp { \l__synaptic_color_bg_part_tl }
    \seq_pop_left:NN \l__synaptic_color_bg_parts_seq \l__synaptic_color_bg_part_tl
    \fp_set:Nn \l_tmpc_fp { \l__synaptic_color_bg_part_tl }
    \fp_set:Nn \l__synaptic_color_bg_lum_fp
      { 0.2126 * \l_tmpa_fp + 0.7152 * \l_tmpb_fp + 0.0722 * \l_tmpc_fp }
  }

\cs_new_protected:Npn \__synaptic_color_bg_measure_cmyk:
  {
    \seq_set_split:NnV \l__synaptic_color_bg_parts_seq {,}
      \l__synaptic_color_bg_spec_tl
    \seq_pop_left:NN \l__synaptic_color_bg_parts_seq \l__synaptic_color_bg_part_tl
    \fp_set:Nn \l__synaptic_color_bg_c_fp { \l__synaptic_color_bg_part_tl }
    \seq_pop_left:NN \l__synaptic_color_bg_parts_seq \l__synaptic_color_bg_part_tl
    \fp_set:Nn \l__synaptic_color_bg_m_fp { \l__synaptic_color_bg_part_tl }
    \seq_pop_left:NN \l__synaptic_color_bg_parts_seq \l__synaptic_color_bg_part_tl
    \fp_set:Nn \l__synaptic_color_bg_y_fp { \l__synaptic_color_bg_part_tl }
    \seq_pop_left:NN \l__synaptic_color_bg_parts_seq \l__synaptic_color_bg_part_tl
    \fp_set:Nn \l__synaptic_color_bg_k_fp { \l__synaptic_color_bg_part_tl }
    \fp_set:Nn \l__synaptic_color_bg_lum_fp
      {
        0.2126 * ( 1 - \l__synaptic_color_bg_c_fp ) * ( 1 - \l__synaptic_color_bg_k_fp )
        + 0.7152 * ( 1 - \l__synaptic_color_bg_m_fp ) * ( 1 - \l__synaptic_color_bg_k_fp )
        + 0.0722 * ( 1 - \l__synaptic_color_bg_y_fp ) * ( 1 - \l__synaptic_color_bg_k_fp )
      }
  }

\cs_new_protected:Npn \__synaptic_color_measure_bg:
  {
    % NB: no spaces inside the braces — xcolor's \XC@split does not trim them
    % and would treat `syn-bg' as an undefined colour.
    \extractcolorspecs{syn-bg}\l_tmpa_tl\l__synaptic_color_bg_spec_tl
    \str_if_eq:VnTF \l_tmpa_tl { rgb }
      { \__synaptic_color_bg_measure_rgb: }
      {
        \str_if_eq:VnTF \l_tmpa_tl { gray }
          { \fp_set:Nn \l__synaptic_color_bg_lum_fp { \l__synaptic_color_bg_spec_tl } }
          {
            \str_if_eq:VnTF \l_tmpa_tl { cmyk }
              { \__synaptic_color_bg_measure_cmyk: }
              { \fp_set:Nn \l__synaptic_color_bg_lum_fp { 1 } }
          }
      }
    \fp_compare:nTF { \l__synaptic_color_bg_lum_fp < 0.5 }
      { \bool_gset_true:N  \g__synaptic_color_bg_dark_bool }
      { \bool_gset_false:N \g__synaptic_color_bg_dark_bool }
  }

% Print modes carry the colour through \pagecolor; Beamer uses its background
% canvas, whose stored expression re-resolves `syn-bg' per frame, so runtime
% changes reach every subsequent slide without redefining the template.
\cs_new_protected:Npn \__synaptic_color_apply_page_bg:
  {
    \__synaptic_if_beamer:TF
      { \setbeamercolor{background~canvas}{bg=syn-bg} }
      { \pagecolor{syn-bg} }
  }

\cs_new_protected:Npn \__synaptic_color_derive:
  {
    % Rebuild the public theme roles from stable base colours on every pass.
    % This is what makes a background change reversible: a dark canvas may
    % lift the display colours without losing the registered theme values.
    \str_if_eq:VnTF \g__synaptic_color_mode_tl { mono }
      {
        \__synaptic_color_bg_dark:TF
          {
            \colorlet{syn-primary}{white!72!syn-bg}
            \colorlet{syn-secondary}{white!88!syn-bg}
            \colorlet{syn-accent}{white!58!syn-bg}
            \colorlet{syn-danger}{white!76!syn-bg}
            \colorlet{syn-warning}{white!62!syn-bg}
            \colorlet{syn-success}{white!70!syn-bg}
          }
          {
            \colorlet{syn-primary}{black!78!syn-bg}
            \colorlet{syn-secondary}{black!86!syn-bg}
            \colorlet{syn-accent}{black!68!syn-bg}
            \colorlet{syn-danger}{black!82!syn-bg}
            \colorlet{syn-warning}{black!68!syn-bg}
            \colorlet{syn-success}{black!76!syn-bg}
          }
      }
      {
        \__synaptic_color_bg_dark:TF
          {
            \colorlet{syn-primary}{syn-theme-active-primary!42!white}
            \colorlet{syn-secondary}{syn-theme-active-secondary!16!white}
            \colorlet{syn-accent}{syn-theme-active-accent!54!white}
            \colorlet{syn-danger}{syn-semantic-danger!46!white}
            \colorlet{syn-warning}{syn-semantic-warning!52!white}
            \colorlet{syn-success}{syn-semantic-success!48!white}
          }
          {
            \colorlet{syn-primary}{syn-theme-active-primary}
            \colorlet{syn-secondary}{syn-theme-active-secondary}
            \colorlet{syn-accent}{syn-theme-active-accent}
            \colorlet{syn-danger}{syn-semantic-danger}
            \colorlet{syn-warning}{syn-semantic-warning}
            \colorlet{syn-success}{syn-semantic-success}
          }
      }
    \__synaptic_color_bg_dark:TF
      {
        % Neutral inks are tied to the canvas rather than to a hue.  This
        % keeps long text calm while the lifted theme roles carry hierarchy.
        \colorlet{syn-text-dark}{white!94!syn-bg}
        \colorlet{syn-muted-text}{white!72!syn-bg}
        \colorlet{syn-decoration-muted}{white!43!syn-bg}
        \colorlet{syn-rule}{white!18!syn-bg}
        \colorlet{syn-border}{white!25!syn-bg}
        \colorlet{syn-faded}{white!12!syn-bg}
        \colorlet{syn-light}{white!34!syn-bg}
        \colorlet{syn-on-primary}{black!90!syn-bg}
        \colorlet{syn-on-danger}{black!90!syn-bg}
      }
      {
        \colorlet{syn-text-dark}{syn-secondary!92!black}
        \colorlet{syn-muted-text}{syn-secondary!80!syn-bg}
        \colorlet{syn-decoration-muted}{syn-secondary!42!syn-bg}
        \colorlet{syn-rule}{syn-primary!24!syn-bg}
        \colorlet{syn-border}{syn-primary!34!syn-bg}
        \colorlet{syn-faded}{syn-primary!15!syn-bg}
        \colorlet{syn-light}{syn-primary!34!syn-bg}
        \colorlet{syn-on-primary}{white}
        \colorlet{syn-on-danger}{white}
      }
    \str_if_eq:VnTF \g__synaptic_color_mode_tl { screen }
      { \colorlet{syn-link}{syn-primary} }
      { \colorlet{syn-link}{syn-text-dark} }
    % A quiet three-step surface ladder keeps nested components distinct
    % without introducing outlines or drop shadows.
    \colorlet{syn-surface-soft}{syn-primary!2!syn-bg}
    \colorlet{syn-surface}{syn-primary!4!syn-bg}
    \colorlet{syn-surface-strong}{syn-primary!8!syn-bg}
    \colorlet{syn-muted}{syn-muted-text}
    \__synaptic_color_apply_page_bg:
  }

\cs_new_protected:Npn \__synaptic_color_setup_bg:
  {
    \colorlet{syn-bg}{\__synaptic_background:}
    \__synaptic_color_measure_bg:
  }

\cs_new_protected:Npn \__synaptic_color_apply_background:
  {
    \__synaptic_color_setup_bg:
    \__synaptic_color_derive:
  }

\cs_new_protected:Npn \__synaptic_color_use_theme_aux:n #1
  {
    \prop_if_in:NnTF \g__synaptic_themes_prop {#1}
      {
        \colorlet{syn-theme-active-primary}{syn-theme-#1-primary}
        \colorlet{syn-theme-active-secondary}{syn-theme-#1-secondary}
        \colorlet{syn-theme-active-accent}{syn-theme-#1-accent}
        \tl_gset:Nn \g__synaptic_theme_tl {#1}
        \__synaptic_color_derive:
      }
      {
        \PackageError{synaptic-color}{Unknown~theme~`#1'}
          {Define~it~first~with~\string\SynapticDefineTheme.}
      }
  }

\cs_new_protected:Npn \__synaptic_color_use_theme:n #1
  { \exp_args:Ne \__synaptic_color_use_theme_aux:n {#1} }

% #1 name, #2 primary colour expression, #3 secondary expression,
% optional #4 accent expression. Names are stable lowercase identifiers;
% existing themes cannot be mutated in place.
\NewDocumentCommand{\SynapticDefineTheme}{m m m o}
  {
    \regex_match:nnTF { \A [a-z] [a-z0-9-]* \Z } {#1}
      {
        \prop_if_in:NnTF \g__synaptic_themes_prop {#1}
          {
            \PackageError{synaptic-color}{Theme~`#1'~already~exists}
              {Choose~a~new~theme~name;~themes~are~immutable.}
          }
          {
            \colorlet{syn-theme-#1-primary}{#2}
            \colorlet{syn-theme-#1-secondary}{#3}
            \IfValueTF{#4}
              { \colorlet{syn-theme-#1-accent}{#4} }
              { \colorlet{syn-theme-#1-accent}{#2} }
            \prop_gput:Nnn \g__synaptic_themes_prop {#1} { custom }
          }
      }
      {
        \PackageError{synaptic-color}{Invalid~theme~name~`#1'}
          {Use~a~lowercase~identifier~containing~letters,~digits,~or~hyphens.}
      }
  }

% The background token must exist before the first derivation; the theme
% selection that follows maps primary/secondary/accent and derives roles.
\__synaptic_color_setup_bg:
\__synaptic_color_use_theme:n { \__synaptic_theme: }

%</color>
%    \end{macrocode}

% \subsection{synaptic-fonts.sty}
