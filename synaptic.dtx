% \textbf{synaptic} is a modular \LaTeX3 design system for academic documents.
% It provides a clean, non-invasive API with mode-aware module loading
% and a deterministic, package-managed font stack through \textsf{fontspec}.
%
% \section{Quick Start}
% \begin{verbatim}
% \documentclass{scrartcl}
% \usepackage[mode=journal,theme=ocean]{synaptic}
% \SynapticTitle{...}\SynapticAuthor{...}
% \begin{synabstract}...\end{synabstract}
% \begin{document}\SynapticMakeTitle\section{...}\end{document}
% \end{verbatim}
%
% \section{Key Options}
% \texttt{mode}=journal, book, lecture, notes, or beamer;
% \texttt{theme}=ocean, graphite, forest, midnight, or paper;
% \texttt{background}=any xcolor expression (default \texttt{white});
% \texttt{lang}=en or zh;
% \texttt{toc-layout}=top, inline, or page;
% \texttt{title-layout}=auto, inline, compact, page, or sequence;
% \texttt{numbering}=auto, section, chapter, continuous, or none;
% \texttt{color-mode}=screen, print, or mono;
% \texttt{density}=compact, balanced, or airy;
% \texttt{measure}=auto, narrow, standard, or wide;
% \texttt{theorem-style}=boxed or plain.
% Structural keys are fixed after loading; only \texttt{theme},
% \texttt{background}, \texttt{toc}, and \texttt{toc-layout} may change at
% runtime through \texttt{\string\SynapticSetup}.
%
% \section{Module map}
% The bundle extracts to one shell, one core module, one data pair, and five
% mode modules:
% \begin{itemize}\raggedright
% \item \texttt{synaptic-base.sty}: engine and class checks, key parsing,
%   \texttt{\string\SynapticSetup}, mode dispatch.
% \item \texttt{synaptic-lang-en.def} and \texttt{synaptic-lang-zh.def}:
%   bilingual label constants loaded before any module.
% \item \texttt{synaptic-color.sty}: theme registry, background-adaptive
%   semantic colour tokens, print and monochrome delivery.
% \item \texttt{synaptic-fonts.sty}: the unified Libertinus and Source Han CN
%   font stack.
% \item \texttt{synaptic-layout.sty}: geometry, paragraph typography,
%   headings, running-head hairline, equation numbering.
% \item \texttt{synaptic-theorem.sty}: namespaced statement and proof
%   environments.
% \item \texttt{synaptic-title.sty}: shared metadata model and the five
%   mode-aware title renderers.
% \item \texttt{synaptic-journal.sty}, \texttt{synaptic-book.sty},
%   \texttt{synaptic-lecture.sty}, \texttt{synaptic-notes.sty}, and
%   \texttt{synaptic-beamer.sty}:
%   mode-specific design and navigation layers.
% \end{itemize}
%
% \section{User API}
% \begingroup
% \renewcommand*\descriptionlabel[1]{\hspace\labelsep\normalfont #1}
% \begin{description}
% \raggedright
% \item[\texttt{\string\SynapticTitle}] Sets the required document title.
% \item[\texttt{\string\SynapticSubtitle}] Sets an optional display subtitle.
% \item[\texttt{\string\SynapticAuthor}] Appends a repeatable author; the
%   optional argument is an affiliation mark.
% \item[\texttt{\string\SynapticAffiliation}] Appends a repeatable affiliation;
%   the optional argument is the matching mark.
% \item[\texttt{\string\SynapticEmail}] Appends a clickable contact address.
% \item[\texttt{\string\SynapticKeywords}] Sets printed and PDF keywords.
% \item[\texttt{\string\SynapticMakeTitle}] Validates metadata and renders the
%   mode-specific title sequence and optional table of contents.
% \item[\texttt{\string\SynapticSetup}] Applies the runtime-safe
%   \texttt{theme}, \texttt{background}, \texttt{toc}, and \texttt{toc-layout}
%   keys. Frozen keys error.
% \item[\texttt{\string\SynapticNewTheorem}] Declares a custom statement whose
%   lowercase alphanumeric environment name begins with \texttt{syn}, using
%   style \texttt{plain}, \texttt{definition}, or \texttt{remark}.
% \item[\texttt{\string\SynapticDefineTheme}] Defines an immutable custom theme
%   from primary, secondary, and optional accent xcolor expressions.
% \item[\texttt{\string\SynapticStatement}] Creates a journal declaration block;
%   the starred form omits the table-of-contents entry.
% \item[\texttt{\string\SynapticAcknowledgments}] Creates chapter-scale (book)
%   or section-scale acknowledgments; the starred form omits the TOC entry.
% \item[\texttt{\string\SynapticAgendaFrame}] Creates a Beamer agenda frame;
%   its optional argument replaces the localized frame title.
% \item[\texttt{\string\SynapticSectionFrame}] Creates an unnumbered Beamer
%   section-divider frame for the current section.
% \item[\texttt{\string\SynapticFrontMatter},
%   \texttt{\string\SynapticMainMatter},
%   \texttt{\string\SynapticBackMatter}] Switch book matter, restore the
%   appropriate chapter scale, and clear running marks.
% \end{description}
% \endgroup
%
% \StopEventually{\PrintChanges\PrintIndex}
%
% \section{Implementation}
%
% Each module is extracted from the dtx under a DocStrip guard.
% See \texttt{synaptic.ins} for the full extraction mapping.

% \subsection{synaptic-base.sty}
%
% \paragraph{Core: engine check, options, module dispatching.}
%
%    \begin{macrocode}
%<*base>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-base}{2026-09-04}{5.3.0}
  {Synaptic~Core~Infrastructure}

\msg_new:nnn { synaptic } { luatex-required }
  { The~synaptic~package~requires~LuaLaTeX. }
\msg_new:nnn { synaptic } { koma-required }
  { This~synaptic~mode~requires~a~KOMA-Script~document~class. }
\msg_new:nnn { synaptic } { beamer-class-required }
  { mode=beamer~requires~the~beamer~document~class. }
\msg_new:nnn { synaptic } { beamer-title-layout }
  { title-layout=#1~is~not~available~in~beamer~mode;~use~auto,~page,~or~compact. }
\msg_new:nnn { synaptic } { book-class-required }
  { mode=book~requires~a~chapter-based~KOMA-Script~class,~normally~scrbook. }
\msg_new:nnn { synaptic } { chapter-numbering-required }
  { numbering=chapter~requires~a~chapter-based~KOMA-Script~class. }

% ---------------------------------------------------------------------------
% Engine and class checks
% ---------------------------------------------------------------------------
\sys_if_engine_luatex:F
  { \msg_fatal:nn { synaptic } { luatex-required } }

% ---------------------------------------------------------------------------
% Option variables
% ---------------------------------------------------------------------------
\tl_new:N  \g__synaptic_mode_tl
\tl_new:N  \g__synaptic_theme_tl
\tl_new:N  \g__synaptic_lang_tl
\tl_new:N  \g__synaptic_toc_layout_tl
\tl_new:N  \g__synaptic_title_layout_tl
\tl_new:N  \g__synaptic_numbering_tl
\tl_new:N  \g__synaptic_color_mode_tl
\tl_new:N  \g__synaptic_density_tl
\tl_new:N  \g__synaptic_measure_tl
\tl_new:N  \g__synaptic_theorem_style_tl
\bool_new:N \g__synaptic_toc_bool
\dim_new:N  \g__synaptic_binding_offset_dim
% Page background expression (any xcolor mixture), defaulting to white.
\tl_new:N  \g__synaptic_background_tl
\tl_gset:Nn \g__synaptic_background_tl { white }

% ---------------------------------------------------------------------------
% \SynapticSetup — unified configuration interface
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_base_unknown_error:n #1
  {
    \PackageError{synaptic-base}{Unknown~option~`#1'}
      {Remove~the~option~or~use~a~documented~synaptic~key.}
  }

\keys_define:nn { synaptic }
  {
    % --- mode system ---
    mode .choice:,
    mode / journal .code:n = \tl_gset:Nn \g__synaptic_mode_tl { journal },
    mode / book    .code:n = \tl_gset:Nn \g__synaptic_mode_tl { book },
    mode / lecture .code:n = \tl_gset:Nn \g__synaptic_mode_tl { lecture },
    mode / notes   .code:n = \tl_gset:Nn \g__synaptic_mode_tl { notes },
    mode / beamer  .code:n = \tl_gset:Nn \g__synaptic_mode_tl { beamer },
    mode .initial:n = journal,

    % --- theme system ---
    theme .choice:,
    theme / ocean    .code:n = \tl_gset:Nn \g__synaptic_theme_tl { ocean },
    theme / graphite .code:n = \tl_gset:Nn \g__synaptic_theme_tl { graphite },
    theme / forest   .code:n = \tl_gset:Nn \g__synaptic_theme_tl { forest },
    theme / midnight .code:n = \tl_gset:Nn \g__synaptic_theme_tl { midnight },
    theme / paper    .code:n = \tl_gset:Nn \g__synaptic_theme_tl { paper },
    theme .initial:n = ocean,

    % --- language ---
    lang .choice:,
    lang / en .code:n = \tl_gset:Nn \g__synaptic_lang_tl { en },
    lang / zh .code:n = \tl_gset:Nn \g__synaptic_lang_tl { zh },
    lang .initial:n = en,

    % --- generic booleans ---
    toc .bool_gset:N = \g__synaptic_toc_bool,
    toc .default:n  = true,
    toc .initial:n  = false,

    % --- toc layout ---
    toc-layout .choice:,
    toc-layout / top    .code:n = \tl_gset:Nn \g__synaptic_toc_layout_tl { top },
    toc-layout / inline .code:n = \tl_gset:Nn \g__synaptic_toc_layout_tl { inline },
    toc-layout / page   .code:n = \tl_gset:Nn \g__synaptic_toc_layout_tl { page },
    toc-layout .initial:n = top,

    % --- title composition ---
    title-layout .choice:,
    title-layout / auto     .code:n = \tl_gset:Nn \g__synaptic_title_layout_tl { auto },
    title-layout / inline   .code:n = \tl_gset:Nn \g__synaptic_title_layout_tl { inline },
    title-layout / compact  .code:n = \tl_gset:Nn \g__synaptic_title_layout_tl { compact },
    title-layout / page     .code:n = \tl_gset:Nn \g__synaptic_title_layout_tl { page },
    title-layout / sequence .code:n = \tl_gset:Nn \g__synaptic_title_layout_tl { sequence },
    title-layout .initial:n = auto,

    % --- structural numbering ---
    numbering .choice:,
    numbering / auto       .code:n = \tl_gset:Nn \g__synaptic_numbering_tl { auto },
    numbering / section    .code:n = \tl_gset:Nn \g__synaptic_numbering_tl { section },
    numbering / chapter    .code:n = \tl_gset:Nn \g__synaptic_numbering_tl { chapter },
    numbering / continuous .code:n = \tl_gset:Nn \g__synaptic_numbering_tl { continuous },
    numbering / none       .code:n = \tl_gset:Nn \g__synaptic_numbering_tl { none },
    numbering .initial:n = auto,

    % --- visual delivery and rhythm ---
    color-mode .choice:,
    color-mode / screen .code:n = \tl_gset:Nn \g__synaptic_color_mode_tl { screen },
    color-mode / print  .code:n = \tl_gset:Nn \g__synaptic_color_mode_tl { print },
    color-mode / mono   .code:n = \tl_gset:Nn \g__synaptic_color_mode_tl { mono },
    color-mode .initial:n = screen,

    density .choice:,
    density / compact  .code:n = \tl_gset:Nn \g__synaptic_density_tl { compact },
    density / balanced .code:n = \tl_gset:Nn \g__synaptic_density_tl { balanced },
    density / airy     .code:n = \tl_gset:Nn \g__synaptic_density_tl { airy },
    density .initial:n = balanced,

    measure .choice:,
    measure / auto     .code:n = \tl_gset:Nn \g__synaptic_measure_tl { auto },
    measure / narrow   .code:n = \tl_gset:Nn \g__synaptic_measure_tl { narrow },
    measure / standard .code:n = \tl_gset:Nn \g__synaptic_measure_tl { standard },
    measure / wide     .code:n = \tl_gset:Nn \g__synaptic_measure_tl { wide },
    measure .initial:n = auto,

    theorem-style .choice:,
    theorem-style / boxed  .code:n = \tl_gset:Nn \g__synaptic_theorem_style_tl { boxed },
    theorem-style / plain  .code:n = \tl_gset:Nn \g__synaptic_theorem_style_tl { plain },
    theorem-style .initial:n = boxed,

    binding-offset .dim_gset:N = \g__synaptic_binding_offset_dim,
    binding-offset .initial:n = 0pt,

    % --- page background ---
    background .code:n =
      \tl_gset:Nn \g__synaptic_background_tl {#1},

    % --- unknown ---
    unknown .code:n = \__synaptic_base_unknown_error:n { \l_keys_key_tl },
  }

% Runtime settings deliberately exclude options which require module reloads.
% Attempting to change a structural key after loading is a clear error rather
% than a silent no-op; only theme, background, contents, and contents layout
% may change.
\NewDocumentCommand{\SynapticSetup}{m}
  {
    \keys_set:nn { synaptic / runtime } {#1}
  }

\keys_define:nn { synaptic / runtime }
  {
    toc .bool_gset:N = \g__synaptic_toc_bool,
    toc-layout .choice:,
    toc-layout / top    .code:n = \tl_gset:Nn \g__synaptic_toc_layout_tl { top },
    toc-layout / inline .code:n = \tl_gset:Nn \g__synaptic_toc_layout_tl { inline },
    toc-layout / page   .code:n = \tl_gset:Nn \g__synaptic_toc_layout_tl { page },
    theme .code:n = \__synaptic_color_use_theme:n {#1},
    background .code:n =
      \tl_gset:Nn \g__synaptic_background_tl {#1}
      \__synaptic_color_apply_background:,
    unknown .code:n =
      {
        \PackageError{synaptic-base}
          {Option~`\l_keys_key_tl'~is~structural~and~fixed~after~loading}
          {Set~it~in~the~\string\usepackage~options,~or~use~theme,~
            background,~toc,~and~toc-layout~here.}
      },
  }

% Also accept options via \usepackage[...]
\ProcessKeyOptions[synaptic]

% The selected mode determines the class contract.  This check deliberately
% follows option processing: Beamer is not a KOMA-Script class, while the four
% print-oriented modes rely on KOMA's sectioning and page-style interfaces.
\str_if_eq:VnTF \g__synaptic_mode_tl { beamer }
  {
    \@ifclassloaded{beamer}
      { }
      { \msg_fatal:nn { synaptic } { beamer-class-required } }
  }
  {
    \cs_if_exist:cF { KOMAoptions }
      { \msg_fatal:nn { synaptic } { koma-required } }
  }
\str_if_eq:VnT \g__synaptic_mode_tl { beamer }
  {
    \str_case:VnF \g__synaptic_title_layout_tl
      {
        { auto }    { }
        { page }    { }
        { compact } { }
      }
      {
        \msg_fatal:nnn { synaptic } { beamer-title-layout }
          { \g__synaptic_title_layout_tl }
      }
  }

% Automatic contents are opt-in: only a document that asks for `toc=${true}`
% gets one.  Book users normally call \tableofcontents from the front matter.
% A display-numbering request of `none` also suppresses box numbers.

% ---------------------------------------------------------------------------
% Private shared accessors (for extracted modules in this bundle)
% ---------------------------------------------------------------------------
\cs_new:Npn \__synaptic_mode:    { \g__synaptic_mode_tl }
\cs_new:Npn \__synaptic_theme:   { \g__synaptic_theme_tl }
\cs_new:Npn \__synaptic_lang:    { \g__synaptic_lang_tl }
\cs_new:Npn \__synaptic_title_layout: { \g__synaptic_title_layout_tl }
\cs_new:Npn \__synaptic_numbering: { \g__synaptic_numbering_tl }
\cs_new:Npn \__synaptic_color_mode: { \g__synaptic_color_mode_tl }
\cs_new:Npn \__synaptic_density: { \g__synaptic_density_tl }
\cs_new:Npn \__synaptic_measure: { \g__synaptic_measure_tl }
\cs_new:Npn \__synaptic_theorem_style: { \g__synaptic_theorem_style_tl }
\cs_new:Npn \__synaptic_background: { \g__synaptic_background_tl }

\cs_new_protected:Npn \__synaptic_if_lang_zh:TF #1#2
  {
    \str_if_eq:eeTF { \g__synaptic_lang_tl } { zh } {#1} {#2}
  }

\cs_new:Npn \__synaptic_if_beamer:TF #1#2
  {
    \str_if_eq:VnTF \g__synaptic_mode_tl { beamer } {#1} {#2}
  }

\cs_new:Npn \__synaptic_if_toc:TF #1#2
  {
    \bool_if:NTF \g__synaptic_toc_bool {#1} {#2}
  }

\cs_new:Npn \__synaptic_toc_layout: { \g__synaptic_toc_layout_tl }

% ---------------------------------------------------------------------------
% Load language definitions (must be before module loading)
% ---------------------------------------------------------------------------
\__synaptic_if_lang_zh:TF
  { \file_input:n { synaptic-lang-zh.def } }
  { \file_input:n { synaptic-lang-en.def } }

% Keep document-structure labels consistent with the selected Synaptic
% language even when ctex is loaded with its deliberately neutral scheme.
\str_if_eq:VnT \g__synaptic_mode_tl { book }
  {
    \cs_if_exist:NF \chapter
      { \msg_fatal:nn { synaptic } { book-class-required } }
    \cs_if_exist:NF \frontmatter
      { \msg_fatal:nn { synaptic } { book-class-required } }
  }
\str_if_eq:VnT \g__synaptic_numbering_tl { chapter }
  {
    \cs_if_exist:NF \chapter
      { \msg_fatal:nn { synaptic } { chapter-numbering-required } }
  }

% ---------------------------------------------------------------------------
% Mode-aware module loader
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_load_core_modules:
  {
    \RequirePackage{synaptic-color}
    \RequirePackage{synaptic-fonts}
    \RequirePackage{synaptic-layout}
    \RequirePackage{synaptic-theorem}
    \RequirePackage{synaptic-title}
  }

\cs_new_protected:Npn \__synaptic_load_mode_modules:
  {
    \str_case:Vn \g__synaptic_mode_tl
      {
        { journal }
          {
            \RequirePackage{synaptic-journal}
          }
        { book }
          {
            \RequirePackage{synaptic-book}
          }
        { lecture }
          {
            \RequirePackage{synaptic-lecture}
          }
        { notes }
          {
            \RequirePackage{synaptic-notes}
          }
        { beamer }
          {
            \RequirePackage{synaptic-beamer}
          }
      }
  }

% Load everything at package end
\__synaptic_load_core_modules:
\__synaptic_load_mode_modules:

%</base>
%    \end{macrocode}

% \subsection{synaptic-color.sty}
%
% \paragraph{Theme colour system, background-adaptive tokens.}
%
% The active page background (the \texttt{background} key, any xcolor
% expression) becomes the \texttt{syn-bg} base token. Semantic roles derive
% against it with a relative-luminance switch: light backgrounds keep the
% classic dark inks, dark backgrounds flip text to light inks and lighten
% hairlines. Themes supply primary, secondary, and accent colours only.
%
%    \begin{macrocode}
%<*color>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-color}{2026-09-04}{5.3.0}
  {Synaptic~Theme~Colour~System}

\RequirePackage{xcolor}

% ---------------------------------------------------------------------------
% Theme registry and semantic colour tokens
% ---------------------------------------------------------------------------
\definecolor{syn-theme-ocean-primary}{RGB}{0,103,168}
