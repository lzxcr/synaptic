% \title{\textsf{synaptic}\\\Large Modern Academic Typesetting Framework}
% \author{synaptic project\\\texttt{https://github.com/lzxcr/synaptic}}
% \date{v\fileversion\ --- \filedate}
% \maketitle
%
% \section{Introduction}
% \changes{v2.1.0}{2026-08-13}{Repaired engine startup, modes, fonts,
% themes, metadata, layout, tests, and documentation.}
% \changes{v2.2.0}{2026-08-13}{Completed the four mode-specific design
% systems, added responsive title and navigation renderers, and refined
% book, lecture, notes, colour, numbering, and bilingual typography.}
% \changes{v2.3.0}{2026-08-23}{Removed the superseded monolithic title
% renderer, added a hairline running-head separator in every mode, an
% editorial double rule beneath journal titles, unified the card corner
% treatment, and expanded the regression suite to eighteen test groups.}
% \changes{v2.4.0}{2026-08-27}{Gave the theorem environments a refined
% boxed presentation with a shared accent-bar treatment, added corollary,
% axiom, conjecture, claim, property, criterion, convention, problem,
% solution, example, remark, and note environments with bilingual labels,
% and introduced the configurable \texttt{theorem-style} option.}
% \textbf{synaptic} is a modular \LaTeX3 design system for academic documents.
% It provides a clean, non-invasive API with mode-aware module loading
% and deterministic font-bundle auto-detection through \textsf{fontspec}.
%
% \section{Quick Start}
% \begin{verbatim}
% \documentclass{scrartcl}
% \usepackage[mode=journal,theme=ocean]{synaptic}
% \SynapticTitle{...}\SynapticAuthor{...}
% \begin{abstract}...\end{abstract}
% \begin{document}\SynapticMakeTitle\section{...}\end{document}
% \end{verbatim}
%
% \section{Key Options}
% \texttt{mode}=journal, book, lecture, or notes;
% \texttt{theme}=ocean, graphite, forest, midnight, or paper;
% \texttt{lang}=en or zh;
% \texttt{fontset}=auto, xcharter, libertinus, stix2, or lm;
% \texttt{toc-layout}=top, inline, or page;
% \texttt{title-layout}=auto, inline, compact, page, or cover;
% \texttt{numbering}=auto, section, chapter, continuous, or none;
% \texttt{box-numbering}=shared, separate, or none;
% \texttt{color-mode}=screen, print, or mono;
% \texttt{density}=compact, balanced, or airy;
% \texttt{measure}=auto, narrow, standard, or wide;
% \texttt{theorem-style}=boxed or plain;
% \texttt{extra-math} and \texttt{fine-breaking} are booleans.
% Structural keys are frozen after loading; only \texttt{theme},
% \texttt{toc}, and \texttt{toc-layout} may change at runtime through
% \texttt{\string\SynapticSetup}.
%
% \section{Module map}
% The bundle extracts to one shell, one core module, one data pair, and four
% mode modules:
% \begin{itemize}\raggedright
% \item \texttt{synaptic-base.sty}: engine and class checks, key parsing,
%   \texttt{\string\SynapticSetup}, mode dispatch.
% \item \texttt{synaptic-lang-en.def} and \texttt{synaptic-lang-zh.def}:
%   bilingual label constants loaded before any module.
% \item \texttt{synaptic-color.sty}: theme registry and semantic colour
%   tokens, print and monochrome delivery.
% \item \texttt{synaptic-fonts.sty}: complete font bundles, deterministic
%   auto-selection, CJK fonts.
% \item \texttt{synaptic-layout.sty}: geometry, paragraph typography,
%   headings, running-head hairline, equation numbering.
% \item \texttt{synaptic-theorem.sty}: theorem styles and environments,
%   proofs, optional math alphabets.
% \item \texttt{synaptic-title.sty}: shared metadata model and the four
%   mode-aware title renderers.
% \item \texttt{synaptic-journal.sty}, \texttt{synaptic-book.sty},
%   \texttt{synaptic-lecture.sty} (with \texttt{synaptic-boxes.sty}), and
%   \texttt{synaptic-notes.sty}: mode-specific design and navigation layers.
% \end{itemize}
%
% \section{User API}
% \DescribeMacro{\SynapticTitle} Sets the document title, which is required
% before \texttt{\string\SynapticMakeTitle}.
% \DescribeMacro{\SynapticSubtitle} Sets an optional display subtitle.
% \DescribeMacro{\SynapticAuthor} Appends an author; the optional argument is
%   an affiliation mark. Repeatable.
% \DescribeMacro{\SynapticAffiliation} Appends an affiliation; the optional
%   argument is the matching mark. Repeatable.
% \DescribeMacro{\SynapticEmail} Appends a clickable contact address.
%   Repeatable.
% \DescribeMacro{\SynapticKeywords} Sets printed and PDF keywords.
% \DescribeMacro{\SynapticMakeTitle} Validates the stored metadata and renders
%   the mode-specific title sequence and optional table of contents.
% \DescribeMacro{\SynapticSetup} Applies runtime-safe keys:
%   \texttt{theme}, \texttt{toc}, \texttt{toc-layout}. Frozen keys warn.
% \DescribeMacro{\SynapticNewTheorem} Declares a custom theorem environment
%   with style \texttt{plain}, \texttt{definition}, or \texttt{remark}.
% \DescribeMacro{\SynapticDefineTheme} Defines and activates a custom theme
%   from xcolor expressions: primary, secondary, optional accent.
% \DescribeMacro{\SynapticUseTheme} Activates a built-in or defined theme.
% \DescribeMacro{\SynapticStatement} Journal declaration block; the starred
%   form omits the table-of-contents entry.
% \DescribeMacro{\SynapticAcknowledgments} Chapter-scale (book) or
%   section-scale acknowledgments; the starred form omits the TOC entry.
% \DescribeMacro{\SynapticFrontMatter} \DescribeMacro{\SynapticMainMatter}
% \DescribeMacro{\SynapticBackMatter} Book-matter switches that restore the
%   appropriate chapter scale and clear running marks.
%
% \StopEventually{\PrintChanges\PrintIndex}
%
% \section{Implementation}
%
% Each module is extracted from the dtx under a DocStrip guard.
% See \texttt{synaptic.ins} for the full extraction mapping.

% \subsection{synaptic-base.sty}
%
% \paragraph{Core: engine check, options, module dispatching.}
%
%    \begin{macrocode}
%<*base>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-base}{2026-08-27}{2.4.0}
  {Synaptic~Core~Infrastructure}

\msg_new:nnn { synaptic } { luatex-required }
  { The~synaptic~package~requires~LuaLaTeX. }
\msg_new:nnn { synaptic } { koma-required }
  { The~synaptic~package~requires~a~KOMA-Script~document~class. }
\msg_new:nnn { synaptic } { book-class-required }
  { mode=book~requires~a~chapter-based~KOMA-Script~class,~normally~scrbook. }

% ---------------------------------------------------------------------------
% Engine and class checks
% ---------------------------------------------------------------------------
\sys_if_engine_luatex:F
  { \msg_fatal:nn { synaptic } { luatex-required } }

% ---------------------------------------------------------------------------
% KOMA-Script check
% ---------------------------------------------------------------------------
\cs_if_exist:cF { KOMAoptions }
  { \msg_fatal:nn { synaptic } { koma-required } }

% ---------------------------------------------------------------------------
% Option variables
% ---------------------------------------------------------------------------
\tl_new:N  \l_synaptic_mode_tl
\tl_new:N  \l_synaptic_theme_tl
\tl_new:N  \l_synaptic_lang_tl
\tl_new:N  \l_synaptic_fontset_tl
\tl_new:N  \l_synaptic_toc_layout_tl
\tl_new:N  \l_synaptic_title_layout_tl
\tl_new:N  \l_synaptic_numbering_tl
\tl_new:N  \l_synaptic_box_numbering_tl
\tl_new:N  \l_synaptic_color_mode_tl
\tl_new:N  \l_synaptic_density_tl
\tl_new:N  \l_synaptic_measure_tl
\tl_new:N  \l_synaptic_theorem_style_tl
\bool_new:N \l_synaptic_toc_bool
\bool_new:N \l_synaptic_toc_explicit_bool
\bool_new:N \l_synaptic_extra_math_bool
\bool_new:N \l_synaptic_fine_breaking_bool
\dim_new:N  \l_synaptic_binding_offset_dim

\bool_set_true:N  \l_synaptic_toc_bool
\bool_set_false:N \l_synaptic_toc_explicit_bool

% ---------------------------------------------------------------------------
% \SynapticSetup — unified configuration interface
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_base_unknown_warning:n #1
  {
    \PackageWarning{synaptic-base}
      {Unknown~option~`#1'.~Ignored.}
  }

\keys_define:nn { synaptic }
  {
    % --- mode system ---
    mode .choice:,
    mode / journal .code:n  = \tl_set:Nn \l_synaptic_mode_tl { journal },
    mode / book   .code:n  = \tl_set:Nn \l_synaptic_mode_tl { book },
    mode / lecture.code:n  = \tl_set:Nn \l_synaptic_mode_tl { lecture },
    mode / notes  .code:n  = \tl_set:Nn \l_synaptic_mode_tl { notes },
    mode .initial:n = journal,

    % --- theme system ---
    theme .choice:,
    theme / ocean    .code:n = \tl_set:Nn \l_synaptic_theme_tl { ocean },
    theme / graphite .code:n = \tl_set:Nn \l_synaptic_theme_tl { graphite },
    theme / forest   .code:n = \tl_set:Nn \l_synaptic_theme_tl { forest },
    theme / midnight .code:n = \tl_set:Nn \l_synaptic_theme_tl { midnight },
    theme / paper    .code:n = \tl_set:Nn \l_synaptic_theme_tl { paper },
    theme .initial:n = ocean,

    % --- language ---
    lang .choice:,
    lang / en .code:n = \tl_set:Nn \l_synaptic_lang_tl { en },
    lang / zh .code:n = \tl_set:Nn \l_synaptic_lang_tl { zh },
    lang .initial:n = en,

    % --- fontset ---
    fontset .choice:,
    fontset / auto       .code:n = \tl_set:Nn \l_synaptic_fontset_tl { auto },
    fontset / xcharter   .code:n = \tl_set:Nn \l_synaptic_fontset_tl { xcharter },
    fontset / libertinus .code:n = \tl_set:Nn \l_synaptic_fontset_tl { libertinus },
    fontset / stix2      .code:n = \tl_set:Nn \l_synaptic_fontset_tl { stix2 },
    fontset / lm         .code:n = \tl_set:Nn \l_synaptic_fontset_tl { lm },
    fontset .initial:n = auto,

    % --- generic booleans ---
    toc .choice:,
    toc / true .code:n =
      {
        \bool_set_true:N \l_synaptic_toc_bool
        \bool_set_true:N \l_synaptic_toc_explicit_bool
      },
    toc / false .code:n =
      {
        \bool_set_false:N \l_synaptic_toc_bool
        \bool_set_true:N \l_synaptic_toc_explicit_bool
      },
    toc .default:n = true,

    extra-math .bool_set:N = \l_synaptic_extra_math_bool,
    extra-math .initial:n  = false,

    fine-breaking .bool_set:N = \l_synaptic_fine_breaking_bool,
    fine-breaking .initial:n  = true,

    % --- toc layout ---
    toc-layout .choice:,
    toc-layout / top    .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { top },
    toc-layout / inline .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { inline },
    toc-layout / page   .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { page },
    toc-layout .initial:n = top,

    % --- title composition ---
    title-layout .choice:,
    title-layout / auto    .code:n = \tl_set:Nn \l_synaptic_title_layout_tl { auto },
    title-layout / inline  .code:n = \tl_set:Nn \l_synaptic_title_layout_tl { inline },
    title-layout / compact .code:n = \tl_set:Nn \l_synaptic_title_layout_tl { compact },
    title-layout / page    .code:n = \tl_set:Nn \l_synaptic_title_layout_tl { page },
    title-layout / cover   .code:n = \tl_set:Nn \l_synaptic_title_layout_tl { cover },
    title-layout .initial:n = auto,

    % --- structural numbering ---
    numbering .choice:,
    numbering / auto       .code:n = \tl_set:Nn \l_synaptic_numbering_tl { auto },
    numbering / section    .code:n = \tl_set:Nn \l_synaptic_numbering_tl { section },
    numbering / chapter    .code:n = \tl_set:Nn \l_synaptic_numbering_tl { chapter },
    numbering / continuous .code:n = \tl_set:Nn \l_synaptic_numbering_tl { continuous },
    numbering / none       .code:n = \tl_set:Nn \l_synaptic_numbering_tl { none },
    numbering .initial:n = auto,

    box-numbering .choice:,
    box-numbering / shared   .code:n = \tl_set:Nn \l_synaptic_box_numbering_tl { shared },
    box-numbering / separate .code:n = \tl_set:Nn \l_synaptic_box_numbering_tl { separate },
    box-numbering / none     .code:n = \tl_set:Nn \l_synaptic_box_numbering_tl { none },
    box-numbering .initial:n = shared,

    % --- visual delivery and rhythm ---
    color-mode .choice:,
    color-mode / screen .code:n = \tl_set:Nn \l_synaptic_color_mode_tl { screen },
    color-mode / print  .code:n = \tl_set:Nn \l_synaptic_color_mode_tl { print },
    color-mode / mono   .code:n = \tl_set:Nn \l_synaptic_color_mode_tl { mono },
    color-mode .initial:n = screen,

    density .choice:,
    density / compact  .code:n = \tl_set:Nn \l_synaptic_density_tl { compact },
    density / balanced .code:n = \tl_set:Nn \l_synaptic_density_tl { balanced },
    density / airy     .code:n = \tl_set:Nn \l_synaptic_density_tl { airy },
    density .initial:n = balanced,

    measure .choice:,
    measure / auto     .code:n = \tl_set:Nn \l_synaptic_measure_tl { auto },
    measure / narrow   .code:n = \tl_set:Nn \l_synaptic_measure_tl { narrow },
    measure / standard .code:n = \tl_set:Nn \l_synaptic_measure_tl { standard },
    measure / wide     .code:n = \tl_set:Nn \l_synaptic_measure_tl { wide },
    measure .initial:n = auto,

    theorem-style .choice:,
    theorem-style / boxed  .code:n = \tl_set:Nn \l_synaptic_theorem_style_tl { boxed },
    theorem-style / plain  .code:n = \tl_set:Nn \l_synaptic_theorem_style_tl { plain },
    theorem-style .initial:n = boxed,

    binding-offset .dim_set:N = \l_synaptic_binding_offset_dim,
    binding-offset .initial:n = 0pt,

    % --- legacy: emit errors for old options ---
    style .code:n =
      {
        \PackageError{synaptic-base}{Option~`style'~is~obsolete}
          {Use~`mode=journal'~or~`mode=notes'~instead.}
      },
    color .code:n =
      {
        \PackageError{synaptic-base}{Option~`color'~is~obsolete}
          {Use~`theme=ocean'~or~`theme=graphite'~etc.~instead.}
      },

    % --- unknown ---
    unknown .code:n = \__synaptic_base_unknown_warning:n { \l_keys_key_tl },
  }

% Runtime settings deliberately exclude options which require module reloads.
\NewDocumentCommand{\SynapticSetup}{m}
  {
    \keys_set:nn { synaptic / runtime } {#1}
  }

\keys_define:nn { synaptic / runtime }
  {
    toc .bool_set:N = \l_synaptic_toc_bool,
    toc-layout .choice:,
    toc-layout / top    .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { top },
    toc-layout / inline .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { inline },
    toc-layout / page   .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { page },
    theme .code:n =
      {
        \cs_if_exist:NTF \synaptic_color_use_theme:n
          { \synaptic_color_use_theme:n {#1} }
          { \PackageWarning{synaptic-base}{Theme~system~is~not~loaded~yet} }
      },
    mode .code:n = \PackageWarning{synaptic-base}
      {Option~`mode'~is~frozen~after~package~loading},
    lang .code:n = \PackageWarning{synaptic-base}
      {Option~`lang'~is~frozen~after~package~loading},
    fontset .code:n = \PackageWarning{synaptic-base}
      {Option~`fontset'~is~frozen~after~package~loading},
    extra-math .code:n = \PackageWarning{synaptic-base}
      {Option~`extra-math'~is~frozen~after~package~loading},
    fine-breaking .code:n = \PackageWarning{synaptic-base}
      {Option~`fine-breaking'~is~frozen~after~package~loading},
    title-layout .code:n = \PackageWarning{synaptic-base}
      {Option~`title-layout'~is~frozen~after~package~loading},
    numbering .code:n = \PackageWarning{synaptic-base}
      {Option~`numbering'~is~frozen~after~package~loading},
    box-numbering .code:n = \PackageWarning{synaptic-base}
      {Option~`box-numbering'~is~frozen~after~package~loading},
    color-mode .code:n = \PackageWarning{synaptic-base}
      {Option~`color-mode'~is~frozen~after~package~loading},
    density .code:n = \PackageWarning{synaptic-base}
      {Option~`density'~is~frozen~after~package~loading},
    measure .code:n = \PackageWarning{synaptic-base}
      {Option~`measure'~is~frozen~after~package~loading},
    theorem-style .code:n = \PackageWarning{synaptic-base}
      {Option~`theorem-style'~is~frozen~after~package~loading},
    binding-offset .code:n = \PackageWarning{synaptic-base}
      {Option~`binding-offset'~is~frozen~after~package~loading},
    unknown .code:n = \__synaptic_base_unknown_warning:n { \l_keys_key_tl },
  }

% Also accept options via \usepackage[...]
\ProcessKeyOptions[synaptic]

% Automatic contents are opt-in.  In particular, book users normally call
% \tableofcontents after entering front matter, not from the title renderer.
\bool_if:NF \l_synaptic_toc_explicit_bool
  { \bool_set_false:N \l_synaptic_toc_bool }
\str_if_eq:VnT \l_synaptic_numbering_tl { none }
  { \tl_set:Nn \l_synaptic_box_numbering_tl { none } }

% ---------------------------------------------------------------------------
% Public option accessors (for other modules)
% ---------------------------------------------------------------------------
\cs_new:Npn \synaptic_mode:    { \l_synaptic_mode_tl }
\cs_new:Npn \synaptic_theme:   { \l_synaptic_theme_tl }
\cs_new:Npn \synaptic_lang:    { \l_synaptic_lang_tl }
\cs_new:Npn \synaptic_fontset: { \l_synaptic_fontset_tl }
\cs_new:Npn \synaptic_title_layout: { \l_synaptic_title_layout_tl }
\cs_new:Npn \synaptic_numbering: { \l_synaptic_numbering_tl }
\cs_new:Npn \synaptic_box_numbering: { \l_synaptic_box_numbering_tl }
\cs_new:Npn \synaptic_color_mode: { \l_synaptic_color_mode_tl }
\cs_new:Npn \synaptic_density: { \l_synaptic_density_tl }
\cs_new:Npn \synaptic_measure: { \l_synaptic_measure_tl }
\cs_new:Npn \synaptic_theorem_style: { \l_synaptic_theorem_style_tl }

\cs_new_protected:Npn \synaptic_if_lang_zh:TF #1#2
  {
    \str_if_eq:eeTF { \l_synaptic_lang_tl } { zh } {#1} {#2}
  }

\cs_new:Npn \synaptic_if_toc:TF #1#2
  {
    \bool_if:NTF \l_synaptic_toc_bool {#1} {#2}
  }

\cs_new:Npn \synaptic_toc_layout: { \l_synaptic_toc_layout_tl }

% ---------------------------------------------------------------------------
% Load language definitions (must be before module loading)
% ---------------------------------------------------------------------------
\synaptic_if_lang_zh:TF
  { \file_input:n { synaptic-lang-zh.def } }
  { \file_input:n { synaptic-lang-en.def } }

\str_if_eq:VnT \l_synaptic_mode_tl { book }
  {
    \cs_if_exist:NF \chapter
      { \msg_fatal:nn { synaptic } { book-class-required } }
    \cs_if_exist:NF \frontmatter
      { \msg_fatal:nn { synaptic } { book-class-required } }
  }

% ---------------------------------------------------------------------------
% Mode-aware module loader
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_load_core_modules:
  {
    \RequirePackage{synaptic-color}
    \RequirePackage{synaptic-fonts}
    \RequirePackage{synaptic-layout}
    \RequirePackage{synaptic-theorem}
    \RequirePackage{synaptic-title}
  }

\cs_new_protected:Npn \__synaptic_load_mode_modules:
  {
    \str_case:Vn \l_synaptic_mode_tl
      {
        { journal }
          {
            \RequirePackage{synaptic-journal}
          }
        { book }
          {
            \RequirePackage{synaptic-book}
          }
        { lecture }
          {
            \RequirePackage{synaptic-lecture}
            \RequirePackage{synaptic-boxes}
          }
        { notes }
          {
            \RequirePackage{synaptic-notes}
          }
      }
  }

% Load everything at package end
\__synaptic_load_core_modules:
\__synaptic_load_mode_modules:

%</base>
%    \end{macrocode}

% \subsection{synaptic-color.sty}
%
% \paragraph{Theme colour system with 5 built-in themes.}
%
%    \begin{macrocode}
%<*color>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-color}{2026-08-27}{2.4.0}
  {Synaptic~Theme~Colour~System}

\RequirePackage{xcolor}

% ---------------------------------------------------------------------------
% Theme registry and semantic colour tokens
% ---------------------------------------------------------------------------
\definecolor{syn-theme-ocean-primary}{RGB}{0,106,176}
\definecolor{syn-theme-ocean-secondary}{RGB}{46,64,83}
\definecolor{syn-theme-ocean-accent}{RGB}{14,98,81}
\definecolor{syn-theme-graphite-primary}{RGB}{75,86,99}
\definecolor{syn-theme-graphite-secondary}{RGB}{45,52,62}
\definecolor{syn-theme-graphite-accent}{RGB}{41,128,185}
\definecolor{syn-theme-forest-primary}{RGB}{30,115,80}
\definecolor{syn-theme-forest-secondary}{RGB}{56,68,60}
\definecolor{syn-theme-forest-accent}{RGB}{183,86,10}
\definecolor{syn-theme-midnight-primary}{RGB}{25,55,109}
\definecolor{syn-theme-midnight-secondary}{RGB}{30,35,50}
\definecolor{syn-theme-midnight-accent}{RGB}{145,105,20}
\definecolor{syn-theme-paper-primary}{RGB}{55,58,62}
\definecolor{syn-theme-paper-secondary}{RGB}{45,48,52}
\definecolor{syn-theme-paper-accent}{RGB}{120,67,35}

\prop_new:N \g_synaptic_themes_prop
\clist_map_inline:nn { ocean, graphite, forest, midnight, paper }
  { \prop_gput:Nnn \g_synaptic_themes_prop {#1} { built-in } }

\definecolor{syn-semantic-danger}{RGB}{180,35,24}
\definecolor{syn-semantic-warning}{RGB}{145,90,0}
\definecolor{syn-semantic-success}{RGB}{20,120,75}

\cs_new_protected:Npn \__synaptic_color_derive:
  {
    \str_if_eq:VnT \l_synaptic_color_mode_tl { mono }
      {
        \colorlet{syn-primary}{black!78}
        \colorlet{syn-secondary}{black!86}
        \colorlet{syn-accent}{black!68}
      }
    \str_if_eq:VnTF \l_synaptic_color_mode_tl { mono }
      {
        \colorlet{syn-danger}{black!82}
        \colorlet{syn-warning}{black!68}
        \colorlet{syn-success}{black!76}
      }
      {
        \colorlet{syn-danger}{syn-semantic-danger}
        \colorlet{syn-warning}{syn-semantic-warning}
        \colorlet{syn-success}{syn-semantic-success}
      }
    \colorlet{syn-text-dark}{syn-secondary!92!black}
    % `muted-text' remains dark enough for small labels.  Decorative rules
    % deliberately use a separate, lighter token.
    \colorlet{syn-muted-text}{syn-secondary!82!white}
    \colorlet{syn-decoration-muted}{syn-secondary!42!white}
    \colorlet{syn-muted}{syn-muted-text}
    \colorlet{syn-rule}{syn-primary!28!white}
    \str_if_eq:VnTF \l_synaptic_color_mode_tl { screen }
      { \colorlet{syn-link}{syn-primary} }
      { \colorlet{syn-link}{syn-text-dark} }
    \colorlet{syn-surface}{syn-primary!4!white}
    \colorlet{syn-surface-strong}{syn-primary!10!white}
    \colorlet{syn-border}{syn-primary!38!white}
    \colorlet{syn-faded}{syn-primary!18!white}
    \colorlet{syn-light}{syn-primary!38!white}
    \colorlet{syn-on-primary}{white}
  }

\cs_new_protected:Npn \__synaptic_color_use_theme_aux:n #1
  {
    \prop_if_in:NnTF \g_synaptic_themes_prop {#1}
      {
        \colorlet{syn-primary}{syn-theme-#1-primary}
        \colorlet{syn-secondary}{syn-theme-#1-secondary}
        \colorlet{syn-accent}{syn-theme-#1-accent}
        \tl_set:Nn \l_synaptic_theme_tl {#1}
        \__synaptic_color_derive:
      }
      {
        \PackageError{synaptic-color}{Unknown~theme~`#1'}
          {Define~it~first~with~\string\SynapticDefineTheme.}
      }
  }

\cs_new_protected:Npn \synaptic_color_use_theme:n #1
  { \exp_args:Ne \__synaptic_color_use_theme_aux:n {#1} }

\NewDocumentCommand{\SynapticUseTheme}{m}
  { \synaptic_color_use_theme:n {#1} }

% #1 name, #2 primary colour expression, #3 secondary expression,
% optional #4 accent expression.  Defining a theme also activates it.
\NewDocumentCommand{\SynapticDefineTheme}{m m m o}
  {
    \colorlet{syn-theme-#1-primary}{#2}
    \colorlet{syn-theme-#1-secondary}{#3}
    \IfValueTF{#4}
      { \colorlet{syn-theme-#1-accent}{#4} }
      { \colorlet{syn-theme-#1-accent}{#2} }
    \prop_gput:Nnn \g_synaptic_themes_prop {#1} { custom }
    \synaptic_color_use_theme:n {#1}
  }

\synaptic_color_use_theme:n { \synaptic_theme: }

%</color>
%    \end{macrocode}

% \subsection{synaptic-fonts.sty}
%
% \paragraph{Fontset selection: xcharter/libertinus/stix2/lm/auto.}
%
%    \begin{macrocode}
%<*fonts>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-fonts}{2026-08-27}{2.4.0}
  {Synaptic~Font~System}

\RequirePackage{fontspec}
\RequirePackage{mathtools}
\RequirePackage[
  warnings-off = {
    mathtools-colon,
    mathtools-over,
    mathtools-overbracket
  }
]{unicode-math}

% ---------------------------------------------------------------------------
% Complete font-bundle checks.  Auto selection only chooses a bundle when
% every text and mathematics font required by that bundle is available.
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_fontset_xcharter_if_available:TF #1#2
  {
    \IfFontExistsTF{XCharter}
      { \IfFontExistsTF{Cabin}
          { \IfFontExistsTF{Inconsolatazi4}
              { \IfFontExistsTF{XCharter Math}{#1}{#2} }
              {#2} }
          {#2} }
      {#2}
  }

\cs_new_protected:Npn \__synaptic_fontset_libertinus_if_available:TF #1#2
  {
    \IfFontExistsTF{Libertinus Serif}
      { \IfFontExistsTF{Libertinus Sans}
          { \IfFontExistsTF{Libertinus Mono}
              { \IfFontExistsTF{Libertinus Math}{#1}{#2} }
              {#2} }
          {#2} }
      {#2}
  }

\cs_new_protected:Npn \__synaptic_fontset_stix_if_available:TF #1#2
  {
    \IfFontExistsTF{STIX Two Text}
      { \IfFontExistsTF{TeX Gyre Heros}
          { \IfFontExistsTF{Latin Modern Mono}
              { \IfFontExistsTF{STIX Two Math}{#1}{#2} }
              {#2} }
          {#2} }
      {#2}
  }

\cs_new_protected:Npn \__synaptic_fontset_xcharter:
  {
    \setmainfont{XCharter}[
      Ligatures    = TeX,
      Numbers      = {Lining,Proportional}
    ]
    \setsansfont{Cabin}[
      Scale        = 0.94,
      BoldFeatures = {LetterSpace=1.5}
    ]
    \setmonofont{Inconsolatazi4}[
      Scale        = MatchLowercase,
      StylisticSet = {2,3}
    ]
    \setmathfont{XCharter Math}
  }

\cs_new_protected:Npn \__synaptic_fontset_libertinus:
  {
    \setmainfont{Libertinus Serif}[
      Ligatures = TeX,
      Numbers   = {Lining,Proportional}
    ]
    \setsansfont{Libertinus Sans}[
      Scale = 0.95
    ]
    \setmonofont{Libertinus Mono}[
      Scale = MatchLowercase
    ]
    \setmathfont{Libertinus Math}
  }

\cs_new_protected:Npn \__synaptic_fontset_stix2:
  {
    \setmainfont{STIX Two Text}[
      Ligatures = TeX,
      Numbers   = {Lining,Proportional}
    ]
    \setsansfont{TeX Gyre Heros}[
      Scale = 0.95
    ]
    \setmonofont{Latin Modern Mono}[
      Scale = MatchLowercase
    ]
    \setmathfont{STIX Two Math}
  }

\cs_new_protected:Npn \__synaptic_fontset_lm:
  {
    \setmainfont{Latin Modern Roman}
    \setsansfont{Latin Modern Sans}
    \setmonofont{Latin Modern Mono}
    \setmathfont{Latin Modern Math}
  }

% ---------------------------------------------------------------------------
% Auto-detection and dispatch
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_fontset_auto:
  {
    \__synaptic_fontset_xcharter_if_available:TF
      { \__synaptic_fontset_xcharter: }
      {
        \__synaptic_fontset_libertinus_if_available:TF
          { \__synaptic_fontset_libertinus: }
          {
            \__synaptic_fontset_stix_if_available:TF
              { \__synaptic_fontset_stix2: }
              { \__synaptic_fontset_lm: }
          }
      }
  }

% ---------------------------------------------------------------------------
% Dispatch
% ---------------------------------------------------------------------------
\str_case:Vn \l_synaptic_fontset_tl
  {
    { xcharter }
      {
        \__synaptic_fontset_xcharter_if_available:TF
          { \__synaptic_fontset_xcharter: }
          { \PackageError{synaptic-fonts}{Incomplete~XCharter~font~bundle}
              {Install~XCharter,~Cabin,~Inconsolatazi4,~and~XCharter~Math.} }
      }
    { libertinus }
      {
        \__synaptic_fontset_libertinus_if_available:TF
          { \__synaptic_fontset_libertinus: }
          { \PackageError{synaptic-fonts}{Incomplete~Libertinus~font~bundle}
              {Install~Libertinus~Serif,~Sans,~Mono,~and~Math.} }
      }
    { stix2 }
      {
        \__synaptic_fontset_stix_if_available:TF
          { \__synaptic_fontset_stix2: }
          { \PackageError{synaptic-fonts}{Incomplete~STIX~Two~font~bundle}
              {Install~STIX~Two~Text/Math,~TeX~Gyre~Heros,~and~Latin~Modern~Mono.} }
      }
    { lm }         { \__synaptic_fontset_lm: }
    { auto }       { \__synaptic_fontset_auto: }
  }

% ---------------------------------------------------------------------------
% CJK fonts (lang=zh)
% ---------------------------------------------------------------------------
\synaptic_if_lang_zh:TF
  {
    \RequirePackage[heading=false, fontset=none, scheme=plain]{ctex}
    \IfFontExistsTF{Noto Serif CJK SC}
      {
        \setCJKmainfont{Noto Serif CJK SC}[
          UprightFont    = *~Regular,
          BoldFont       = *~Bold,
          ItalicFont     = *~Regular,
          BoldItalicFont = *~Bold,
          Scale          = 0.95
        ]
      }
      {
        \IfFontExistsTF{FandolSong-Regular.otf}
          {
            \PackageWarning{synaptic-fonts}
              {Noto~Serif~CJK~SC~not~found.~Falling~back~to~FandolSong.}
            \setCJKmainfont{FandolSong-Regular.otf}[
              BoldFont       = FandolSong-Bold.otf,
              ItalicFont     = FandolKai-Regular.otf,
              BoldItalicFont = FandolKai-Regular.otf,
              BoldItalicFeatures = {FakeBold=2},
              Scale          = 0.95
            ]
          }
          {
            \PackageError{synaptic-fonts}{No~CJK~main~font~found}
              {Install~Noto~Serif~CJK~SC~or~Fandol~fonts.}
          }
      }
    \IfFontExistsTF{Noto Sans CJK SC}
      {
        \setCJKsansfont{Noto Sans CJK SC}[
          UprightFont    = *~Regular,
          BoldFont       = *~Bold,
          ItalicFont     = *~Regular,
          BoldItalicFont = *~Bold,
          Scale          = 0.95
        ]
        \IfFontExistsTF{Noto Sans Mono CJK SC}
          {
            \setCJKmonofont{Noto Sans Mono CJK SC}[
              BoldFeatures = {FakeBold=2},
              Scale        = 0.95
            ]
          }
          { \setCJKmonofont{Noto Sans CJK SC}[Scale=0.95] }
      }
      {
        \IfFontExistsTF{FandolHei-Regular.otf}
          {
            \PackageWarning{synaptic-fonts}
              {Noto~Sans~CJK~SC~not~found.~Falling~back~to~FandolHei.}
            \setCJKsansfont{FandolHei-Regular.otf}[
              BoldFont = FandolHei-Bold.otf,
              Scale    = 0.95
            ]
            \setCJKmonofont{FandolFang-Regular.otf}[
              Scale = 0.95
            ]
          }
          {
            \PackageError{synaptic-fonts}{No~CJK~sans/mono~font~found}
              {Install~Noto~Sans~CJK~SC~or~Fandol~fonts.}
          }
      }
  }
  { }

