    \RedeclareSectionCommand[
      beforeskip = -4.5ex plus -1ex minus -.2ex,
      afterskip  = 2.5ex plus .2ex
    ]{section}
    \RedeclareSectionCommand[
      beforeskip = -3.0ex plus -0.5ex minus -.1ex,
      afterskip  = 1.5ex plus .1ex
    ]{subsection}
  }

% ---------------------------------------------------------------------------
% Lecture theorem presentation.  The core theorem module applies the shared
