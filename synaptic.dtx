\NewDocumentEnvironment{synbox}{ O{} }
  {
    \begin{tcolorbox}[
      enhanced,
      colback       = syn-surface,
      colframe      = syn-primary,
      coltitle      = white,
      fonttitle     = \bfseries\sffamily,
