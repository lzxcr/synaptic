%
%    \begin{macrocode}
%<*book>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-book}{2026-09-04}{5.3.0}
  {Synaptic~Book~Mode}

\RequirePackage[singlespacing=true]{scrlayer-scrpage}
