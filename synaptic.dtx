%<*fonts>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-fonts}{2026-09-04}{5.3.0}
  {Synaptic~Font~System}

\RequirePackage{fontspec}
\RequirePackage{mathtools}
\RequirePackage[
  warnings-off = {
    mathtools-colon,
    mathtools-over,
    mathtools-overbracket
  }
]{unicode-math}

% Synaptic intentionally has one font stack.  Missing fonts are configuration
% errors, never a reason to silently change the document's typography.
\cs_new_protected:Npn \__synaptic_require_font:n #1
  {
    \IfFontExistsTF{#1}
      { }
      {
        \PackageError{synaptic-fonts}{Required~font~`#1'~not~found}
          {Install~the~documented~system-font~packages~before~compiling.}
      }
  }

\clist_map_inline:nn
  { Libertinus~Serif, Libertinus~Sans, Libertinus~Mono, Libertinus~Math }
  { \__synaptic_require_font:n {#1} }

\setmainfont{Libertinus Serif}[
  Ligatures = TeX,
  Numbers   = {Lining,Proportional}
]
\setsansfont{Libertinus Sans}[
  BoldItalicFont     = {Libertinus Sans Italic},
  BoldItalicFeatures = {FakeBold=1.5},
  Scale              = 0.95
]
\setmonofont{Libertinus Mono}[Scale=MatchLowercase]
\setmathfont{Libertinus Math}
% Libertinus Math has no separate bold face.  Register a deterministic bold
% version from the same design so \boldmath never falls back to regular weight.
\setmathfont{Libertinus Math}[version=bold, FakeBold=1.5]

