    \str_if_eq:VnT \g__synaptic_mode_tl { lecture } { \raggedbottom }
    \str_if_eq:VnT \g__synaptic_mode_tl { notes }   { \raggedbottom }
  }

% Shared decorative vocabulary.  The asymmetric rail reads as a miniature
% connection diagram: signal, node, continuation.  It is built entirely from
% rules, so it remains sharp in print, scales with type, and follows every
% theme and colour-delivery mode without external artwork.
\cs_new:Npn \__synaptic_layout_node:
  { \textcolor{syn-accent}{\rule[0.16ex]{3.2pt}{3.2pt}} }

\cs_new_protected:Npn \__synaptic_layout_motif:
  {
    \noindent\hbox{
      \textcolor{syn-primary}{\rule[0.62ex]{2.8em}{1.15pt}}
      \hspace{0.48em}\__synaptic_layout_node:\hspace{0.48em}
      \textcolor{syn-rule}{\rule[0.62ex]{6.2em}{0.45pt}}}
  }

\cs_new:Npn \__synaptic_layout_header_mark:
  { \textcolor{syn-primary}{\rule[0.14ex]{3pt}{3pt}}\nobreakspace }

\cs_new:Npn \__synaptic_layout_footer_mark:
  {
    \textcolor{syn-rule}{\rule[0.58ex]{1.65em}{0.45pt}}
    \nobreakspace\__synaptic_layout_node:
  }

% ---------------------------------------------------------------------------
% Running-head separator line.  The mode modules load scrlayer-scrpage first
% and then call this helper, so the KOMA option is registered by then; the
% dedicated KOMA font keeps the hairline lighter than the head text.
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_layout_headsepline:
  {
    \KOMAoptions{headsepline=0.4pt}
    \setkomafont{headsepline}{\color{syn-rule}}
  }

\bool_lazy_and:nnT
  { ! \str_if_eq_p:Vn \g__synaptic_mode_tl { book } }
  { ! \str_if_eq_p:Vn \g__synaptic_mode_tl { beamer } }
  {
    \AfterTOCHead[toc]
      { \__synaptic_layout_motif:\par\addvspace{0.8em} }
  }

% ---------------------------------------------------------------------------
% Caption
% ---------------------------------------------------------------------------
\__synaptic_if_beamer:TF
  { }
  {
    \captionsetup{
      font      = small,
      labelfont = {bf, sf, color=syn-secondary},
      labelsep  = quad,
      skip      = 10pt
    }

    \setlist{
      itemsep = 0.25em,
      parsep  = 0pt,
      topsep  = 0.5em
    }
  }

% ---------------------------------------------------------------------------
% Section headings (KOMA)
% ---------------------------------------------------------------------------
\__synaptic_if_beamer:TF
  { }
  {
    \AddToHook{begindocument/before}
      {
        \setkomafont{section}{\normalfont\large\bfseries\sffamily\color{syn-primary}}
        \setkomafont{subsection}{\normalfont\normalsize\bfseries\sffamily\color{syn-text-dark}}
        \setkomafont{subsubsection}{\normalfont\small\bfseries\sffamily\color{syn-text-dark!85}}
        \setkomafont{paragraph}{\normalfont\small\bfseries\sffamily\color{syn-text-dark!80}}
        \setkomafont{subparagraph}{\normalfont\small\bfseries\sffamily\color{syn-text-dark!60}}

        % A muted number and one accent node make section starts easier to scan
        % without turning the number into a badge or a second headline.
        \renewcommand*{\sectionformat}{%
          {\normalfont\sffamily\color{syn-decoration-muted}\thesection\autodot}%
          \enskip\__synaptic_layout_node:\enskip}

        \RedeclareSectionCommand[
          beforeskip = -3.5ex plus -1ex minus -.2ex,
          afterskip  = 2.0ex plus .2ex
        ]{section}
        \RedeclareSectionCommand[
          beforeskip = -2.5ex plus -0.5ex minus -.1ex,
          afterskip  = 1.2ex plus .1ex
        ]{subsection}
        \RedeclareSectionCommand[
          beforeskip = -2.0ex plus -0.5ex minus -.1ex,
          afterskip  = 1.0ex plus .1ex
        ]{subsubsection}
        \RedeclareSectionCommand[
          beforeskip = -1.6ex plus -0.4ex minus -.1ex,
          afterskip  = 0.6ex plus .1ex
        ]{paragraph}
        \RedeclareSectionCommand[
          beforeskip = -1.3ex plus -0.3ex minus -.1ex,
          afterskip  = 0.5ex plus .1ex
        ]{subparagraph}
      }
  }

% ---------------------------------------------------------------------------
% Table of contents.  Refine the vertical rhythm, number alignment, and entry
% colour so the top level echoes the on-page heading colour while keeping
% KOMA's clean dotted leaders and dark page numbers.  This must run
% immediately before \tableofcontents is typeset: declarations made during
% package loading are overridden by KOMA's own TOC initialisation.
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_layout_toc_style:
  {
    \bool_if:NTF \g__synaptic_toc_bool
      {
        \clist_map_inline:nn { chapter, section }
          {
            \cs_if_exist:cT {l@##1}
              {
                \DeclareTOCStyleEntry[
                  beforeskip   = 1.0em plus 0.2em,
                  indent       = 0pt,
                  dynnumwidth,
                  entryformat  = {\bfseries\color{syn-primary}}
                ]{tocline}{##1}
              }
          }
        \clist_map_inline:nn { subsection }
          {
            \cs_if_exist:cT {l@##1}
              {
                \DeclareTOCStyleEntry[
                  beforeskip  = 0.25em,
                  indent      = 1.5em,
                  entryformat = {\color{syn-text-dark}}
                ]{tocline}{##1}
              }
          }
        \clist_map_inline:nn { subsubsection }
          {
            \cs_if_exist:cT {l@##1}
              {
                \DeclareTOCStyleEntry[
                  indent = 3em,
                  entryformat = {\color{syn-text-dark!85}}
                ]{tocline}{##1}
              }
          }
        \clist_map_inline:nn { paragraph }
          {
            \cs_if_exist:cT {l@##1}
              {
                \DeclareTOCStyleEntry[
                  indent = 4.5em,
                  entryformat = {\color{syn-text-dark!75}}
                ]{tocline}{##1}
              }
          }
        \clist_map_inline:nn { subparagraph }
          {
            \cs_if_exist:cT {l@##1}
              {
                \DeclareTOCStyleEntry[
                  indent = 6em,
                  entryformat = {\color{syn-text-dark!60}}
                ]{tocline}{##1}
              }
          }
      }
      { }
  }

% ---------------------------------------------------------------------------
% Equation numbering follows the mode unless explicitly overridden.
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_layout_number_equations_within:n #1
  { \numberwithin{equation}{#1} }

\cs_new_protected:Npn \__synaptic_layout_disable_display_numbers:
  {
    % Alias the unstarred AMS environments to their native starred forms.
    % Capturing an alignment body in an xparse environment breaks amsmath's
    % matching begin/end machinery, especially for align and alignat.
    \cs_set_eq:cc { equation }    { equation* }
    \cs_set_eq:cc { endequation } { endequation* }
    % The starred AMS alignment end macros intentionally delegate to their
    % unstarred counterparts.  Only the begin macro therefore needs aliasing;
    % aliasing both ends would create a recursive \endalign loop.
    \clist_map_inline:nn { align, alignat, flalign, gather, multline }
      { \cs_set_eq:cc { ##1 } { ##1* } }
  }

\str_case:VnF \g__synaptic_numbering_tl
  {
    { section }    { \__synaptic_layout_number_equations_within:n { section } }
    { chapter }
      { \__synaptic_layout_number_equations_within:n { chapter } }
    { continuous } { }
    { none }       { \__synaptic_layout_disable_display_numbers: }
  }
  {
    \str_if_eq:VnTF \g__synaptic_mode_tl { book }
      { \__synaptic_layout_number_equations_within:n { chapter } }
      { \__synaptic_layout_number_equations_within:n { section } }
  }

%</layout>
%    \end{macrocode}

% \subsection{synaptic-theorem.sty}
%
% \paragraph{Theorem/proof environments via thmtools + amsthm.}
%
%    \begin{macrocode}
%<*theorem>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-theorem}{2026-09-04}{5.3.0}
  {Synaptic~Theorem~Environments}

\RequirePackage{amsthm}
\RequirePackage{thmtools}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable, theorems}
\RequirePackage{needspace}

% ---------------------------------------------------------------------------
% Labels (defined in synaptic-lang-*.def, loaded by synaptic-base)
% ---------------------------------------------------------------------------

% ---------------------------------------------------------------------------
% Shared card primitive.  Mode modules extend this one quiet surface instead
% of re-implementing corner radii, border weight, and background behaviour.
% Theorem box presentation remains collapsible via theorem-style=plain.
% ---------------------------------------------------------------------------
\tcbset{
  synaptic/card-base/.style={
    enhanced,
    frame~hidden,
    boxrule     = 0pt,
    colback     = syn-surface,
    coltext     = syn-text-dark,
    arc         = 1.25pt,
    outer~arc   = 1.25pt,
    borderline~north = {0.35pt}{0pt}{syn-border}
  },
  synaptic/theorem-box/.style={
    synaptic/card-base,
    breakable,
    left        = 10pt,
    right       = 10pt,
    top         = 8pt,
    bottom      = 8pt,
    before~skip = 10pt,
    after~skip  = 10pt
  },
  synaptic/theorem-box-plain/.style={
    synaptic/theorem-box,
    borderline~west = {2.4pt}{0pt}{syn-primary}
  },
  synaptic/theorem-box-definition/.style={
    synaptic/theorem-box,
    colback = syn-accent!4!syn-bg,
    borderline~west = {2.4pt}{0pt}{syn-accent}
  },
  synaptic/theorem-box-remark/.style={
    synaptic/theorem-box,
    colback = syn-secondary!3!syn-bg,
    borderline~west = {2.2pt}{0pt}{syn-secondary}
  }
}

% ---------------------------------------------------------------------------
% Theorem style (journal/academic default)
% ---------------------------------------------------------------------------
\declaretheoremstyle[
  spaceabove    = 10pt plus 2pt minus 1pt,
  spacebelow    = 10pt plus 2pt minus 1pt,
  headfont      = \normalfont\bfseries\color{syn-primary},
  notefont      = \normalfont\upshape\color{syn-text-dark!85},
  bodyfont      = \__synaptic_if_lang_zh:TF
                    {\normalfont\upshape}{\normalfont\itshape},
  postheadspace = 0.8em plus 0.2em,
  headpunct     = {.}
]{syn-theorem-plain}

\declaretheoremstyle[
  spaceabove    = 10pt plus 2pt minus 1pt,
  spacebelow    = 10pt plus 2pt minus 1pt,
  headfont      = \normalfont\bfseries\color{syn-primary},
  notefont      = \normalfont\upshape\color{syn-text-dark!85},
  bodyfont      = \normalfont\upshape,
  postheadspace = 0.8em plus 0.2em,
  headpunct     = {.}
]{syn-theorem-definition}

\declaretheoremstyle[
  spaceabove    = 8pt plus 2pt minus 1pt,
  spacebelow    = 8pt plus 2pt minus 1pt,
  headfont      = \normalfont\bfseries\color{syn-secondary},
  notefont      = \normalfont\upshape,
  bodyfont      = \normalfont\upshape,
  postheadspace = 0.8em plus 0.2em,
  headpunct     = {.}
]{syn-theorem-remark}

% ---------------------------------------------------------------------------
% Statement environments (always available).  Books use chapter-level
% numbering by default; shorter modes use sections.  This keeps book labels
% such as 2.3 rather than the unnecessarily deep 2.1.3.
% ---------------------------------------------------------------------------
% The structural counter every statement environment shares.  thmtools'
% numberwithin registers the parent only for display (\thesyntheorem) and for
% the c<counter> reset, but not in hyperref's cl@<counter> list, so hyperref
% leaves \theH<counter> as a bare \arabic{syntheorem}.  That anchor then repeats
% across sections/chapters and the pdf backend reports duplicate destinations.
% We record the real parent and rebuild the anchors after the declarations.
\tl_new:N \g__synaptic_theorem_parent_tl

\clist_const:Nn \c__synaptic_theorem_plain_clist
  {
    syntheorem,synlemma,synproposition,syncorollary,synaxiom,
    synconjecture,synclaim,synproperty,synexample,synexercise
  }
\clist_const:Nn \c__synaptic_theorem_definition_clist
  { syndefinition,syncriterion,synconvention,synproblem,synsolution }
\clist_const:Nn \c__synaptic_theorem_remark_clist
  { synremark,synnote,synwarning }

\cs_new_protected:Npn \__synaptic_theorem_repair_anchor:n #1
  {
    \tl_if_empty:NF \g__synaptic_theorem_parent_tl
      {
        \cs_if_exist:cT { theH#1 }
          {
            % Build a live anchor: parent's H-value at use time, plus the
            % shared theorem counter.  (Do not bake a scratch register — it is
            % clobbered later, and a caught value would repeat across sections.)
            \cs_set:cpn { theH#1 }
              { \use:c { theH \g__synaptic_theorem_parent_tl } . \arabic{syntheorem} }
          }
      }
  }

\cs_new_protected:Npn \__synaptic_theorem_repair_anchors:
  {
    \clist_map_inline:Nn \c__synaptic_theorem_plain_clist
      { \__synaptic_theorem_repair_anchor:n {##1} }
    \clist_map_inline:Nn \c__synaptic_theorem_definition_clist
      { \__synaptic_theorem_repair_anchor:n {##1} }
    \clist_map_inline:Nn \c__synaptic_theorem_remark_clist
      { \__synaptic_theorem_repair_anchor:n {##1} }
  }

\cs_new_protected:Npn \__synaptic_theorem_declare_sibling:nn #1#2
  {
    \declaretheorem[
      style=syn-theorem-#2,
      name=\use:c { c__synaptic_label_\str_range:nnn {#1} {4} {-1}_tl },
      sibling=syntheorem
    ]{#1}
  }

\cs_new_protected:Npn \__synaptic_theorem_declare_siblings:
  {
    \clist_map_inline:nn
      { synlemma,synproposition,syncorollary,synaxiom,synconjecture,
        synclaim,synproperty,synexample,synexercise }
      { \__synaptic_theorem_declare_sibling:nn {##1} { plain } }
    \clist_map_inline:Nn \c__synaptic_theorem_definition_clist
      { \__synaptic_theorem_declare_sibling:nn {##1} { definition } }
    \clist_map_inline:Nn \c__synaptic_theorem_remark_clist
      { \__synaptic_theorem_declare_sibling:nn {##1} { remark } }
  }

\cs_new_protected:Npn \__synaptic_theorem_declare_within:n #1
  {
    \tl_gset:Nn \g__synaptic_theorem_parent_tl {#1}
    \declaretheorem[
      style=syn-theorem-plain,
      name=\c__synaptic_label_theorem_tl,
      numberwithin=#1
    ]{syntheorem}
    \__synaptic_theorem_declare_siblings:
    % thmtools' numberwithin does not feed the parent to hyperref, so the
    % shared counter's anchors repeat across structural numbers.  Rebuild the
    % H-anchor for every theorem environment against the real parent.
    \__synaptic_theorem_repair_anchors:
  }

\cs_new_protected:Npn \__synaptic_theorem_declare_continuous:
  {
    \tl_gclear:N \g__synaptic_theorem_parent_tl
    \declaretheorem[
      style=syn-theorem-plain,
      name=\c__synaptic_label_theorem_tl
    ]{syntheorem}
    \__synaptic_theorem_declare_siblings:
  }

\cs_new_protected:Npn \__synaptic_theorem_declare_unnumbered_sibling:nn #1#2
  {
    \declaretheorem[
      style=syn-theorem-#2,
      name=\use:c { c__synaptic_label_\str_range:nnn {#1} {4} {-1}_tl },
      numbered=no
    ]{#1}
  }

\cs_new_protected:Npn \__synaptic_theorem_declare_unnumbered:
  {
    \tl_gclear:N \g__synaptic_theorem_parent_tl
    \declaretheorem[style=syn-theorem-plain,
      name=\c__synaptic_label_theorem_tl,numbered=no]{syntheorem}
    \clist_map_inline:nn
      { synlemma,synproposition,syncorollary,synaxiom,synconjecture,
        synclaim,synproperty,synexample,synexercise }
      { \__synaptic_theorem_declare_unnumbered_sibling:nn {##1} { plain } }
    \clist_map_inline:Nn \c__synaptic_theorem_definition_clist
      { \__synaptic_theorem_declare_unnumbered_sibling:nn {##1} { definition } }
    \clist_map_inline:Nn \c__synaptic_theorem_remark_clist
      { \__synaptic_theorem_declare_unnumbered_sibling:nn {##1} { remark } }
  }

\str_case:VnF \g__synaptic_numbering_tl
  {
    { section }    { \__synaptic_theorem_declare_within:n { section } }
    { chapter }
      { \__synaptic_theorem_declare_within:n { chapter } }
    { continuous } { \__synaptic_theorem_declare_continuous: }
    { none }       { \__synaptic_theorem_declare_unnumbered: }
  }
  {
    \str_if_eq:VnTF \g__synaptic_mode_tl { book }
      { \__synaptic_theorem_declare_within:n { chapter } }
      { \__synaptic_theorem_declare_within:n { section } }
  }

% ---------------------------------------------------------------------------
% Boxed theorem presentation (theorem-style=boxed, the default).  The tcolorbox
% wrapping is applied at \begin{document} because the theorem environments are
% finalised only then; wrapping during package loading would be overwritten.
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_theorem_apply_boxes:
  {
    \str_if_eq:VnT \g__synaptic_theorem_style_tl { boxed }
      {
        \clist_map_inline:Nn \c__synaptic_theorem_plain_clist
          {
            \tcolorboxenvironment{##1}{synaptic/theorem-box-plain}
            \AddToHook{env/##1/before}
              {\__synaptic_if_beamer:TF{}{\Needspace{7\baselineskip}}}
          }
        \clist_map_inline:Nn \c__synaptic_theorem_definition_clist
          {
            \tcolorboxenvironment{##1}{synaptic/theorem-box-definition}
            \AddToHook{env/##1/before}
              {\__synaptic_if_beamer:TF{}{\Needspace{6\baselineskip}}}
          }
        \clist_map_inline:Nn \c__synaptic_theorem_remark_clist
          {
            \tcolorboxenvironment{##1}{synaptic/theorem-box-remark}
            \AddToHook{env/##1/before}
              {\__synaptic_if_beamer:TF{}{\Needspace{5\baselineskip}}}
          }
      }
  }
\AddToHook{begindocument/before}{\__synaptic_theorem_apply_boxes:}

\cs_new_protected:Npn \__synaptic_theorem_box_custom:nn #1#2
  {
    \str_if_eq:VnT \g__synaptic_theorem_style_tl { boxed }
      {
        \tcolorboxenvironment{#1}{synaptic/theorem-box-#2}
        \str_case:nn {#2}
          {
            { plain }
              { \AddToHook{env/#1/before}
                  {\__synaptic_if_beamer:TF{}{\Needspace{7\baselineskip}}} }
            { definition }
              { \AddToHook{env/#1/before}
                  {\__synaptic_if_beamer:TF{}{\Needspace{6\baselineskip}}} }
            { remark }
              { \AddToHook{env/#1/before}
                  {\__synaptic_if_beamer:TF{}{\Needspace{5\baselineskip}}} }
          }
      }
  }

% ---------------------------------------------------------------------------
% \SynapticNewTheorem
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_theorem_declare_custom_valid:nnn #1#2#3
  {
    \str_if_eq:VnTF \g__synaptic_numbering_tl { none }
      { \declaretheorem[style=syn-theorem-#1,name=#3,numbered=no]{#2} }
      { \declaretheorem[style=syn-theorem-#1,name=#3,sibling=syntheorem]{#2} }
    \__synaptic_theorem_repair_anchor:n {#2}
    \__synaptic_theorem_box_custom:nn {#2} {#1}
  }

\cs_new_protected:Npn \__synaptic_theorem_declare_custom:nnn #1#2#3
  {
    \regex_match:nnTF { \A syn [a-z] [a-z0-9]* \Z } {#2}
      {
        \bool_lazy_or:nnTF
          { \cs_if_exist_p:c {#2} }
          { \cs_if_exist_p:c { c@#2 } }
          {
            \PackageError{synaptic-theorem}
              {Statement~environment~`#2'~already~exists}
              {Choose~a~new~environment~name~in~the~synaptic~namespace.}
          }
          {
            \str_case:nnF {#1}
              {
                { plain }
                  { \__synaptic_theorem_declare_custom_valid:nnn {#1}{#2}{#3} }
                { definition }
                  { \__synaptic_theorem_declare_custom_valid:nnn {#1}{#2}{#3} }
                { remark }
                  { \__synaptic_theorem_declare_custom_valid:nnn {#1}{#2}{#3} }
              }
              {
                \PackageError{synaptic-theorem}{Unknown~statement~style~`#1'}
                  {Use~plain,~definition,~or~remark.}
              }
          }
      }
      {
        \PackageError{synaptic-theorem}{Invalid~statement~name~`#2'}
          {Use~a~lowercase~alphanumeric~environment~name~beginning~with~`syn'.}
      }
  }

\NewDocumentCommand{\SynapticNewTheorem}{O{plain} m m}
  { \__synaptic_theorem_declare_custom:nnn {#1} {#2} {#3} }

% ---------------------------------------------------------------------------
% Namespaced proof environment; amsthm's global proof remains untouched.
% ---------------------------------------------------------------------------
\cs_new:Npn \__synaptic_theorem_qed_symbol:
  { \textcolor{syn-primary}{\rule[0.05em]{0.5em}{0.5em}} }

\NewDocumentEnvironment{synproof}{ O{\c__synaptic_label_proof_tl} }
  {
    \par\addvspace{6pt plus 2pt}
    \pushQED{\__synaptic_theorem_qed_symbol:}
    \normalfont
    \trivlist
    \item[\hskip\labelsep \normalfont\bfseries\color{syn-primary} #1.]\ignorespaces
  }
  {
    \popQED\endtrivlist
  }

%</theorem>
%    \end{macrocode}

