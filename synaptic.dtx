% Import standard LaTeX metadata only when the Synaptic fields are empty.
% This lets lecture and notes users migrate from \title/\author/\date without
% forcing synaptic to redefine the class' \maketitle command.
\cs_new_protected:Npn \__synaptic_title_import_standard:
  {
    \tl_if_empty:NT \l_synaptic_title_tl
      {
        \cs_if_exist:cT { @title }
          {
            \tl_set:Nx \l_tmpa_tl { \exp_not:v { @title } }
            % The kernel's unset title/author values are warning-producing
            % token lists, not empty macros.  Never import those sentinels.
            \tl_if_in:NnF \l_tmpa_tl { \@latex@warning@no@line }
              {
                \tl_if_empty:NF \l_tmpa_tl
                  { \tl_gset_eq:NN \l_synaptic_title_tl \l_tmpa_tl }
              }
          }
      }
    \seq_if_empty:NT \l_synaptic_authors_seq
      {
        \cs_if_exist:cT { @author }
          {
            \tl_set:Nx \l_tmpa_tl { \exp_not:v { @author } }
            \tl_if_in:NnF \l_tmpa_tl { \@latex@warning@no@line }
              {
                \tl_if_empty:NF \l_tmpa_tl
                  {
                    \seq_gput_right:NV \l_synaptic_authors_seq \l_tmpa_tl
                    \seq_gput_right:Nn \l_synaptic_author_marks_seq { }
                  }
              }
          }
      }
    \tl_if_empty:NT \l_synaptic_date_tl
      {
        \cs_if_exist:cT { @date }
          { \tl_gset:Nx \l_synaptic_date_tl { \exp_not:v { @date } } }
      }
  }

\cs_new_protected:Npn \__synaptic_title_apply_pdf_metadata:
  {
    % Let hyperref perform the PDF-string conversion exactly once.  Feeding a
    % pre-converted \pdfstringdef result back into \hypersetup double-encodes
    % Unicode metadata under LuaLaTeX.
    \tl_set:Nx \l_synaptic_pdf_author_tl
      { \seq_use:Nn \l_synaptic_authors_seq {;~} }
    \tl_if_empty:NTF \l_synaptic_keywords_tl
      { \tl_set_eq:NN \l_tmpa_tl \l_synaptic_tags_tl }
      { \tl_set_eq:NN \l_tmpa_tl \l_synaptic_keywords_tl }
    \hypersetup{
      unicode     = true,
      pdftitle    = {\l_synaptic_title_tl},
      pdfauthor   = {\l_synaptic_pdf_author_tl},
      pdfsubject  = {\l_synaptic_subject_tl},
      pdfkeywords = {\l_tmpa_tl}
    }
  }

\AddToHook{begindocument}{\__synaptic_title_apply_pdf_metadata:}

