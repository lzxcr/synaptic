%    \begin{macrocode}
%<*layout>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-layout}{2026-09-04}{5.3.0}
  {Synaptic~Page~Layout}

\RequirePackage{hyperref}
\RequirePackage{bookmark}

\__synaptic_if_beamer:TF
  { }
  {
    \RequirePackage{geometry}
    \RequirePackage{setspace}
    \RequirePackage{caption}
    \RequirePackage{enumitem}
    \KOMAoptions{numbers=noendperiod}
  }

% ctex is loaded by the font module immediately before this layout module.
% Apply the Synaptic language names here (and once more at begin-document end)
% so ctex's neutral `scheme=plain` defaults cannot restore English labels in
% an otherwise Chinese document.
\cs_new_protected:Npn \__synaptic_layout_apply_structure_names:
  {
    \renewcommand*{\contentsname}{\c__synaptic_label_contents_tl}
    \renewcommand*{\listfigurename}{\c__synaptic_label_list_figures_tl}
    \renewcommand*{\listtablename}{\c__synaptic_label_list_tables_tl}
  }
\__synaptic_layout_apply_structure_names:
\AddToHook{begindocument/end}{\__synaptic_layout_apply_structure_names:}

% ---------------------------------------------------------------------------
% Mode-aware geometry
% ---------------------------------------------------------------------------
\str_case:Vn \g__synaptic_mode_tl
  {
    { journal }
      {
        \geometry{
          textwidth  = 0.71\paperwidth,
          textheight = 0.81\paperheight,
          top        = 0.075\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 16pt,
          footskip   = 26pt,
          includeheadfoot
        }
      }
    { lecture }
      {
        \geometry{
          textwidth  = 0.76\paperwidth,
          textheight = 0.80\paperheight,
          top        = 0.075\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 16pt,
          footskip   = 26pt,
          includeheadfoot
        }
      }
    { book }
      {
        \geometry{
          textheight = 0.80\paperheight,
          top        = 0.075\paperheight,
          inner      = 0.135\paperwidth,
          outer      = 0.145\paperwidth,
          bindingoffset = \dim_use:N \g__synaptic_binding_offset_dim,
          headheight = 22pt,
          headsep    = 17pt,
          footskip   = 25pt,
          includeheadfoot,
          twoside
        }
      }
    { notes }
      {
        \geometry{
          textwidth  = 0.82\paperwidth,
          textheight = 0.84\paperheight,
          top        = 0.055\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 13pt,
          footskip   = 22pt,
          includeheadfoot
        }
      }
  }

% Explicit measure choices override the mode default while preserving duplex
% book margins.  `auto' is the carefully chosen default above.
\__synaptic_if_beamer:TF
  { }
  {
    \str_case:Vn \g__synaptic_measure_tl
      {
        { narrow }
          {
            \str_if_eq:VnTF \g__synaptic_mode_tl { book }
              { \geometry{inner=0.165\paperwidth,outer=0.175\paperwidth} }
              { \geometry{textwidth=0.64\paperwidth,hcentering} }
          }
        { standard }
          {
            \str_if_eq:VnTF \g__synaptic_mode_tl { book }
              { \geometry{inner=0.135\paperwidth,outer=0.145\paperwidth} }
              { \geometry{textwidth=0.72\paperwidth,hcentering} }
          }
        { wide }
          {
            \str_if_eq:VnTF \g__synaptic_mode_tl { book }
              { \geometry{inner=0.105\paperwidth,outer=0.115\paperwidth} }
              { \geometry{textwidth=0.84\paperwidth,hcentering} }
          }
      }
  }

