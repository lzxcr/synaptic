% ---------------------------------------------------------------------------
% Native blocks as single-layer cards.
%
% Beamer's default block template pads its contents with `colsep' skips
% inside a box whose natural width then exceeds \textwidth; beamer's
% fallback box lets that overhang protrude into the outer margins, so the
% title strip and the body visibly stick out of the text block (see the
% measured 3pt overhang on every block page).  The synaptic template wraps
% the block in one tcolorbox exactly \linewidth wide.  A semantic side rail
% and inline heading replace the heavy filled strip, so native and namespaced
% cards now share one visual grammar without crossing the text margins.
% ---------------------------------------------------------------------------
\tcbset{
  synaptic/native-block/.style={
    synaptic/card-base,
    colback     = syn-surface,
    coltext     = syn-text-dark,
    coltitle    = syn-primary,
    borderline~west = {2.4pt}{0pt}{syn-primary},
    attach~title~to~upper = {\par\vspace{0.38ex}},
    left        = 9pt,
    right       = 9pt,
    top         = 5.5pt,
    bottom      = 6pt,
    before~skip = 0.35ex,
    after~skip  = 0.35ex
  },
  synaptic/native-block-alerted/.style={
    synaptic/native-block,
    coltitle       = syn-danger,
    colback        = syn-danger!5!syn-bg,
    borderline~west = {2.4pt}{0pt}{syn-danger}
  },
  synaptic/native-block-example/.style={
    synaptic/native-block,
    coltitle       = syn-accent,
    colback        = syn-accent!5!syn-bg,
    borderline~west = {2.4pt}{0pt}{syn-accent}
  }
}
\defbeamertemplate*{block~begin}{synaptic}
  {
    \begin{tcolorbox}[
      synaptic/native-block,
      fonttitle = \usebeamerfont{block~title},
      title     = \insertblocktitle
    ]
  }
\defbeamertemplate*{block~end}{synaptic}
  { \end{tcolorbox} }
\defbeamertemplate*{block~alerted~begin}{synaptic}
  {
    \begin{tcolorbox}[
      synaptic/native-block-alerted,
      fonttitle = \usebeamerfont{block~title~alerted},
      title     = \insertblocktitle
    ]
  }
\defbeamertemplate*{block~alerted~end}{synaptic}
  { \end{tcolorbox} }
\defbeamertemplate*{block~example~begin}{synaptic}
  {
    \begin{tcolorbox}[
      synaptic/native-block-example,
      fonttitle = \usebeamerfont{block~title~example},
      title     = \insertblocktitle
    ]
  }
\defbeamertemplate*{block~example~end}{synaptic}
  { \end{tcolorbox} }
\setbeamertemplate{blocks}[synaptic]

% ---------------------------------------------------------------------------
% Single-layer semantic cards.
%
% Statement environments declared by synaptic-theorem are wrapped in a
% semantic tcolorbox card, so beamer's `theorem begin' template must not
% open a second, native block inside that card: the nested block
% reproduces the card chrome and adds a full title strip, extra height,
% and overflow.  The synaptic styles set \g__synaptic_beamer_card_bool
% before the template runs, so the card branch typesets only the
% amsthm-style head line inside the surrounding box; native beamer
% statement environments (whose styles do not set the flag) keep the
% standard block template untouched.
% ---------------------------------------------------------------------------
\bool_new:N \g__synaptic_beamer_card_bool
\bool_new:N \g__synaptic_beamer_card_open_bool

% Wrap the three synaptic theorem styles so the begin template can detect
% the surrounding semantic card.
\clist_map_inline:nn { plain, definition, remark }
  {
    \cs_set_eq:cc { __synaptic_beamer_style_#1: } { th@syn-theorem-#1 }
    \cs_set:cpn { th@syn-theorem-#1 }
      {
        \bool_gset_true:N \g__synaptic_beamer_card_bool
        \use:c { __synaptic_beamer_style_#1: }
      }
  }
% Native amsthm styles must clear the flag so a native statement never
% picks up a stale card state from a preceding semantic statement.
\clist_map_inline:nn { plain, definition, example }
  {
    \cs_set_eq:cc { __synaptic_beamer_native_#1: } { th@#1 }
    \cs_set:cpn { th@#1 }
      {
        \bool_gset_false:N \g__synaptic_beamer_card_bool
        \use:c { __synaptic_beamer_native_#1: }
      }
  }

\defbeamertemplate{theorem~begin}{synaptic}
  {%
    \bool_if:NTF \g__synaptic_beamer_card_bool
      {%
        \bool_gset_true:N \g__synaptic_beamer_card_open_bool
        \par\nobreak
        {\inserttheoremheadfont
          \inserttheoremname
          \inserttheoremnumber
          \ifx\inserttheoremaddition\@empty\else\ (\inserttheoremaddition)\fi
          \inserttheorempunctuation}\par\nobreak
        \vskip0.5ex\nobreak
      }
      {%
        \bool_gset_false:N \g__synaptic_beamer_card_open_bool
        \begin{\inserttheoremblockenv}
          {%
            \inserttheoremname
            \ifx\inserttheoremaddition\@empty\else\ (\inserttheoremaddition)\fi%
          }%
      }
  }
\defbeamertemplate{theorem~end}{synaptic}
  {%
    \bool_if:NTF \g__synaptic_beamer_card_open_bool
      { \par }
      { \end{\inserttheoremblockenv} }
  }
\setbeamertemplate{theorem~begin}[synaptic]
\setbeamertemplate{theorem~end}[synaptic]

