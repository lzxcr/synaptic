% \subsection{synaptic-beamer.sty}
%
% \paragraph{Beamer mode: presentation typography, navigation, and slide cards.}
%
%    \begin{macrocode}
%<*beamer>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-beamer}{2026-09-04}{5.3.0}
  {Synaptic~Beamer~Mode}

% ---------------------------------------------------------------------------
% Slide measure and typography
% ---------------------------------------------------------------------------
\dim_new:N \g__synaptic_beamer_margin_dim
\dim_new:N \l__synaptic_beamer_inner_width_dim
\dim_new:N \l__synaptic_beamer_progress_dim

\cs_new_protected:Npn \__synaptic_beamer_apply_measure:
  {
    \str_case:VnF \g__synaptic_measure_tl
      {
        { narrow }   { \dim_gset:Nn \g__synaptic_beamer_margin_dim { 0.075\paperwidth } }
        { standard } { \dim_gset:Nn \g__synaptic_beamer_margin_dim { 0.055\paperwidth } }
        { wide }     { \dim_gset:Nn \g__synaptic_beamer_margin_dim { 0.035\paperwidth } }
      }
      { \dim_gset:Nn \g__synaptic_beamer_margin_dim { 0.055\paperwidth } }
    \setbeamersize{
      text~margin~left  = \dim_use:N \g__synaptic_beamer_margin_dim,
      text~margin~right = \dim_use:N \g__synaptic_beamer_margin_dim
    }
    \dim_set:Nn \l__synaptic_beamer_inner_width_dim
      { \paperwidth - 2\g__synaptic_beamer_margin_dim }
  }
\__synaptic_beamer_apply_measure:

\usefonttheme{professionalfonts}
\setbeamerfont{normal~text}{family=\sffamily,size=\normalsize}
\setbeamerfont{title}{family=\sffamily,series=\bfseries,size=\huge}
\setbeamerfont{subtitle}{family=\sffamily,series=\mdseries,size=\large}
\setbeamerfont{frametitle}{family=\sffamily,series=\bfseries,size=\Large}
\setbeamerfont{framesubtitle}{family=\sffamily,series=\mdseries,size=\small}
\setbeamerfont{section~title}{family=\sffamily,series=\bfseries,size=\huge}
\setbeamerfont{block~title}{family=\sffamily,series=\bfseries,size=\normalsize}
\setbeamerfont{block~body}{family=\sffamily,size=\normalsize}
\setbeamerfont{caption}{family=\sffamily,size=\small}
\setbeamerfont{caption~name}{family=\sffamily,series=\bfseries}
\setbeamerfont{page~number~in~head/foot}{family=\sffamily,size=\scriptsize}
\setbeamerfont{section~in~toc}{family=\sffamily,series=\bfseries}
\setbeamerfont{subsection~in~toc}{family=\sffamily,series=\mdseries}
\setbeamerfont{description~item}{family=\sffamily,series=\bfseries}

% ---------------------------------------------------------------------------
% Semantic Beamer colours.  Values remain references to Synaptic colour names,
% so runtime theme and background changes continue to update subsequent frames.
% ---------------------------------------------------------------------------
\setbeamercolor{normal~text}{fg=syn-text-dark,bg=syn-bg}
\setbeamercolor{background~canvas}{bg=syn-bg}
\setbeamercolor{structure}{fg=syn-link}
\setbeamercolor{title}{fg=syn-text-dark}
\setbeamercolor{subtitle}{fg=syn-muted-text}
\setbeamercolor{frametitle}{fg=syn-text-dark,bg=syn-bg}
\setbeamercolor{framesubtitle}{fg=syn-muted-text,bg=syn-bg}
\setbeamercolor{section~title}{fg=syn-text-dark}
\setbeamercolor{section~in~toc}{fg=syn-text-dark}
\setbeamercolor{subsection~in~toc}{fg=syn-muted-text}
\setbeamercolor{alerted~text}{fg=syn-danger}
\setbeamercolor{block~title}{fg=syn-on-primary,bg=syn-primary}
\setbeamercolor{block~body}{fg=syn-text-dark,bg=syn-surface}
\setbeamercolor{block~title~alerted}{fg=syn-on-danger,bg=syn-danger}
\setbeamercolor{block~body~alerted}{fg=syn-text-dark,bg=syn-danger!5!syn-bg}
\setbeamercolor{block~title~example}{fg=white,bg=syn-accent}
\setbeamercolor{block~body~example}{fg=syn-text-dark,bg=syn-accent!5!syn-bg}
\setbeamercolor{caption~name}{fg=syn-secondary}
\setbeamercolor{synaptic~footer}{fg=syn-muted-text,bg=syn-bg}
\setbeamercolor{synaptic~title~meta}{fg=syn-text-dark,bg=syn-surface-strong}

% ---------------------------------------------------------------------------
% Lists, captions, and native blocks
% ---------------------------------------------------------------------------
\setbeamertemplate{navigation~symbols}{}
\setbeamertemplate{itemize~item}
  { \raisebox{0.20ex}{\textcolor{syn-primary}{\rule{2.8pt}{2.8pt}}} }
\setbeamertemplate{itemize~subitem}
  { \raisebox{0.38ex}{\textcolor{syn-accent}{\rule{4.2pt}{0.75pt}}} }
\setbeamertemplate{itemize~subsubitem}
  { \textcolor{syn-decoration-muted}{\raisebox{0.25ex}{\scriptsize\ensuremath{\bullet}}} }
\setbeamertemplate{enumerate~item}
  { \textcolor{syn-primary}{\bfseries\insertenumlabel.} }
\setbeamertemplate{enumerate~subitem}
  { \textcolor{syn-accent}{\bfseries\insertenumlabel.\insertsubenumlabel} }
\setbeamertemplate{description~item}
  { \usebeamerfont{description~item}\color{syn-primary}\insertdescriptionitem }
\setbeamertemplate{qed~symbol}
  { \textcolor{syn-primary}{\rule[0.05em]{0.52em}{0.52em}} }
\setbeamertemplate{bibliography~item}
  { \raisebox{0.20ex}{\textcolor{syn-primary}{\rule{2.8pt}{2.8pt}}} }
\setbeamertemplate{caption}[numbered]
\setbeamercovered{transparent=16}

% Number and title occupy stable columns, so short and long agendas share a
% clear reading edge.  The marker is typographic rather than badge-shaped and
% therefore remains quiet in both colour and monochrome output.
\defbeamertemplate*{section~in~toc}{synaptic}
  {
    \par\leavevmode
    \leftskip=2.55em
    \llap{\hbox~to~2.05em{%
      \usebeamerfont{section~in~toc}\color{syn-decoration-muted}%
      \inserttocsectionnumber\hfil}}
    {\usebeamerfont{section~in~toc}\usebeamercolor[fg]{section~in~toc}%
      \inserttocsection\par}
    \vskip0.62ex
  }
\defbeamertemplate*{subsection~in~toc}{synaptic}
  {
    \par\leavevmode
    \leftskip=2.55em
    \llap{\hbox~to~2.05em{\color{syn-rule}\rule[0.55ex]{1.05em}{0.45pt}\hfil}}
    {\usebeamerfont{subsection~in~toc}\usebeamercolor[fg]{subsection~in~toc}%
      \inserttocsubsection\par}
    \vskip0.28ex
  }
