\newpairofpagestyles{synapticblank}
  {
    \clearpairofpagestyles
    \cfoot{\__synaptic_layout_footer_mark:}
  }
\KOMAoptions{numbers=noendperiod,cleardoublepage=synapticblank}
\raggedbottom

% ---------------------------------------------------------------------------
% Chapter heading style
% ---------------------------------------------------------------------------
\AddToHook{begindocument/before}
  {
    \setkomafont{chapter}{\normalfont\Huge\bfseries\sffamily\color{syn-primary}}
    \setkomafont{chapterprefix}{\normalfont\normalsize\sffamily\color{syn-primary!60}}

    \RedeclareSectionCommand[
      beforeskip  = -1.5em,
      afterskip   = 1.8em,
      font        = \normalfont\Huge\bfseries\sffamily\color{syn-primary}
    ]{chapter}

    % Chapter decoration: number and title stay inline; the shared rail below
    % connects chapter openings to title matter and running navigation.
    \renewcommand*{\chapterformat}{%
      \thechapter\enskip
    }
    \renewcommand*{\chapterlinesformat}[3]{%
      #2#3%
      \par\nobreak\vspace{0.45em}%
      \__synaptic_layout_motif:\par\nobreak\vspace{0.65em}%
    }
  }

% ---------------------------------------------------------------------------
% Running headers (book)
% ---------------------------------------------------------------------------
\clearpairofpagestyles

\ohead{\__synaptic_layout_header_mark:\headmark}
\ofoot*{\__synaptic_layout_footer_mark:\enspace\pagemark}

\automark[section]{chapter}
\setkomafont{pageheadfoot}
  {\normalfont\small\sffamily\color{syn-muted-text}}
\pagestyle{scrheadings}
\__synaptic_layout_headsepline:

% ---------------------------------------------------------------------------
% Front/back matter styling
% ---------------------------------------------------------------------------
\NewDocumentCommand{\SynapticFrontMatter}{}
  {
    \frontmatter
    \markboth{}{}
    \setkomafont{chapter}
      {\normalfont\LARGE\bfseries\sffamily\color{syn-primary}}
  }
\NewDocumentCommand{\SynapticMainMatter}{}
  {
    \mainmatter
    \markboth{}{}
    \setkomafont{chapter}{\normalfont\Huge\bfseries\sffamily\color{syn-primary}}
  }
\NewDocumentCommand{\SynapticBackMatter}{}
  {
    \backmatter
    \markboth{}{}
    \setkomafont{chapter}
      {\normalfont\LARGE\bfseries\sffamily\color{syn-primary}}
  }

% ---------------------------------------------------------------------------
% Part style
% ---------------------------------------------------------------------------
\AddToHook{begindocument/before}
  {
    \renewcommand*{\raggedpart}{\raggedright}
    \setkomafont{part}
      {\normalfont\fontsize{32}{36}\selectfont\bfseries\sffamily\color{syn-primary}}
    \setkomafont{partnumber}
      {\normalfont\Large\bfseries\sffamily\color{syn-muted-text}}
    \renewcommand*{\partformat}{%
      {\usekomafont{partnumber}\partname\nobreakspace\thepart
        \par\nobreak\vspace{1.0em}}%
      \__synaptic_layout_motif:\par\nobreak\vspace{1.3em}%
    }
    \renewcommand*{\partlineswithprefixformat}[3]{%
      #2%
      \IfUseNumber
        {\par\nobreak\vspace{0.025\textheight}%
         {\normalfont\fontsize{72}{78}\selectfont\bfseries\sffamily
          \color{syn-faded}\thepart\par}%
         \vspace{0.025\textheight}}%
        {}%
      #3%
    }
    \RedeclareSectionCommand[
      beforeskip = -0.18\textheight,
      afterskip  = 3em
    ]{part}
    \renewcommand*{\partpagestyle}{synapticblank}
    \setkomafont{chapterentry}{\normalfont\bfseries\sffamily\color{syn-primary}}
    \setkomafont{chapterentrypagenumber}
      {\normalfont\bfseries\sffamily\color{syn-primary}}
  }

% ---------------------------------------------------------------------------
% Book workflow helpers
% ---------------------------------------------------------------------------
\NewDocumentCommand{\SynapticBookContents}{}
  { \__synaptic_layout_toc_style:\tableofcontents\cleardoublepage }

\NewDocumentCommand{\SynapticListOfFigures}{}
  { \listoffigures\cleardoublepage }

\NewDocumentCommand{\SynapticListOfTables}{}
  { \listoftables\cleardoublepage }

\NewDocumentCommand{\SynapticAppendices}{}
  { \cleardoublepage\appendix }

\NewDocumentCommand{\SynapticChapterSubtitle}{m}
  {
    \par\vspace{-1.0em}
    {\large\sffamily\color{syn-muted-text}#1\par}
    \vspace{1.25em}
  }

\NewDocumentCommand{\SynapticEpigraph}{m m}
  {
    \Needspace{7\baselineskip}
    \begin{flushright}
      \begin{minipage}{0.62\linewidth}
        \textcolor{syn-rule}{\rule{0.40\linewidth}{0.45pt}}\par\smallskip
        \raggedleft\__synaptic_if_lang_zh:TF{\upshape}{\itshape}
        \color{syn-text-dark}
        #1\par\smallskip
        {\normalfont\small\sffamily\color{syn-muted-text}
          \__synaptic_layout_node:\enspace#2}
      \end{minipage}
    \end{flushright}
    \addvspace{1.2em}
  }

