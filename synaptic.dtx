% \section{Introduction}
% \textbf{synaptic} is a modular \LaTeX3 design system for academic documents.
% It provides a clean, non-invasive API with mode-aware module loading
% and a Lua-powered font auto-detection engine.
%
% \section{Quick Start}
% \begin{verbatim}
% \documentclass{scrartcl}
% \usepackage[mode=journal,theme=ocean]{synaptic}
% \SynapticTitle{...}\SynapticAuthor{...}
% \begin{abstract}...\end{abstract}
% \begin{document}\SynapticMakeTitle\section{...}\end{document}
% \end{verbatim}
%
% \section{Key Options}
% \texttt{mode}=journal|book|lecture|notes,
% \texttt{theme}=ocean|graphite|forest|midnight|paper,
% \texttt{lang}=en|zh,
% \texttt{fontset}=auto|xcharter|libertinus|stix2|lm.
%
% \section{User API}
% \texttt{\string\SynapticTitle}, \texttt{\string\SynapticAuthor},
% \texttt{\string\SynapticAffiliation}, \texttt{\string\SynapticMakeTitle},
% \texttt{\string\SynapticSetup}, \texttt{\string\SynapticNewTheorem},
% \texttt{\string\SynapticDefineTheme}.
%
% \StopEventually{\PrintChanges\PrintIndex}
%
% \section{Implementation}
%
% Each module is extracted from the dtx under a DocStrip guard.
% See \texttt{synaptic.ins} for the full extraction mapping.

% \subsection{synaptic-base.sty}
%
% \paragraph{Core: engine check, options, module dispatching.}
%
%    \begin{macrocode}
%<*base>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-base}{2026-06-05}{2.0.0}
  {Synaptic~Core~Infrastructure}

% ---------------------------------------------------------------------------
% Engine check
% ---------------------------------------------------------------------------
\sys_if_engine_luatex:F
  {
    \PackageError{synaptic-base}{LuaLaTeX~required}
      {This~package~requires~LuaLaTeX.~Please~switch~your~compiler.}
  }

% ---------------------------------------------------------------------------
% KOMA-Script check
% ---------------------------------------------------------------------------
\cs_if_exist:cF { KOMAoptions }
  {
    \PackageError{synaptic-base}{KOMA-Script~document~class~required}
      {synaptic~requires~a~KOMA-Script~class~(scrartcl,~scrreprt,~scrbook,~etc.).}
  }

% ---------------------------------------------------------------------------
% Option variables
% ---------------------------------------------------------------------------
\tl_new:N  \l_synaptic_mode_tl
\tl_new:N  \l_synaptic_theme_tl
\tl_new:N  \l_synaptic_lang_tl
\tl_new:N  \l_synaptic_fontset_tl
\tl_new:N  \l_synaptic_toc_layout_tl
\bool_new:N \l_synaptic_toc_bool
\bool_new:N \l_synaptic_extra_math_bool
\bool_new:N \l_synaptic_fine_breaking_bool

% ---------------------------------------------------------------------------
% \SynapticSetup — unified configuration interface
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_base_unknown_warning:n #1
  {
    \PackageWarning{synaptic-base}
      {Unknown~option~`#1'.~Ignored.}
  }

\keys_define:nn { synaptic }
  {
    % --- mode system ---
    mode .choice:,
    mode / journal .code:n  = \tl_set:Nn \l_synaptic_mode_tl { journal },
    mode / book   .code:n  = \tl_set:Nn \l_synaptic_mode_tl { book },
    mode / lecture.code:n  = \tl_set:Nn \l_synaptic_mode_tl { lecture },
    mode / notes  .code:n  = \tl_set:Nn \l_synaptic_mode_tl { notes },
    mode .initial:n = journal,

    % --- theme system ---
    theme .choice:,
    theme / ocean    .code:n = \tl_set:Nn \l_synaptic_theme_tl { ocean },
    theme / graphite .code:n = \tl_set:Nn \l_synaptic_theme_tl { graphite },
    theme / forest   .code:n = \tl_set:Nn \l_synaptic_theme_tl { forest },
    theme / midnight .code:n = \tl_set:Nn \l_synaptic_theme_tl { midnight },
    theme / paper    .code:n = \tl_set:Nn \l_synaptic_theme_tl { paper },
    theme .initial:n = ocean,

    % --- language ---
    lang .choice:,
    lang / en .code:n = \tl_set:Nn \l_synaptic_lang_tl { en },
    lang / zh .code:n = \tl_set:Nn \l_synaptic_lang_tl { zh },
    lang .initial:n = en,

    % --- fontset ---
    fontset .choice:,
    fontset / auto       .code:n = \tl_set:Nn \l_synaptic_fontset_tl { auto },
    fontset / xcharter   .code:n = \tl_set:Nn \l_synaptic_fontset_tl { xcharter },
    fontset / libertinus .code:n = \tl_set:Nn \l_synaptic_fontset_tl { libertinus },
    fontset / stix2      .code:n = \tl_set:Nn \l_synaptic_fontset_tl { stix2 },
    fontset / lm         .code:n = \tl_set:Nn \l_synaptic_fontset_tl { lm },
    fontset .initial:n = auto,

    % --- generic booleans ---
    toc .bool_set:N = \l_synaptic_toc_bool,
    toc .initial:n  = true,

    extra-math .bool_set:N = \l_synaptic_extra_math_bool,
    extra-math .initial:n  = false,

    fine-breaking .bool_set:N = \l_synaptic_fine_breaking_bool,
    fine-breaking .initial:n  = true,

    % --- toc layout ---
    toc-layout .choice:,
    toc-layout / top    .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { top },
    toc-layout / inline .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { inline },
    toc-layout / page   .code:n = \tl_set:Nn \l_synaptic_toc_layout_tl { page },
    toc-layout .initial:n = top,

    % --- legacy: emit errors for old options ---
    style .code:n =
      {
        \PackageError{synaptic-base}{Option~`style'~is~obsolete}
          {Use~`mode=journal'~or~`mode=notes'~instead.}
      },
    color .code:n =
      {
        \PackageError{synaptic-base}{Option~`color'~is~obsolete}
          {Use~`theme=ocean'~or~`theme=graphite'~etc.~instead.}
      },

    % --- unknown ---
    unknown .code:n = \__synaptic_base_unknown_warning:n { \l_keys_key_tl },
  }

% Forward to package-level
\NewDocumentCommand{\SynapticSetup}{m}
  {
    \keys_set:nn { synaptic } {#1}
  }

% Also accept options via \usepackage[...]
\ProcessKeyOptions[synaptic]

% ---------------------------------------------------------------------------
% Public option accessors (for other modules)
% ---------------------------------------------------------------------------
\cs_new:Npn \synaptic_mode:    { \l_synaptic_mode_tl }
\cs_new:Npn \synaptic_theme:   { \l_synaptic_theme_tl }
\cs_new:Npn \synaptic_lang:    { \l_synaptic_lang_tl }
\cs_new:Npn \synaptic_fontset: { \l_synaptic_fontset_tl }

\cs_new_protected:Npn \synaptic_if_lang_zh:TF #1#2
  {
    \str_if_eq:eeTF { \l_synaptic_lang_tl } { zh } {#1} {#2}
  }

\cs_new:Npn \synaptic_if_toc:TF #1#2
  {
    \bool_if:NTF \l_synaptic_toc_bool {#1} {#2}
  }

\cs_new:Npn \synaptic_toc_layout: { \l_synaptic_toc_layout_tl }

% ---------------------------------------------------------------------------
% Load language definitions (must be before module loading)
% ---------------------------------------------------------------------------
\synaptic_if_lang_zh:TF
  { \file_input:n { synaptic-lang-zh.def } }
  { \file_input:n { synaptic-lang-en.def } }

% ---------------------------------------------------------------------------
% Mode-aware module loader
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_load_core_modules:
  {
    \RequirePackage{synaptic-color}
    \RequirePackage{synaptic-fonts}
    \RequirePackage{synaptic-layout}
    \RequirePackage{synaptic-theorem}
  }

\cs_new_protected:Npn \__synaptic_load_mode_modules:
  {
    \str_case:Vn \l_synaptic_mode_tl
      {
        { journal }
          {
            \RequirePackage{synaptic-title}
          }
        { book }
          {
            \RequirePackage{synaptic-title}
            \RequirePackage{synaptic-book}
          }
        { lecture }
          {
            \RequirePackage{synaptic-lecture}
            \RequirePackage{synaptic-boxes}
          }
        { notes }
          {
            % no extra modules
          }
      }
  }

% Load everything at package end
\__synaptic_load_core_modules:
\__synaptic_load_mode_modules:

%</base>
%    \end{macrocode}

% \subsection{synaptic-color.sty}
%
% \paragraph{Theme colour system with 5 built-in themes.}
%
%    \begin{macrocode}
%<*color>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-color}{2026-06-05}{2.0.0}
  {Synaptic~Theme~Colour~System}

\RequirePackage{xcolor}

% ---------------------------------------------------------------------------
% Theme colours
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_color_load_theme:n #1
  {
    \str_case:enF {#1}
      {
        { ocean }
          {
            \definecolor{syn-primary}{RGB}{0,106,176}
            \definecolor{syn-secondary}{RGB}{46,64,83}
            \definecolor{syn-accent}{RGB}{14,98,81}
          }
        { graphite }
          {
            \definecolor{syn-primary}{RGB}{75,86,99}
            \definecolor{syn-secondary}{RGB}{45,52,62}
            \definecolor{syn-accent}{RGB}{41,128,185}
          }
        { forest }
          {
            \definecolor{syn-primary}{RGB}{30,115,80}
            \definecolor{syn-secondary}{RGB}{56,68,60}
            \definecolor{syn-accent}{RGB}{211,84,0}
          }
        { midnight }
          {
            \definecolor{syn-primary}{RGB}{25,55,109}
            \definecolor{syn-secondary}{RGB}{30,35,50}
            \definecolor{syn-accent}{RGB}{200,170,80}
          }
        { paper }
          {
            \definecolor{syn-primary}{RGB}{55,58,62}
            \definecolor{syn-secondary}{RGB}{45,48,52}
            \definecolor{syn-accent}{RGB}{150,80,30}
          }
      }
      {
        \PackageError{synaptic-color}{Unknown~theme~`#1'}
          {Available~themes:~ocean,~graphite,~forest,~midnight,~paper}
      }
  }

% Load the active theme
\__synaptic_color_load_theme:n { \synaptic_theme: }

% ---------------------------------------------------------------------------
% Derived colours
% ---------------------------------------------------------------------------
\colorlet{syn-text-dark}{syn-secondary!90!black}
\colorlet{syn-rule}{syn-primary!25}
\colorlet{syn-link}{syn-primary}
\colorlet{syn-faded}{syn-primary!20}
\colorlet{syn-light}{syn-primary!40}

% ---------------------------------------------------------------------------
% \SynapticDefineTheme — user custom theme
% ---------------------------------------------------------------------------
\NewDocumentCommand{\SynapticDefineTheme}{m m m}
  {
    \definecolor{syn-primary}{#2}
    \definecolor{syn-secondary}{#3}
    \IfNoValueF {#1}
      {
        \definecolor{syn-accent} {#1}
      }
    % Re-derive
    \colorlet{syn-text-dark}{syn-secondary!90!black}
    \colorlet{syn-rule}{syn-primary!25}
    \colorlet{syn-link}{syn-primary}
    \colorlet{syn-faded}{syn-primary!20}
    \colorlet{syn-light}{syn-primary!40}
  }

%</color>
%    \end{macrocode}

% \subsection{synaptic-fonts.sty}
%
% \paragraph{Fontset selection: xcharter/libertinus/stix2/lm/auto.}
%
%    \begin{macrocode}
%<*fonts>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-fonts}{2026-06-05}{2.0.0}
  {Synaptic~Font~System}

\RequirePackage{fontspec}
\RequirePackage{mathtools}
\RequirePackage[ warnings-off = { mathtools-colon, mathtools-over, mathtools-overbracket } ]
  {unicode-math}

% ---------------------------------------------------------------------------
% Lua font helper — use kpathsea to locate the Lua module
% ---------------------------------------------------------------------------
\directlua
  {
    local path = kpse.find_file('synaptic-fonts.lua', 'lua')
    if path then
      dofile(path)
    end
  }

\cs_new:Npn \__synaptic_font_if_exist:n #1
  {
    \directlua
      {
        if tex.synaptic then
          tex.print(tex.synaptic.fonts.exists('#1') and 'true' or 'false')
        else
          tex.print('false')
        end
      }
  }

% ---------------------------------------------------------------------------
% Fontset definitions
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_fontset_xcharter:
  {
    \setmainfont{XCharter}[
      Ligatures    = TeX,
      Numbers      = {OldStyle,Proportional}
    ]
    \setsansfont{Cabin}[
      Scale        = 0.94,
      BoldFeatures = {LetterSpace=1.5}
    ]
    \setmonofont{Inconsolatazi4}[
      Scale        = MatchLowercase,
      StylisticSet = {2,3}
    ]
    \setmathfont{XCharter Math}
  }

\cs_new_protected:Npn \__synaptic_fontset_libertinus:
  {
    \setmainfont{Libertinus Serif}[
      Ligatures = TeX,
      Numbers   = {OldStyle,Proportional}
    ]
    \setsansfont{Libertinus Sans}[
      Scale = 0.95
    ]
    \setmonofont{Libertinus Mono}[
      Scale = MatchLowercase
    ]
    \setmathfont{Libertinus Math}
  }

\cs_new_protected:Npn \__synaptic_fontset_stix2:
  {
    \setmainfont{STIX Two Text}[
      Ligatures = TeX
    ]
    \setsansfont{STIX Two Text}[
      Scale = 0.95
    ]
    \setmonofont{STIX Two Text}[
      Scale = MatchLowercase
    ]
    \setmathfont{STIX Two Math}
  }

\cs_new_protected:Npn \__synaptic_fontset_lm:
  {
    \setmainfont{Latin Modern Roman}
    \setsansfont{Latin Modern Sans}
    \setmonofont{Latin Modern Mono}
    \setmathfont{Latin Modern Math}
  }

% ---------------------------------------------------------------------------
% Auto-detection (Lua-assisted)
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__synaptic_fontset_auto:
  {
    \directlua
      {
        if kpse.find_file('synaptic-fonts.lua', 'lua') then
          tex.print('lua')
        else
          tex.print('fallback')
        end
      }
    \str_if_eq:VnTF \l_tmpa_tl { lua }
      { \__synaptic_fontset_detect_lua: }
      { \__synaptic_fontset_detect_fallback: }
  }

\cs_new_protected:Npn \__synaptic_fontset_detect_lua:
  {
    \directlua
      {
        local result = tex.synaptic.fonts.detect()
        tex.print(result)
      }
    \tl_set:Nx \l_tmpa_tl { \synaptic_fontset: }
    \str_case:Vn \l_tmpa_tl
      {
        { xcharter }   { \__synaptic_fontset_xcharter: }
        { libertinus } { \__synaptic_fontset_libertinus: }
        { stix2 }      { \__synaptic_fontset_stix2: }
        { lm }         { \__synaptic_fontset_lm: }
      }
  }

\cs_new_protected:Npn \__synaptic_fontset_detect_fallback:
  {
    \IfFontExistsTF{XCharter}
      { \__synaptic_fontset_xcharter: }
      {
        \IfFontExistsTF{Libertinus Serif}
          { \__synaptic_fontset_libertinus: }
          {
            \IfFontExistsTF{STIX Two Text}
              { \__synaptic_fontset_stix2: }
              { \__synaptic_fontset_lm: }
          }
      }
  }

% ---------------------------------------------------------------------------
% Dispatch
% ---------------------------------------------------------------------------
\str_case:Vn \l_synaptic_fontset_tl
  {
    { xcharter }   { \__synaptic_fontset_xcharter: }
    { libertinus } { \__synaptic_fontset_libertinus: }
    { stix2 }      { \__synaptic_fontset_stix2: }
    { lm }         { \__synaptic_fontset_lm: }
    { auto }       { \__synaptic_fontset_auto: }
  }

% ---------------------------------------------------------------------------
% CJK fonts (lang=zh)
% ---------------------------------------------------------------------------
\synaptic_if_lang_zh:TF
  {
    \RequirePackage[heading=false, fontset=none, scheme=plain]{ctex}
    \IfFontExistsTF{Noto Serif CJK SC}
      {
        \setCJKmainfont{Noto Serif CJK SC}[
          UprightFont    = *~Regular,
          BoldFont       = *~Bold,
          ItalicFont     = *~Regular,
          ItalicFeatures = {AutoFakeSlant=0.17},
          Scale          = 0.95
        ]
      }
      {
        \IfFontExistsTF{FandolSong-Regular.otf}
          {
            \PackageWarning{synaptic-fonts}
              {Noto~Serif~CJK~SC~not~found.~Falling~back~to~FandolSong.}
            \setCJKmainfont{FandolSong-Regular.otf}[
              BoldFont = FandolSong-Bold.otf,
              Scale    = 0.95
            ]
          }
          {
            \PackageError{synaptic-fonts}{No~CJK~main~font~found}
              {Install~Noto~Serif~CJK~SC~or~Fandol~fonts.}
          }
      }
    \IfFontExistsTF{Noto Sans CJK SC}
      {
        \setCJKsansfont{Noto Sans CJK SC}[
          UprightFont    = *~Regular,
          BoldFont       = *~Regular,
          BoldFeatures   = {FakeBold=4},
          ItalicFont     = *~Regular,
          ItalicFeatures = {AutoFakeSlant=0.17},
          Scale          = 0.95
        ]
        \setCJKmonofont{Noto Sans CJK SC}[
          UprightFont    = *~Regular,
          BoldFont       = *~Regular,
          BoldFeatures   = {FakeBold=4},
          ItalicFont     = *~Regular,
          ItalicFeatures = {AutoFakeSlant=0.17},
          Scale          = 0.95
        ]
      }
      {
        \IfFontExistsTF{FandolHei-Regular.otf}
          {
            \PackageWarning{synaptic-fonts}
              {Noto~Sans~CJK~SC~not~found.~Falling~back~to~FandolHei.}
            \setCJKsansfont{FandolHei-Regular.otf}[
              BoldFont = FandolHei-Bold.otf,
              Scale    = 0.95
            ]
            \setCJKmonofont{FandolFang-Regular.otf}[
              Scale = 0.95
            ]
          }
          {
            \PackageError{synaptic-fonts}{No~CJK~sans/mono~font~found}
              {Install~Noto~Sans~CJK~SC~or~Fandol~fonts.}
          }
      }
  }
  { }

%</fonts>
%    \end{macrocode}

% \subsection{synaptic-layout.sty}
%
% \paragraph{Page geometry, microtype, KOMA heading configuration.}
%
%    \begin{macrocode}
%<*layout>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-layout}{2026-06-05}{2.0.0}
  {Synaptic~Page~Layout}

\RequirePackage{geometry}
\RequirePackage{setspace}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{bookmark}

% ---------------------------------------------------------------------------
% Mode-aware geometry
% ---------------------------------------------------------------------------
\str_case:Vn \l_synaptic_mode_tl
  {
    { journal }
      {
        \geometry{
          a4paper,
          textwidth  = 0.74\paperwidth,
          textheight = 0.76\paperheight,
          top        = 0.11\paperheight,
          left       = 0.13\paperwidth,
          headheight = 16pt,
          headsep    = 22pt,
          footskip   = 30pt,
          includeheadfoot
        }
      }
    { lecture }
      {
        \geometry{
          a4paper,
          textwidth  = 0.70\paperwidth,
          textheight = 0.74\paperheight,
          top        = 0.12\paperheight,
          left       = 0.14\paperwidth,
          headheight = 18pt,
          headsep    = 24pt,
          footskip   = 32pt,
          includeheadfoot
        }
      }
    { book }
      {
        \geometry{
          a4paper,
          textwidth  = 0.70\paperwidth,
          textheight = 0.76\paperheight,
          top        = 0.10\paperheight,
          left       = 0.15\paperwidth,
          headheight = 16pt,
          headsep    = 20pt,
          footskip   = 28pt,
          includeheadfoot,
          twoside
        }
      }
    { notes }
      {
        \geometry{
          a4paper,
          textwidth  = 0.78\paperwidth,
          textheight = 0.80\paperheight,
          top        = 0.08\paperheight,
          left       = 0.11\paperwidth,
          headheight = 14pt,
          headsep    = 18pt,
          footskip   = 24pt,
          includeheadfoot
        }
      }
  }

% ---------------------------------------------------------------------------
% Hyperref
% ---------------------------------------------------------------------------
\hypersetup{
  colorlinks  = true,
  urlcolor    = syn-link,
  linkcolor   = syn-link,
  citecolor   = syn-link,
  filecolor   = syn-link,
  linktocpage = true
}

% ---------------------------------------------------------------------------
% Microtype
% ---------------------------------------------------------------------------
\synaptic_if_lang_zh:TF
  {
    \PassOptionsToPackage{verbose=false, protrusion=false, expansion=false}{microtype}
  }
  {
    \PassOptionsToPackage{verbose=false}{microtype}
  }
\RequirePackage{microtype}

% ---------------------------------------------------------------------------
% Paragraph typography
% ---------------------------------------------------------------------------
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt plus 1pt}
\widowpenalty=10000
\clubpenalty=10000

\bool_if:NT \l_synaptic_fine_breaking_bool
  {
    \emergencystretch=4em
    \tolerance=4000
    \hfuzz=1.5pt
    \vfuzz=1.5pt
    \raggedbottom
  }

\setstretch{1.25}

% ---------------------------------------------------------------------------
% Caption
% ---------------------------------------------------------------------------
\captionsetup{
  font      = small,
  labelfont = {bf, sf},
  labelsep  = period,
  skip      = 10pt
}

% ---------------------------------------------------------------------------
% Section headings (KOMA)
% ---------------------------------------------------------------------------
\AddToHook{begindocument/before}
  {
    \setkomafont{section}{\normalfont\large\bfseries\sffamily\color{syn-primary}}
    \setkomafont{subsection}{\normalfont\normalsize\bfseries\sffamily}
    \setkomafont{subsubsection}{\normalfont\normalsize\bfseries}

    \RedeclareSectionCommand[
      beforeskip = -3.5ex plus -1ex minus -.2ex,
      afterskip  = 2.0ex plus .2ex
    ]{section}
    \RedeclareSectionCommand[
      beforeskip = -2.5ex plus -0.5ex minus -.1ex,
      afterskip  = 1.2ex plus .1ex
    ]{subsection}
    \RedeclareSectionCommand[
      beforeskip = -2.0ex plus -0.5ex minus -.1ex,
      afterskip  = 1.0ex plus .1ex
    ]{subsubsection}
  }

% ---------------------------------------------------------------------------
% Equation numbering
% ---------------------------------------------------------------------------
\numberwithin{equation}{section}

%</layout>
%    \end{macrocode}

% \subsection{synaptic-theorem.sty}
%
% \paragraph{Theorem/proof environments via thmtools + amsthm.}
%
%    \begin{macrocode}
%<*theorem>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-theorem}{2026-06-05}{2.0.0}
  {Synaptic~Theorem~Environments}

\RequirePackage{amsthm}
\RequirePackage{thmtools}

% ---------------------------------------------------------------------------
% Labels (defined in synaptic-lang-*.def, loaded by synaptic-base)
% ---------------------------------------------------------------------------

% ---------------------------------------------------------------------------
% Theorem style (journal/academic default)
% ---------------------------------------------------------------------------
\declaretheoremstyle[
  spaceabove    = 10pt plus 2pt minus 1pt,
  spacebelow    = 10pt plus 2pt minus 1pt,
  headfont      = \normalfont\bfseries\color{syn-primary},
  notefont      = \normalfont\upshape\color{syn-text-dark!85},
  bodyfont      = \normalfont\itshape,
  postheadspace = 0.8em plus 0.2em,
  headpunct     = {.}
]{syn-theorem-academic}

% ---------------------------------------------------------------------------
% Theorem environments (always available)
