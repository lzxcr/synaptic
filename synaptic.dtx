              {
                \str_case:Vn \g__synaptic_mode_tl
                  {
                    { journal } { \setstretch{1.25} }
                    { book }    { \setstretch{1.27} }
                    { lecture } { \setstretch{1.34} }
                    { notes }   { \setstretch{1.20} }
