      {
        \thispagestyle{empty}\__synaptic_title_render_lecture_block:
        \vfill\__synaptic_title_page_signature:\clearpage
      }
      { \__synaptic_title_use_plain_style:\__synaptic_title_render_lecture_block: }
  }

\cs_new_protected:Npn \__synaptic_title_render_notes_block:
  {
    \group_begin:
      \__synaptic_title_kicker:n { \__synaptic_title_mode_word: }
      \str_if_eq:VnT \l__synaptic_title_layout_tl { page }
        { \vspace*{0.065\textheight} }
      \str_if_eq:VnTF \l__synaptic_title_layout_tl { page }
        {
          {\fontsize{30}{36}\selectfont\sffamily\bfseries\raggedright
            \g__synaptic_title_tl\par}
        }
        { {\Large\sffamily\bfseries\raggedright\g__synaptic_title_tl\par} }
      \tl_if_empty:NF \g__synaptic_subtitle_tl
        {\addvspace{6pt}{\large\color{syn-text-dark!86}
          \g__synaptic_subtitle_tl\par}}
      \addvspace{16pt}
      \__synaptic_title_metadata_panel:n
        {
          \noindent
          {\small\sffamily\color{syn-text-dark}
            \seq_if_empty:NF \g__synaptic_authors_seq
              {\__synaptic_layout_header_mark:
               \seq_use:Nn \g__synaptic_authors_seq {,~}}
            \tl_if_empty:NF \g__synaptic_date_tl
              {\seq_if_empty:NF \g__synaptic_authors_seq
                 {\enspace\textbullet\enspace}
               \g__synaptic_date_tl}}
          \hfill
          {\small\sffamily\color{syn-muted-text}\g__synaptic_tags_tl}\par
        }
      \tl_if_empty:NF \g__synaptic_abstract_tl
        {\addvspace{12pt}{\small\setstretch{1.16}
          \g__synaptic_abstract_tl\par}}
      \addvspace{16pt}
    \group_end:
  }

\cs_new_protected:Npn \__synaptic_title_render_notes:
  {
    \str_if_eq:VnTF \l__synaptic_title_layout_tl { page }
      {
        \thispagestyle{empty}\null\vspace{0.06\textheight}
        \__synaptic_title_render_notes_block:
        \vfill
        \__synaptic_title_page_signature:
        \vspace*{0.035\textheight}\null\clearpage
      }
      {
        \__synaptic_title_use_plain_style:
        \legacy_if:nTF { @twocolumn }
          { \twocolumn[{\__synaptic_title_render_notes_block:}] }
          { \__synaptic_title_render_notes_block: }
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_toc:
  {
    \bool_if:NT \g__synaptic_toc_bool
      {
        \__synaptic_if_beamer:TF
          { \__synaptic_beamer_render_toc: }
          {
            \__synaptic_layout_toc_style:
            \str_case:Vn \g__synaptic_toc_layout_tl
              {
                { inline }
                  { \addvspace{16pt}\tableofcontents\addvspace{16pt} }
                { top }
                  { \addvspace{10pt}\tableofcontents\addvspace{18pt} }
                { page }
                  { \clearpage\tableofcontents\clearpage }
              }
          }
      }
  }

% ---------------------------------------------------------------------------
% Mode-aware title renderer (single source of truth for \SynapticMakeTitle)
% ---------------------------------------------------------------------------
\NewDocumentCommand{\SynapticMakeTitle}{}
  {
    \tl_if_empty:NT \g__synaptic_title_tl
      {
        \PackageError{synaptic-title}{Document~title~is~empty}
          {Set~it~with~\string\SynapticTitle\{...\}.}
      }
    \__synaptic_if_beamer:TF
      { }
      { \__synaptic_title_apply_pdf_metadata: }
    \__synaptic_title_resolve_layout:
    \str_case:Vn \g__synaptic_mode_tl
      {
        { journal } { \__synaptic_title_render_journal: }
        { book }    { \__synaptic_title_render_book: }
        { lecture } { \__synaptic_title_render_lecture: }
        { notes }   { \__synaptic_title_render_notes: }
        { beamer }  { \__synaptic_title_render_beamer: }
      }
    \__synaptic_title_render_toc:
    \setcounter{footnote}{0}
  }

