%<*package>
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic}{2026-08-27}{2.4.0}
  {Modern~Academic~Typesetting~Framework}

% Forward all user options to synaptic-base
\RequirePackageWithOptions{synaptic-base}

\RequirePackage{seqsplit}

% ---------------------------------------------------------------------------
% Collision-resistant convenience commands
% ---------------------------------------------------------------------------
\NewDocumentCommand{\SynapticPkg}{m}
  { {\color{syn-primary}\texttt{\seqsplit{#1}}} }
\NewDocumentCommand{\SynapticCmd}{m}
  { {\color{syn-primary!80}\texttt{\textbackslash\seqsplit{#1}}} }
\ProvideDocumentCommand{\pkg}{m}{\SynapticPkg{#1}}
\ProvideDocumentCommand{\cmd}{m}{\SynapticCmd{#1}}

% ---------------------------------------------------------------------------
% Acknowledgments; the starred form is omitted from the table of contents.
% ---------------------------------------------------------------------------
\NewDocumentCommand{\SynapticAcknowledgments}{s O{\c_synaptic_label_acknowledgments_tl}}
  {
    \str_if_eq:VnTF \l_synaptic_mode_tl { book }
      { \chapter*{#2} }
      { \section*{#2} }
    \IfBooleanF{#1}
      {
        \str_if_eq:VnTF \l_synaptic_mode_tl { book }
          { \addcontentsline{toc}{chapter}{#2} }
          { \addcontentsline{toc}{section}{#2} }
      }
  }

\ProvideDocumentCommand{\acknowledgments}{s O{\c_synaptic_label_acknowledgments_tl}}
  { \IfBooleanTF{#1}{\SynapticAcknowledgments*[#2]}{\SynapticAcknowledgments[#2]} }

%</package>
%    \end{macrocode}

