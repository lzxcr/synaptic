  {
    \tl_set_eq:NN \l__synaptic_title_layout_tl \l_synaptic_title_layout_tl
    \str_if_eq:VnT \l__synaptic_title_layout_tl { auto }
      {
        \str_case:Vn \l_synaptic_mode_tl
          {
            { journal } { \tl_set:Nn \l__synaptic_title_layout_tl { inline } }
            { book }    { \tl_set:Nn \l__synaptic_title_layout_tl { cover } }
            { lecture } { \tl_set:Nn \l__synaptic_title_layout_tl { compact } }
            { notes }   { \tl_set:Nn \l__synaptic_title_layout_tl { compact } }
          }
      }
  }

\cs_new_protected:Npn \__synaptic_title_use_plain_style:
  {
    \cs_if_exist:cTF { ps@plain.scrheadings }
      { \thispagestyle{plain.scrheadings} }
      { \thispagestyle{plain} }
  }

\cs_new_protected:Npn \__synaptic_title_render_authors:
  {
    \seq_map_indexed_inline:Nn \l_synaptic_authors_seq
      {
        \int_compare:nNnT {##1} > {1} { \quad }
        \__synaptic_render_author:nn {##2}
          { \seq_item:Nn \l_synaptic_author_marks_seq {##1} }
      }
    \unskip
  }

\cs_new_protected:Npn \__synaptic_title_render_affiliations:
  {
    \seq_if_empty:NF \l_synaptic_affils_seq
      {
        \group_begin:
          \small\synaptic_if_lang_zh:TF{\upshape}{\itshape}
          \color{syn-text-dark}
          \begin{synaffillist}
            \seq_map_inline:Nn \l_synaptic_affils_seq
              { \__synaptic_render_affil:nn ##1 }
          \end{synaffillist}
        \group_end:
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_contacts:
  {
    \seq_if_empty:NF \l_synaptic_emails_seq
      {
        \noindent
        {\small\color{syn-muted-text}
          \textit{\c_synaptic_label_email_tl}\c_synaptic_colon_tl\enspace
          \seq_map_indexed_inline:Nn \l_synaptic_emails_seq
            {
              \int_compare:nNnT {##1} > {1} {,~}
              \__synaptic_render_email:n {##2}
            }}\par
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_abstract_keywords:
  {
    \tl_if_empty:NF \l_synaptic_abstract_tl
      {
        \par\addvspace{12pt}
        \noindent\textcolor{syn-rule}{\rule{\linewidth}{0.5pt}}\par
        \addvspace{10pt}
        \noindent
        {\small\sffamily\bfseries\color{syn-primary}
          \c_synaptic_label_abstract_tl\c_synaptic_colon_tl}\enspace
        \group_begin:
          \small\setstretch{1.18}\l_synaptic_abstract_tl\par
        \group_end:
      }
    \tl_if_empty:NF \l_synaptic_keywords_tl
      {
        \par\addvspace{9pt}\noindent
        {\small\sffamily\bfseries\color{syn-primary}
          \c_synaptic_label_keywords_tl\c_synaptic_colon_tl}\enspace
        {\small\l_synaptic_keywords_tl}\par
      }
    \tl_if_empty:NF \l_synaptic_arxiv_tl
      {
        \par\addvspace{8pt}\noindent
        {\small\sffamily\bfseries\color{syn-primary}
          \c_synaptic_label_arxiv_tl\c_synaptic_colon_tl}\enspace
        \href{https://arxiv.org/abs/\l_synaptic_arxiv_tl}
          {\small\texttt{\l_synaptic_arxiv_tl}}\par
      }
    \par\addvspace{10pt}
    \noindent\textcolor{syn-rule}{\rule{\linewidth}{0.5pt}}\par
  }

\cs_new_protected:Npn \__synaptic_title_render_journal_block:
  {
    \group_begin:
      \setstretch{1.08}
      \noindent
      \tl_if_empty:NTF \l_synaptic_header_tl
        { {\small\sffamily\bfseries\color{syn-muted-text}
            \c_synaptic_label_header_tl} }
        { {\small\sffamily\bfseries\color{syn-muted-text}
            \l_synaptic_header_tl} }
      \tl_if_empty:NF \l_synaptic_preprint_tl
        { \hfill {\small\sffamily\l_synaptic_preprint_tl} }
      \par
      \tl_if_empty:NF \l_synaptic_subheader_tl
        {
          \addvspace{5pt}
          {\footnotesize\sffamily\bfseries\color{syn-primary}
            \l_synaptic_subheader_tl\par}
        }
      \str_if_eq:VnTF \l__synaptic_title_layout_tl { compact }
        { \addvspace{14pt}{\Large\raggedright\bfseries\l_synaptic_title_tl\par} }
        { \addvspace{22pt}{\LARGE\raggedright\bfseries\l_synaptic_title_tl\par} }
      \tl_if_empty:NF \l_synaptic_subtitle_tl
        {
          \addvspace{7pt}
          {\large\raggedright\color{syn-text-dark!86}
            \l_synaptic_subtitle_tl\par}
        }
      \addvspace{13pt}
      % Classic double rule: a strong primary bar over a hairline gives the
      % journal header a precise, editorial finish without extra decoration.
      \noindent\textcolor{syn-primary}{\rule{\linewidth}{1.1pt}}\par
      \vspace{2.5pt}
      \noindent\textcolor{syn-rule}{\rule{\linewidth}{0.35pt}}\par
      \seq_if_empty:NF \l_synaptic_authors_seq
        {
          \addvspace{15pt}
          {\large\sffamily\bfseries\raggedright
            \__synaptic_title_render_authors:\par}
        }
      \addvspace{6pt}
      \__synaptic_title_render_affiliations:
      \addvspace{5pt}
