\documentclass[10pt,twocolumn]{scrartcl}
\usepackage[mode=notes,theme=graphite,fontset=lm,density=compact]{synaptic}

\SynapticTitle{Standard Metadata Notes}
\SynapticAuthor{Test Student}
\SynapticDate{Week 3}

\begin{document}
\START
\ExplSyntaxOn
\TYPE{mode=\__synaptic_mode:}
\TYPE{density=\__synaptic_density:}
\ExplSyntaxOff
\SynapticMakeTitle
\section{Notes}
\begin{synkeyidea}[Invariant]A key idea.\end{synkeyidea}
\begin{synquestion}A review question.\end{synquestion}
\begin{syntodo}A follow-up task.\end{syntodo}
\begin{synsummary}A compact summary.\end{synsummary}
\SynapticBalanceColumns
\TYPE{notes-metadata-and-cards=ok}
\END
\end{document}
