\input regression-test.tex
\documentclass[11pt]{scrartcl}
\usepackage[mode=lecture,theme=ocean,fontset=lm,numbering=continuous,
  box-numbering=separate]{synaptic}

\SynapticCourseCode{CS 101}
\SynapticCourse{Continuous Regression}
\SynapticLectureNumber{2}
\SynapticTitle{Continuous Numbering}
\SynapticInstructor{Test Lecturer}

\begin{document}
\START
\ExplSyntaxOn
\TYPE{numbering=\synaptic_numbering:}
\TYPE{box-numbering=\synaptic_box_numbering:}
\ExplSyntaxOff
\SynapticMakeTitle
\section{First}
\begin{theorem}A continuous theorem.\end{theorem}
\begin{synexample}[Example]A separately numbered example.\end{synexample}
\ExplSyntaxOn
\TYPE{example-in-first=\use:c { thetcb@cnt@synapticexample }}
\ExplSyntaxOff
\section{Second}
\begin{theorem}Another continuous theorem.\end{theorem}
\begin{synremark}[Remark]A separately numbered remark.\end{synremark}
\begin{synwarning}[Warning]Unnumbered warning.\end{synwarning}
\ExplSyntaxOn
\TYPE{theorem-counter=\thetheorem}
\TYPE{remark-in-second=\use:c { thetcb@cnt@synapticremark }}
\TYPE{warning-in-second=\use:c { thetcb@cnt@synapticwarning }}
\ExplSyntaxOff
\TYPE{continuous-and-separate-numbering=ok}
\END
\end{document}
