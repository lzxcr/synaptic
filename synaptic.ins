%% synaptic.ins — Installation file for the synaptic bundle
%% Copyright (C) 2025--2026 synaptic project
%% Released under the LPPL 1.3c or later
%% Run: tex synaptic.ins   (CTAN / l3build standard — no path prefix)
%%
%% NOTE: .sty files are already pre-committed in tex/latex/synaptic/.
%% Users do NOT need to run this — just use TEXINPUTS.
%%
\input docstrip.tex
\keepsilent
\askforoverwritefalse
\nopreamble\nopostamble

\generate{%
  \file{synaptic.sty}          {\from{synaptic.dtx}{package}}%
  \file{synaptic-base.sty}     {\from{synaptic.dtx}{base}}%
  \file{synaptic-color.sty}    {\from{synaptic.dtx}{color}}%
  \file{synaptic-fonts.sty}    {\from{synaptic.dtx}{fonts}}%
  \file{synaptic-layout.sty}   {\from{synaptic.dtx}{layout}}%
  \file{synaptic-title.sty}    {\from{synaptic.dtx}{title}}%
  \file{synaptic-theorem.sty}  {\from{synaptic.dtx}{theorem}}%
  \file{synaptic-journal.sty}  {\from{synaptic.dtx}{journal}}%
  \file{synaptic-book.sty}     {\from{synaptic.dtx}{book}}%
  \file{synaptic-lecture.sty}  {\from{synaptic.dtx}{lecture}}%
  \file{synaptic-boxes.sty}    {\from{synaptic.dtx}{boxes}}%
  \file{synaptic-notes.sty}    {\from{synaptic.dtx}{notes}}%
  \file{synaptic-lang-en.def}  {\from{synaptic.dtx}{lang-en}}%
  \file{synaptic-lang-zh.def}  {\from{synaptic.dtx}{lang-zh}}%
}
\endbatchfile
