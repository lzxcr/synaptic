\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-boxes}{2026-08-23}{2.3.0}
  {Synaptic~Box~Environments}

\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable, theorems}

\tcbset{
  synaptic/base/.style={
    enhanced,breakable,
    fonttitle=\bfseries\sffamily,
    coltext=syn-text-dark,
    boxrule=0.4pt,left=9pt,right=8pt,top=7pt,bottom=7pt,arc=0pt,
    before~skip=9pt,after~skip=9pt
  },
  synaptic/example/.style={
    synaptic/base,colback=syn-surface,colframe=syn-border,
    colbacktitle=syn-surface-strong,coltitle=syn-primary,
    borderline~west={2.2pt}{0pt}{syn-primary}
  },
  synaptic/remark/.style={
    synaptic/base,colback=syn-secondary!3!white,
    colframe=syn-secondary!30!white,colbacktitle=syn-secondary!8!white,
    coltitle=syn-secondary,
    borderline~west={2.2pt}{0pt}{syn-secondary!70!white}
  },
  synaptic/warning/.style={
    synaptic/base,colback=syn-warning!4!white,
    colframe=syn-warning!35!white,colbacktitle=syn-warning!10!white,
    coltitle=syn-warning,
    borderline~west={2.2pt}{0pt}{syn-warning}
  },
  synaptic/exercise/.style={
    synaptic/base,colback=syn-success!4!white,
    colframe=syn-success!35!white,colbacktitle=syn-success!10!white,
    coltitle=syn-success,
    borderline~west={2.2pt}{0pt}{syn-success}
  }
}

\cs_new:Npn \__synaptic_box_title:nn #1#2
  { #1\tl_if_blank:nF {#2} {\c_synaptic_colon_tl\enspace#2} }

\cs_new_protected:Npn \__synaptic_box_define_unnumbered_all:
  {
    \NewDocumentEnvironment{synexample}{ O{} O{} }
      {\begin{tcolorbox}[synaptic/example,
         title={\__synaptic_box_title:nn{\c_synaptic_label_example_tl}{##1}}]
       \tl_if_blank:nF {##2}{\phantomsection\label{ex:##2}}}
      {\end{tcolorbox}}
    \NewDocumentEnvironment{synremark}{ O{} O{} }
      {\begin{tcolorbox}[synaptic/remark,
         title={\__synaptic_box_title:nn{\c_synaptic_label_remark_tl}{##1}}]
       \tl_if_blank:nF {##2}{\phantomsection\label{rem:##2}}}
      {\end{tcolorbox}}
    \NewDocumentEnvironment{synwarning}{ O{} O{} }
      {\begin{tcolorbox}[synaptic/warning,
         title={\__synaptic_box_title:nn{\c_synaptic_label_warning_tl}{##1}}]
       \tl_if_blank:nF {##2}{\phantomsection\label{warn:##2}}}
      {\end{tcolorbox}}
    \NewDocumentEnvironment{synexercise}{ O{} O{} }
      {\begin{tcolorbox}[synaptic/exercise,
         title={\__synaptic_box_title:nn{\c_synaptic_label_exercise_tl}{##1}}]
       \tl_if_blank:nF {##2}{\phantomsection\label{exr:##2}}}
      {\end{tcolorbox}}
  }

\str_case:Vn \l_synaptic_box_numbering_tl
  {
    { shared }
      {
        \newtcbtheorem[use~counter=theorem]
          {synapticexample}{\c_synaptic_label_example_tl}{synaptic/example}{ex}
        \newtcbtheorem[use~counter=theorem]
          {synapticexercise}{\c_synaptic_label_exercise_tl}{synaptic/exercise}{exr}
        \NewDocumentEnvironment{synexample}{ O{} O{} }
          {\begin{synapticexample}{#1}{#2}}{\end{synapticexample}}
        \NewDocumentEnvironment{synexercise}{ O{} O{} }
          {\begin{synapticexercise}{#1}{#2}}{\end{synapticexercise}}
        \NewDocumentEnvironment{synremark}{ O{} O{} }
          {\begin{tcolorbox}[synaptic/remark,
             title={\__synaptic_box_title:nn{\c_synaptic_label_remark_tl}{#1}}]
           \tl_if_blank:nF {#2}{\phantomsection\label{rem:#2}}}
          {\end{tcolorbox}}
        \NewDocumentEnvironment{synwarning}{ O{} O{} }
          {\begin{tcolorbox}[synaptic/warning,
             title={\__synaptic_box_title:nn{\c_synaptic_label_warning_tl}{#1}}]
           \tl_if_blank:nF {#2}{\phantomsection\label{warn:#2}}}
          {\end{tcolorbox}}
      }
    { separate }
      {
        \newtcbtheorem[number~within=section]
          {synapticexample}{\c_synaptic_label_example_tl}{synaptic/example}{ex}
        \newtcbtheorem[number~within=section]
          {synapticremark}{\c_synaptic_label_remark_tl}{synaptic/remark}{rem}
        \newtcbtheorem[number~within=section]
          {synapticwarning}{\c_synaptic_label_warning_tl}{synaptic/warning}{warn}
        \newtcbtheorem[number~within=section]
          {synapticexercise}{\c_synaptic_label_exercise_tl}{synaptic/exercise}{exr}
        \NewDocumentEnvironment{synexample}{ O{} O{} }
          {\begin{synapticexample}{#1}{#2}}{\end{synapticexample}}
        \NewDocumentEnvironment{synremark}{ O{} O{} }
          {\begin{synapticremark}{#1}{#2}}{\end{synapticremark}}
        \NewDocumentEnvironment{synwarning}{ O{} O{} }
          {\begin{synapticwarning}{#1}{#2}}{\end{synapticwarning}}
        \NewDocumentEnvironment{synexercise}{ O{} O{} }
          {\begin{synapticexercise}{#1}{#2}}{\end{synapticexercise}}
      }
    { none }
      { \__synaptic_box_define_unnumbered_all: }
  }

\cs_if_exist:NF \example
  { \NewDocumentEnvironment{example}{ O{} O{} }
      { \begin{synapticexample}{#1}{#2} } { \end{synapticexample} } }
\cs_if_exist:NF \remark
  { \NewDocumentEnvironment{remark}{ O{} O{} }
      { \begin{synapticremark}{#1}{#2} } { \end{synapticremark} } }
\cs_if_exist:NF \warning
  { \NewDocumentEnvironment{warning}{ O{} O{} }
      { \begin{synapticwarning}{#1}{#2} } { \end{synapticwarning} } }
\cs_if_exist:NF \exercise
  { \NewDocumentEnvironment{exercise}{ O{} O{} }
      { \begin{synapticexercise}{#1}{#2} } { \end{synapticexercise} } }

\NewDocumentEnvironment{synbox}{ O{} }
  {
    \begin{tcolorbox}[
      enhanced,
      colback       = syn-surface,
      colframe      = syn-primary,
      coltitle      = white,
      fonttitle     = \bfseries\sffamily,
      title         = {#1},
      left          = 6pt,
      right         = 6pt,
      top           = 4pt,
      bottom        = 4pt,
      boxsep        = 4pt,
      arc           = 0pt,
      breakable
    ]
  }
  {
    \end{tcolorbox}
  }
