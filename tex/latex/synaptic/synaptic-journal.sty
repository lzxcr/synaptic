\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-journal}{2026-08-28}{2.5.0}
  {Synaptic~Journal~Mode}

\RequirePackage[singlespacing=true]{scrlayer-scrpage}

\cs_new:Npn \__synaptic_journal_running_author:
  {
    \seq_if_empty:NF \l_synaptic_authors_seq
      { \seq_item:Nn \l_synaptic_authors_seq {1} }
  }

\cs_new:Npn \__synaptic_journal_running_title:
  {
    \tl_if_empty:NTF \l_synaptic_short_title_tl
      { \l_synaptic_title_tl }
      { \l_synaptic_short_title_tl }
  }

\clearpairofpagestyles
\ihead{\__synaptic_layout_header_mark:\__synaptic_journal_running_author:}
\ohead{\__synaptic_journal_running_title:}
\ofoot*{\__synaptic_layout_footer_mark:\enspace\pagemark}
\setkomafont{pageheadfoot}
  {\normalfont\footnotesize\sffamily\color{syn-muted-text}}
\pagestyle{scrheadings}
\__synaptic_layout_headsepline:

\NewDocumentCommand{\SynapticStatement}{s m +m}
  {
    \section*{#2}
    \IfBooleanF{#1}{\addcontentsline{toc}{section}{#2}}
    \noindent\textcolor{syn-rule}{\rule{2.5em}{0.45pt}}\par\smallskip
    #3\par
  }









