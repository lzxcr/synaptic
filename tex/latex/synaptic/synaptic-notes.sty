\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-notes}{2026-08-28}{3.0.0}
  {Synaptic~Notes~Mode}

\RequirePackage[singlespacing=true]{scrlayer-scrpage}
\RequirePackage{balance}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

\AddToHook{begindocument/before}
  {
    \setkomafont{section}
      {\normalfont\large\bfseries\sffamily\color{syn-primary}}
    \setkomafont{subsection}
      {\normalfont\normalsize\bfseries\sffamily\color{syn-text-dark}}
    \RedeclareSectionCommand[
      beforeskip=-2.7ex plus -0.7ex minus -.2ex,
      afterskip=1.2ex plus .15ex
    ]{section}
    \RedeclareSectionCommand[
      beforeskip=-2.0ex plus -0.4ex minus -.1ex,
      afterskip=0.8ex plus .1ex
    ]{subsection}
  }

\cs_new:Npn \__synaptic_notes_running_title:
  {
    \tl_if_empty:NTF \l_synaptic_short_title_tl
      { \l_synaptic_title_tl }
      { \l_synaptic_short_title_tl }
  }

\clearpairofpagestyles
\ihead{\__synaptic_layout_header_mark:\__synaptic_notes_running_title:}
\ohead{\headmark}
\ofoot*{\__synaptic_layout_footer_mark:\enspace\pagemark}
\automark{section}
\setkomafont{pageheadfoot}
  {\normalfont\footnotesize\sffamily\color{syn-muted-text}}
\pagestyle{scrheadings}
\__synaptic_layout_headsepline:

\tcbset{
  synaptic/note-base/.style={
    enhanced,breakable,frame~hidden,
    arc=1.5pt,outer~arc=1.5pt,
    colback=syn-surface,coltext=syn-text-dark,
    fonttitle=\bfseries\sffamily,
    left=9pt,right=8pt,top=7pt,bottom=7pt,
    before~skip=8pt,after~skip=8pt,
    borderline~north={0.3pt}{0pt}{syn-border!55!white}
  },
  synaptic/key-idea/.style={
    synaptic/note-base,coltitle=syn-primary,
    borderline~west={2pt}{0pt}{syn-primary}
  },
  synaptic/question/.style={
    synaptic/note-base,colback=syn-secondary!3!white,coltitle=syn-secondary,
    borderline~west={2pt}{0pt}{syn-secondary}
  },
  synaptic/todo/.style={
    synaptic/note-base,colback=syn-warning!4!white,coltitle=syn-warning,
    borderline~west={2pt}{0pt}{syn-warning}
  },
  synaptic/note-summary/.style={
    synaptic/note-base,colback=syn-primary!7!white,coltitle=syn-primary,
    borderline~west={3pt}{0pt}{syn-primary},
    borderline~south={0.6pt}{0pt}{syn-primary!45!white}
  }
}

\cs_new:Npn \__synaptic_notes_card_title:nn #1#2
  { #1\tl_if_blank:nF {#2} {\c_synaptic_colon_tl\enspace#2} }

\NewDocumentEnvironment{synkeyidea}{ O{} }
  {\begin{tcolorbox}[synaptic/key-idea,
     title={\__synaptic_notes_card_title:nn
       {\c_synaptic_label_key_idea_tl}{#1}}]}
  {\end{tcolorbox}}

\NewDocumentEnvironment{synquestion}{ O{} }
  {\begin{tcolorbox}[synaptic/question,
     title={\__synaptic_notes_card_title:nn
       {\c_synaptic_label_question_tl}{#1}}]}
  {\end{tcolorbox}}

\NewDocumentEnvironment{syntodo}{ O{} }
  {\begin{tcolorbox}[synaptic/todo,
     title={\__synaptic_notes_card_title:nn
       {\c_synaptic_label_todo_tl}{#1}}]}
  {\end{tcolorbox}}

\NewDocumentEnvironment{synsummary}{ O{} }
  {\begin{tcolorbox}[synaptic/note-summary,
     title={\__synaptic_notes_card_title:nn
       {\c_synaptic_label_summary_tl}{#1}}]}
  {\end{tcolorbox}}

\NewDocumentCommand{\SynapticBalanceColumns}{}{\balance}





