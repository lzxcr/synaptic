\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-color}{2026-08-27}{2.4.0}
  {Synaptic~Theme~Colour~System}

\RequirePackage{xcolor}

\definecolor{syn-theme-ocean-primary}{RGB}{0,106,176}
\definecolor{syn-theme-ocean-secondary}{RGB}{46,64,83}
\definecolor{syn-theme-ocean-accent}{RGB}{14,98,81}
\definecolor{syn-theme-graphite-primary}{RGB}{75,86,99}
\definecolor{syn-theme-graphite-secondary}{RGB}{45,52,62}
\definecolor{syn-theme-graphite-accent}{RGB}{41,128,185}
\definecolor{syn-theme-forest-primary}{RGB}{30,115,80}
\definecolor{syn-theme-forest-secondary}{RGB}{56,68,60}
\definecolor{syn-theme-forest-accent}{RGB}{183,86,10}
\definecolor{syn-theme-midnight-primary}{RGB}{25,55,109}
\definecolor{syn-theme-midnight-secondary}{RGB}{30,35,50}
\definecolor{syn-theme-midnight-accent}{RGB}{145,105,20}
\definecolor{syn-theme-paper-primary}{RGB}{55,58,62}
\definecolor{syn-theme-paper-secondary}{RGB}{45,48,52}
\definecolor{syn-theme-paper-accent}{RGB}{120,67,35}

\prop_new:N \g_synaptic_themes_prop
\clist_map_inline:nn { ocean, graphite, forest, midnight, paper }
  { \prop_gput:Nnn \g_synaptic_themes_prop {#1} { built-in } }

\definecolor{syn-semantic-danger}{RGB}{180,35,24}
\definecolor{syn-semantic-warning}{RGB}{145,90,0}
\definecolor{syn-semantic-success}{RGB}{20,120,75}

\cs_new_protected:Npn \__synaptic_color_derive:
  {
    \str_if_eq:VnT \l_synaptic_color_mode_tl { mono }
      {
        \colorlet{syn-primary}{black!78}
        \colorlet{syn-secondary}{black!86}
        \colorlet{syn-accent}{black!68}
      }
    \str_if_eq:VnTF \l_synaptic_color_mode_tl { mono }
      {
        \colorlet{syn-danger}{black!82}
        \colorlet{syn-warning}{black!68}
        \colorlet{syn-success}{black!76}
      }
      {
        \colorlet{syn-danger}{syn-semantic-danger}
        \colorlet{syn-warning}{syn-semantic-warning}
        \colorlet{syn-success}{syn-semantic-success}
      }
    \colorlet{syn-text-dark}{syn-secondary!92!black}
    % `muted-text' remains dark enough for small labels.  Decorative rules
    % deliberately use a separate, lighter token.
    \colorlet{syn-muted-text}{syn-secondary!82!white}
    \colorlet{syn-decoration-muted}{syn-secondary!42!white}
    \colorlet{syn-muted}{syn-muted-text}
    \colorlet{syn-rule}{syn-primary!28!white}
    \str_if_eq:VnTF \l_synaptic_color_mode_tl { screen }
      { \colorlet{syn-link}{syn-primary} }
      { \colorlet{syn-link}{syn-text-dark} }
    \colorlet{syn-surface}{syn-primary!4!white}
    \colorlet{syn-surface-strong}{syn-primary!10!white}
    \colorlet{syn-border}{syn-primary!38!white}
    \colorlet{syn-faded}{syn-primary!18!white}
    \colorlet{syn-light}{syn-primary!38!white}
    \colorlet{syn-on-primary}{white}
  }

\cs_new_protected:Npn \__synaptic_color_use_theme_aux:n #1
  {
    \prop_if_in:NnTF \g_synaptic_themes_prop {#1}
      {
        \colorlet{syn-primary}{syn-theme-#1-primary}
        \colorlet{syn-secondary}{syn-theme-#1-secondary}
        \colorlet{syn-accent}{syn-theme-#1-accent}
        \tl_set:Nn \l_synaptic_theme_tl {#1}
        \__synaptic_color_derive:
      }
      {
        \PackageError{synaptic-color}{Unknown~theme~`#1'}
          {Define~it~first~with~\string\SynapticDefineTheme.}
      }
  }

\cs_new_protected:Npn \synaptic_color_use_theme:n #1
  { \exp_args:Ne \__synaptic_color_use_theme_aux:n {#1} }

\NewDocumentCommand{\SynapticUseTheme}{m}
  { \synaptic_color_use_theme:n {#1} }

\NewDocumentCommand{\SynapticDefineTheme}{m m m o}
  {
    \colorlet{syn-theme-#1-primary}{#2}
    \colorlet{syn-theme-#1-secondary}{#3}
    \IfValueTF{#4}
      { \colorlet{syn-theme-#1-accent}{#4} }
      { \colorlet{syn-theme-#1-accent}{#2} }
    \prop_gput:Nnn \g_synaptic_themes_prop {#1} { custom }
    \synaptic_color_use_theme:n {#1}
  }

\synaptic_color_use_theme:n { \synaptic_theme: }














