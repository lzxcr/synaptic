\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-layout}{2026-08-28}{2.5.0}
  {Synaptic~Page~Layout}

\RequirePackage{geometry}
\RequirePackage{setspace}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{bookmark}

\KOMAoptions{numbers=noendperiod}

\cs_new_protected:Npn \__synaptic_layout_apply_structure_names:
  {
    \renewcommand*{\contentsname}{\c_synaptic_label_contents_tl}
    \renewcommand*{\listfigurename}{\c_synaptic_label_list_figures_tl}
    \renewcommand*{\listtablename}{\c_synaptic_label_list_tables_tl}
  }
\__synaptic_layout_apply_structure_names:
\AddToHook{begindocument/end}{\__synaptic_layout_apply_structure_names:}

\str_case:Vn \l_synaptic_mode_tl
  {
    { journal }
      {
        \geometry{
          textwidth  = 0.71\paperwidth,
          textheight = 0.81\paperheight,
          top        = 0.075\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 16pt,
          footskip   = 26pt,
          includeheadfoot
        }
      }
    { lecture }
      {
        \geometry{
          textwidth  = 0.76\paperwidth,
          textheight = 0.80\paperheight,
          top        = 0.075\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 16pt,
          footskip   = 26pt,
          includeheadfoot
        }
      }
    { book }
      {
        \geometry{
          textheight = 0.80\paperheight,
          top        = 0.075\paperheight,
          inner      = 0.135\paperwidth,
          outer      = 0.145\paperwidth,
          bindingoffset = \dim_use:N \l_synaptic_binding_offset_dim,
          headheight = 22pt,
          headsep    = 17pt,
          footskip   = 25pt,
          includeheadfoot,
          twoside
        }
      }
    { notes }
      {
        \geometry{
          textwidth  = 0.82\paperwidth,
          textheight = 0.84\paperheight,
          top        = 0.055\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 13pt,
          footskip   = 22pt,
          includeheadfoot
        }
      }
  }

\str_case:Vn \l_synaptic_measure_tl
  {
    { narrow }
      {
        \str_if_eq:VnTF \l_synaptic_mode_tl { book }
          { \geometry{inner=0.165\paperwidth,outer=0.175\paperwidth} }
          { \geometry{textwidth=0.64\paperwidth,hcentering} }
      }
    { standard }
      {
        \str_if_eq:VnTF \l_synaptic_mode_tl { book }
          { \geometry{inner=0.135\paperwidth,outer=0.145\paperwidth} }
          { \geometry{textwidth=0.72\paperwidth,hcentering} }
      }
    { wide }
      {
        \str_if_eq:VnTF \l_synaptic_mode_tl { book }
          { \geometry{inner=0.105\paperwidth,outer=0.115\paperwidth} }
          { \geometry{textwidth=0.84\paperwidth,hcentering} }
      }
  }

