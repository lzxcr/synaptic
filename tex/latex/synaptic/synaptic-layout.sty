\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesExplPackage{synaptic-layout}{2026-08-27}{2.4.0}
  {Synaptic~Page~Layout}

\RequirePackage{geometry}
\RequirePackage{setspace}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{bookmark}

\KOMAoptions{numbers=noendperiod}

\str_case:Vn \l_synaptic_mode_tl
  {
    { journal }
      {
        \geometry{
          textwidth  = 0.68\paperwidth,
          textheight = 0.78\paperheight,
          top        = 0.09\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 18pt,
          footskip   = 30pt,
          includeheadfoot
        }
      }
    { lecture }
      {
        \geometry{
          textwidth  = 0.72\paperwidth,
          textheight = 0.76\paperheight,
          top        = 0.10\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 18pt,
          footskip   = 32pt,
          includeheadfoot
        }
      }
    { book }
      {
        \geometry{
          textheight = 0.76\paperheight,
          top        = 0.095\paperheight,
          inner      = 0.15\paperwidth,
          outer      = 0.17\paperwidth,
          bindingoffset = \dim_use:N \l_synaptic_binding_offset_dim,
          headheight = 22pt,
          headsep    = 20pt,
          footskip   = 28pt,
          includeheadfoot,
          twoside
        }
      }
    { notes }
      {
        \geometry{
          textwidth  = 0.80\paperwidth,
          textheight = 0.82\paperheight,
          top        = 0.07\paperheight,
          hcentering,
          headheight = 20pt,
          headsep    = 14pt,
          footskip   = 24pt,
          includeheadfoot
        }
      }
  }

\str_case:Vn \l_synaptic_measure_tl
  {
    { narrow }
      {
        \str_if_eq:VnTF \l_synaptic_mode_tl { book }
          { \geometry{inner=0.18\paperwidth,outer=0.20\paperwidth} }
          { \geometry{textwidth=0.62\paperwidth,hcentering} }
      }
    { standard }
      {
        \str_if_eq:VnTF \l_synaptic_mode_tl { book }
          { \geometry{inner=0.15\paperwidth,outer=0.17\paperwidth} }
          { \geometry{textwidth=0.70\paperwidth,hcentering} }
      }
    { wide }
      {
        \str_if_eq:VnTF \l_synaptic_mode_tl { book }
          { \geometry{inner=0.12\paperwidth,outer=0.14\paperwidth} }
          { \geometry{textwidth=0.80\paperwidth,hcentering} }
      }
  }

\hypersetup{
