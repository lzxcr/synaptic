\cs_new:Npn \__synaptic_render_author:nn #1 #2
  {
    \tl_if_empty:nTF {#2}
      { #1 \quad }
      { #1 \textsuperscript{#2} \quad }
  }

\cs_new:Npn \__synaptic_render_email:n #1
  { \href{mailto:#1}{\texttt{#1}} }

\cs_new:Npn \__synaptic_render_affil:nn #1 #2
  {
    \tl_if_empty:nTF {#1}
      { \item[] #2 }
      { \item[$^{#1}$] #2 }
  }

\tl_new:N \l_synaptic_pdf_author_tl

\cs_new_protected:Npn \__synaptic_title_import_standard:
  {
    \tl_if_empty:NT \l_synaptic_title_tl
      {
        \cs_if_exist:cT { @title }
          {
            \tl_set:Nx \l_tmpa_tl { \exp_not:v { @title } }
            % The kernel's unset title/author values are warning-producing
            % token lists, not empty macros.  Never import those sentinels.
            \tl_if_in:NnF \l_tmpa_tl { \@latex@warning@no@line }
              {
                \tl_if_empty:NF \l_tmpa_tl
                  { \tl_gset_eq:NN \l_synaptic_title_tl \l_tmpa_tl }
              }
          }
      }
    \seq_if_empty:NT \l_synaptic_authors_seq
      {
        \cs_if_exist:cT { @author }
          {
            \tl_set:Nx \l_tmpa_tl { \exp_not:v { @author } }
            \tl_if_in:NnF \l_tmpa_tl { \@latex@warning@no@line }
              {
                \tl_if_empty:NF \l_tmpa_tl
                  {
                    \seq_gput_right:NV \l_synaptic_authors_seq \l_tmpa_tl
                    \seq_gput_right:Nn \l_synaptic_author_marks_seq { }
                  }
              }
          }
      }
    \tl_if_empty:NT \l_synaptic_date_tl
      {
        \cs_if_exist:cT { @date }
          { \tl_gset:Nx \l_synaptic_date_tl { \exp_not:v { @date } } }
      }
  }

\cs_new_protected:Npn \__synaptic_title_apply_pdf_metadata:
  {
    % Let hyperref perform the PDF-string conversion exactly once.  Feeding a
    % pre-converted \pdfstringdef result back into \hypersetup double-encodes
    % Unicode metadata under LuaLaTeX.
    \tl_set:Nx \l_synaptic_pdf_author_tl
      { \seq_use:Nn \l_synaptic_authors_seq {;~} }
    \tl_if_empty:NTF \l_synaptic_keywords_tl
      { \tl_set_eq:NN \l_tmpa_tl \l_synaptic_tags_tl }
      { \tl_set_eq:NN \l_tmpa_tl \l_synaptic_keywords_tl }
    \hypersetup{
      unicode     = true,
      pdftitle    = {\l_synaptic_title_tl},
      pdfauthor   = {\l_synaptic_pdf_author_tl},
      pdfsubject  = {\l_synaptic_subject_tl},
      pdfkeywords = {\l_tmpa_tl}
    }
  }

\AddToHook{begindocument}{\__synaptic_title_apply_pdf_metadata:}

\newlist{synaffillist}{description}{1}
\setlist[synaffillist]{
  leftmargin = 0.3cm,
  labelsep   = 4pt,
  itemsep    = 2pt,
  topsep     = 2pt,
  parsep     = 0pt
}

\tl_new:N   \l__synaptic_title_layout_tl

\cs_new:Npn \__synaptic_title_mode_word:
  {
    \synaptic_if_lang_zh:TF
      {
        \str_case:Vn \l_synaptic_mode_tl
          {
            { journal } { 学术论文 }
            { book }    { 专著 }
            { lecture } { 课程讲义 }
            { notes }   { 数学笔记 }
          }
      }
      {
        \str_case:Vn \l_synaptic_mode_tl
          {
            { journal } { Research~article }
            { book }    { Monograph }
            { lecture } { Course~notes }
            { notes }   { Working~notes }
          }
      }
  }

\cs_new_protected:Npn \__synaptic_title_kicker:n #1
  {
    \noindent
    {\footnotesize\sffamily\bfseries\color{syn-muted-text}#1\par}
    \addvspace{7pt}
    \__synaptic_layout_motif:\par
  }

\cs_new_protected:Npn \__synaptic_title_metadata_panel:n #1
  {
    \group_begin:
      \setlength{\fboxsep}{10pt}
      \noindent\colorbox{syn-surface}{%
        \parbox{\dimexpr\linewidth-2\fboxsep\relax}{#1}}
    \group_end:
  }

\cs_new_protected:Npn \__synaptic_title_page_signature:
  {
    \noindent\textcolor{syn-rule}{\rule{\linewidth}{0.45pt}}\par
    \addvspace{8pt}
    \noindent
    {\footnotesize\sffamily\color{syn-muted-text}\l_synaptic_title_tl}
    \hfill
    {\footnotesize\sffamily\color{syn-muted-text}\l_synaptic_date_tl}
    \par
  }

\cs_new_protected:Npn \__synaptic_title_resolve_layout:
  {
    \tl_set_eq:NN \l__synaptic_title_layout_tl \l_synaptic_title_layout_tl
    \str_if_eq:VnT \l__synaptic_title_layout_tl { auto }
      {
        \str_case:Vn \l_synaptic_mode_tl
          {
            { journal } { \tl_set:Nn \l__synaptic_title_layout_tl { inline } }
            { book }    { \tl_set:Nn \l__synaptic_title_layout_tl { cover } }
            { lecture } { \tl_set:Nn \l__synaptic_title_layout_tl { compact } }
            { notes }   { \tl_set:Nn \l__synaptic_title_layout_tl { compact } }
          }
      }
  }

\cs_new_protected:Npn \__synaptic_title_use_plain_style:
  {
    \cs_if_exist:cTF { ps@plain.scrheadings }
      { \thispagestyle{plain.scrheadings} }
      { \thispagestyle{plain} }
  }

\cs_new_protected:Npn \__synaptic_title_render_authors:
  {
    \seq_map_indexed_inline:Nn \l_synaptic_authors_seq
      {
        \int_compare:nNnT {##1} > {1} { \quad }
        \__synaptic_render_author:nn {##2}
          { \seq_item:Nn \l_synaptic_author_marks_seq {##1} }
      }
    \unskip
  }

\cs_new_protected:Npn \__synaptic_title_render_affiliations:
  {
    \seq_if_empty:NF \l_synaptic_affils_seq
      {
        \group_begin:
          \small\synaptic_if_lang_zh:TF{\upshape}{\itshape}
          \color{syn-text-dark}
          \begin{synaffillist}
            \seq_map_inline:Nn \l_synaptic_affils_seq
              { \__synaptic_render_affil:nn ##1 }
          \end{synaffillist}
        \group_end:
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_contacts:
  {
    \seq_if_empty:NF \l_synaptic_emails_seq
      {
        \noindent
        {\small\color{syn-muted-text}
          \textit{\c_synaptic_label_email_tl}\c_synaptic_colon_tl\enspace
          \seq_map_indexed_inline:Nn \l_synaptic_emails_seq
            {
              \int_compare:nNnT {##1} > {1} {,~}
              \__synaptic_render_email:n {##2}
            }}\par
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_abstract_keywords:
  {
    \tl_if_empty:NF \l_synaptic_abstract_tl
      {
        \par\addvspace{12pt}
        \noindent\textcolor{syn-rule}{\rule{\linewidth}{0.5pt}}\par
        \addvspace{10pt}
        \noindent
        {\small\sffamily\bfseries\color{syn-primary}
          \c_synaptic_label_abstract_tl\c_synaptic_colon_tl}\enspace
        \group_begin:
          \small\setstretch{1.18}\l_synaptic_abstract_tl\par
        \group_end:
      }
    \tl_if_empty:NF \l_synaptic_keywords_tl
      {
        \par\addvspace{9pt}\noindent
        {\small\sffamily\bfseries\color{syn-primary}
          \c_synaptic_label_keywords_tl\c_synaptic_colon_tl}\enspace
        {\small\l_synaptic_keywords_tl}\par
      }
    \tl_if_empty:NF \l_synaptic_arxiv_tl
      {
        \par\addvspace{8pt}\noindent
        {\small\sffamily\bfseries\color{syn-primary}
          \c_synaptic_label_arxiv_tl\c_synaptic_colon_tl}\enspace
        \href{https://arxiv.org/abs/\l_synaptic_arxiv_tl}
          {\small\texttt{\l_synaptic_arxiv_tl}}\par
      }
    \par\addvspace{10pt}
    \noindent\textcolor{syn-rule}{\rule{\linewidth}{0.5pt}}\par
  }

\cs_new_protected:Npn \__synaptic_title_render_journal_block:
  {
    \group_begin:
      \setstretch{1.08}
      \noindent
      \tl_if_empty:NTF \l_synaptic_header_tl
        { {\small\sffamily\bfseries\color{syn-muted-text}
            \c_synaptic_label_header_tl} }
        { {\small\sffamily\bfseries\color{syn-muted-text}
            \l_synaptic_header_tl} }
      \tl_if_empty:NF \l_synaptic_preprint_tl
        { \hfill {\small\sffamily\l_synaptic_preprint_tl} }
      \par
      \tl_if_empty:NF \l_synaptic_subheader_tl
        {
          \addvspace{5pt}
          {\footnotesize\sffamily\bfseries\color{syn-primary}
            \l_synaptic_subheader_tl\par}
        }
      \str_if_eq:VnTF \l__synaptic_title_layout_tl { compact }
        { \addvspace{14pt}{\Large\raggedright\bfseries\l_synaptic_title_tl\par} }
        { \addvspace{22pt}{\LARGE\raggedright\bfseries\l_synaptic_title_tl\par} }
      \tl_if_empty:NF \l_synaptic_subtitle_tl
        {
          \addvspace{7pt}
          {\large\raggedright\color{syn-text-dark!86}
            \l_synaptic_subtitle_tl\par}
        }
      \addvspace{14pt}
      \__synaptic_layout_motif:\par
      \seq_if_empty:NF \l_synaptic_authors_seq
        {
          \addvspace{15pt}
          {\large\sffamily\bfseries\raggedright
            \__synaptic_title_render_authors:\par}
        }
      \addvspace{6pt}
      \__synaptic_title_render_affiliations:
      \addvspace{5pt}
      \__synaptic_title_render_contacts:
      \tl_if_empty:NF \l_synaptic_correspondence_tl
        {
          \addvspace{5pt}
          \noindent{\small\color{syn-text-dark}
            \textit{\c_synaptic_label_correspondence_tl}\c_synaptic_colon_tl
            \enspace\l_synaptic_correspondence_tl\par}
        }
      \seq_if_empty:NF \l_synaptic_author_notes_seq
        {
          \addvspace{4pt}
          {\footnotesize\color{syn-muted-text}
            \seq_map_inline:Nn \l_synaptic_author_notes_seq {##1\par}}
        }
      \tl_if_empty:NF \l_synaptic_publication_info_tl
        {
          \addvspace{5pt}
          \noindent{\footnotesize\sffamily\color{syn-muted-text}
            \l_synaptic_publication_info_tl\par}
        }
      \__synaptic_title_render_abstract_keywords:
      \tl_if_empty:NF \l_synaptic_dedicated_tl
        {
          \addvspace{12pt}
          {\raggedleft\small\synaptic_if_lang_zh:TF{\upshape}{\itshape}
            \color{syn-muted-text}
            \l_synaptic_dedicated_tl\par}
        }
    \group_end:
  }

\cs_new_protected:Npn \__synaptic_title_render_journal:
  {
    \str_if_eq:VnTF \l__synaptic_title_layout_tl { page }
      {
        \thispagestyle{empty}
        \__synaptic_title_render_journal_block:
        \vfill\__synaptic_title_page_signature:
        \clearpage
      }
      {
        \__synaptic_title_use_plain_style:
        \__synaptic_title_render_journal_block:
        \addvspace{22pt}
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_book_half:
  {
    \tl_if_empty:NF \l_synaptic_half_title_tl
      {
        \thispagestyle{empty}\null\vspace*{0.10\textheight}
        \__synaptic_title_kicker:n { \__synaptic_title_mode_word: }
        \vspace*{0.13\textheight}
        {\raggedright\fontsize{30}{35}\selectfont\bfseries
          \l_synaptic_half_title_tl\par}
        \vfill
        \__synaptic_title_page_signature:
        \vspace*{0.035\textheight}\null
        \clearpage
        % A half-title traditionally leaves its verso blank.  A very quiet
        % colophon keeps the convention while making the page intentional in
        % screen PDFs and short books.
        \thispagestyle{empty}\null\vfill
        {\raggedleft\footnotesize\sffamily\color{syn-muted-text}
          \l_synaptic_short_title_tl\par}
        \addvspace{10pt}
        \noindent\hfill\__synaptic_layout_footer_mark:\par
        \vspace*{0.045\textheight}\null
        \clearpage
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_book_formal:
  {
    \thispagestyle{empty}
    \group_begin:
      \tl_if_empty:NTF \l_synaptic_header_tl
        { \__synaptic_title_kicker:n { \__synaptic_title_mode_word: } }
        { \__synaptic_title_kicker:n { \l_synaptic_header_tl } }
      \tl_if_empty:NF \l_synaptic_subheader_tl
        {
          \addvspace{8pt}
          {\small\sffamily\color{syn-primary}
            \l_synaptic_subheader_tl\par}
        }
      \vspace*{0.075\textheight}
      {\raggedright\fontsize{34}{40}\selectfont\bfseries
        \l_synaptic_title_tl\par}
      \tl_if_empty:NF \l_synaptic_subtitle_tl
        {
          \addvspace{14pt}
          {\Large\raggedright\sffamily\color{syn-primary}
            \l_synaptic_subtitle_tl\par}
        }
      \addvspace{20pt}
      \__synaptic_layout_motif:\par
      \seq_if_empty:NF \l_synaptic_authors_seq
        {
          \addvspace{24pt}
          {\Large\sffamily\bfseries\raggedright
            \__synaptic_title_render_authors:\par}
        }
      \addvspace{10pt}
      \__synaptic_title_render_affiliations:
      \vfill
      \__synaptic_title_metadata_panel:n
        {
          \tl_if_empty:NF \l_synaptic_edition_tl
            { {\small\sffamily\color{syn-muted-text}
                \l_synaptic_edition_tl\par} }
          \tl_if_empty:NF \l_synaptic_publisher_tl
            {
              \addvspace{5pt}
              {\large\sffamily\bfseries\color{syn-text-dark}
                \l_synaptic_publisher_tl\par}
            }
          \tl_if_empty:NF \l_synaptic_date_tl
            { {\small\sffamily\color{syn-muted-text}
                \l_synaptic_date_tl\par} }
        }
    \group_end:
    \clearpage
  }

\cs_new_protected:Npn \__synaptic_title_render_book_verso:
  {
    \thispagestyle{empty}
    \tl_if_empty:NTF \l_synaptic_abstract_tl
      { \__synaptic_title_kicker:n { \__synaptic_title_mode_word: } }
      { \__synaptic_title_kicker:n { \c_synaptic_label_about_book_tl } }
    \tl_if_empty:NF \l_synaptic_abstract_tl
      {
        \addvspace{18pt}
        \__synaptic_title_metadata_panel:n
          {
            \group_begin:\small\setstretch{1.18}
              \l_synaptic_abstract_tl\par
            \group_end:
          }
      }
    \vfill
    \__synaptic_title_page_signature:
    \tl_if_empty:NF \l_synaptic_copyright_tl
      { \addvspace{8pt}{\footnotesize\l_synaptic_copyright_tl\par} }
    \tl_if_empty:NF \l_synaptic_isbn_tl
      {
        \addvspace{4pt}
        {\footnotesize\sffamily ISBN\c_synaptic_colon_tl\enspace
          \l_synaptic_isbn_tl\par}
      }
    \cleardoublepage
    \tl_if_empty:NF \l_synaptic_dedicated_tl
      {
        \thispagestyle{empty}\null\vspace*{0.18\textheight}
        \__synaptic_title_kicker:n { \__synaptic_title_mode_word: }
        \vfill
        {\raggedright\large\synaptic_if_lang_zh:TF{\upshape}{\itshape}
          \color{syn-text-dark}\l_synaptic_dedicated_tl\par}
        \addvspace{18pt}\__synaptic_layout_motif:\par
        \vfill\null
        \cleardoublepage
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_book:
  {
    \hypersetup{pageanchor=false}
    \str_if_eq:VnTF \l__synaptic_title_layout_tl { page }
      {
        \__synaptic_title_render_book_formal:
        \cleardoublepage
      }
      {
        \__synaptic_title_render_book_half:
        \__synaptic_title_render_book_formal:
        \__synaptic_title_render_book_verso:
      }
    \hypersetup{pageanchor=true}
  }

\cs_new_protected:Npn \__synaptic_title_render_lecture_block:
  {
    \group_begin:
      \__synaptic_title_metadata_panel:n
        {
          \noindent
          {\small\sffamily\bfseries\color{syn-text-dark}
            \__synaptic_layout_header_mark:
            \l_synaptic_course_code_tl
            \tl_if_empty:NF \l_synaptic_course_tl
              {\tl_if_empty:NF \l_synaptic_course_code_tl
                 {\enspace\textbullet\enspace}
               \l_synaptic_course_tl}}
          \hfill
          {\small\sffamily\color{syn-muted-text}
            \tl_if_empty:NF \l_synaptic_lecture_number_tl
              {\c_synaptic_label_lecture_tl\nobreakspace
               \l_synaptic_lecture_number_tl
               \synaptic_if_lang_zh:TF {~讲} {}}
            \tl_if_empty:NF \l_synaptic_date_tl
              {\tl_if_empty:NF \l_synaptic_lecture_number_tl
                 {\enspace\textbullet\enspace}
               \l_synaptic_date_tl}}
        }
      \par\addvspace{15pt}
      {\fontsize{24}{29}\selectfont\sffamily\bfseries\raggedright
        \l_synaptic_title_tl\par}
      \tl_if_empty:NF \l_synaptic_subtitle_tl
        {\addvspace{5pt}{\large\color{syn-text-dark!86}
          \l_synaptic_subtitle_tl\par}}
      \addvspace{9pt}
      \tl_if_empty:NTF \l_synaptic_instructor_tl
        {
          \seq_if_empty:NF \l_synaptic_authors_seq
            { {\small\sffamily\color{syn-muted-text}
                \seq_use:Nn \l_synaptic_authors_seq {,~}\par} }
        }
        { {\small\sffamily\color{syn-muted-text}
            \l_synaptic_instructor_tl\par} }
      \tl_if_empty:NF \l_synaptic_semester_tl
        { {\small\sffamily\color{syn-muted-text}
            \l_synaptic_semester_tl\par} }
      \addvspace{12pt}
      \__synaptic_layout_motif:\par
      \tl_if_empty:NF \l_synaptic_abstract_tl
        {
          \addvspace{11pt}
          \__synaptic_title_metadata_panel:n
            {
              {\small\sffamily\bfseries\color{syn-primary}
                \c_synaptic_label_overview_tl\c_synaptic_colon_tl}\enspace
              {\small\l_synaptic_abstract_tl\par}
            }
        }
      \addvspace{18pt}
    \group_end:
  }

\cs_new_protected:Npn \__synaptic_title_render_lecture:
  {
    \str_if_eq:VnTF \l__synaptic_title_layout_tl { page }
      {
        \thispagestyle{empty}\__synaptic_title_render_lecture_block:
        \vfill\__synaptic_title_page_signature:\clearpage
      }
      { \__synaptic_title_use_plain_style:\__synaptic_title_render_lecture_block: }
  }

\cs_new_protected:Npn \__synaptic_title_render_notes_block:
  {
    \group_begin:
      \__synaptic_title_kicker:n { \__synaptic_title_mode_word: }
      \str_if_eq:VnT \l__synaptic_title_layout_tl { page }
        { \vspace*{0.065\textheight} }
      \str_if_eq:VnTF \l__synaptic_title_layout_tl { page }
        {
          {\fontsize{30}{36}\selectfont\sffamily\bfseries\raggedright
            \l_synaptic_title_tl\par}
        }
        { {\Large\sffamily\bfseries\raggedright\l_synaptic_title_tl\par} }
      \tl_if_empty:NF \l_synaptic_subtitle_tl
        {\addvspace{6pt}{\large\color{syn-text-dark!86}
          \l_synaptic_subtitle_tl\par}}
      \addvspace{16pt}
      \__synaptic_title_metadata_panel:n
        {
          \noindent
          {\small\sffamily\color{syn-text-dark}
            \seq_if_empty:NF \l_synaptic_authors_seq
              {\__synaptic_layout_header_mark:
               \seq_use:Nn \l_synaptic_authors_seq {,~}}
            \tl_if_empty:NF \l_synaptic_date_tl
              {\seq_if_empty:NF \l_synaptic_authors_seq
                 {\enspace\textbullet\enspace}
               \l_synaptic_date_tl}}
          \hfill
          {\small\sffamily\color{syn-muted-text}\l_synaptic_tags_tl}\par
        }
      \tl_if_empty:NF \l_synaptic_abstract_tl
        {\addvspace{12pt}{\small\setstretch{1.16}
          \l_synaptic_abstract_tl\par}}
      \addvspace{16pt}
    \group_end:
  }

\cs_new_protected:Npn \__synaptic_title_render_notes:
  {
    \str_if_eq:VnTF \l__synaptic_title_layout_tl { page }
      {
        \thispagestyle{empty}\null\vspace{0.06\textheight}
        \__synaptic_title_render_notes_block:
        \vfill
        \__synaptic_title_page_signature:
        \vspace*{0.035\textheight}\null\clearpage
      }
      {
        \__synaptic_title_use_plain_style:
        \legacy_if:nTF { @twocolumn }
          { \twocolumn[{\__synaptic_title_render_notes_block:}] }
          { \__synaptic_title_render_notes_block: }
      }
  }

\cs_new_protected:Npn \__synaptic_title_render_toc:
  {
    \bool_if:NT \l_synaptic_toc_bool
      {
        \__synaptic_layout_toc_style:
        \str_case:Vn \l_synaptic_toc_layout_tl
          {
            { inline }
              { \addvspace{16pt}\tableofcontents\addvspace{16pt} }
            { top }
              { \addvspace{10pt}\tableofcontents\addvspace{18pt} }
            { page }
              { \clearpage\tableofcontents\clearpage }
          }
      }
  }

\NewDocumentCommand{\SynapticMakeTitle}{}
  {
    \__synaptic_title_import_standard:
    \tl_if_empty:NT \l_synaptic_title_tl
      {
        \PackageError{synaptic-title}{Document~title~is~empty}
          {Set~it~with~\string\SynapticTitle\{...\}~or~\string\title\{...\}.}
      }
    \__synaptic_title_apply_pdf_metadata:
    \__synaptic_title_resolve_layout:
    \str_case:Vn \l_synaptic_mode_tl
      {
        { journal } { \__synaptic_title_render_journal: }
        { book }    { \__synaptic_title_render_book: }
        { lecture } { \__synaptic_title_render_lecture: }
        { notes }   { \__synaptic_title_render_notes: }
      }
    \__synaptic_title_render_toc:
    \setcounter{footnote}{0}
  }










